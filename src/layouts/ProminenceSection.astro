---
import { Image } from "astro:assets";

const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/prominence`);
const data = await res.json();
---

<section
  class="section-padding mx-auto flex max-w-6xl flex-col items-center gap-10 md:flex-row md:items-start"
>
  <figure class="shrink-0 md:w-1/2">
    <Image
      src={data.photo.url}
      alt={data.photo.alt}
      width="576"
      height="762"
      class="mx-auto rounded-2xl shadow-card ring-1 ring-border/70"
    />
    <figcaption
      class="rounded-b-2xl bg-accent/90 px-4 py-3 text-center text-sm text-white shadow-soft md:py-4 lg:float-right lg:mr-[-10px] lg:w-[440px]"
      set:html={data.photoCaption}
    />
  </figure>
  <figure class="px-8">
    <blockquote class="callout text-left">
      <p
        class="lead-text italic text-ink/90 first-letter:font-garamond first-letter:text-4xl first-letter:font-bold"
        set:html={data.mainText}
      />
    </blockquote>
    {
      data.quoteSource && (
        <figcaption class="mt-10 text-right text-muted">
          &ndash;<cite class="text-sm">{data.quoteSource}</cite>
        </figcaption>
      )
    }
  </figure>
</section>
