---
import SectionTitle from "../components/SectionTitle.astro";
import BioCard from "../components/BioCard.astro";
import type { Teacher } from "../../payload-types";

const res = await fetch(`${import.meta.env.CMS_API_URL}/teachers`);
const data = await res.json();
---

<section class="section-padding ink-panel text-surface">
  <SectionTitle title="Jonang Teachers" iconColor="saffron" titleColor="white" />
  <div class="flex flex-col gap-8">
    {
      data.docs
        .sort(
          (a: Teacher, b: Teacher) => a.orderOfAppearance - b.orderOfAppearance,
        )
        .map((teacher: Teacher) => (
          <BioCard
            img={teacher!.portrait!}
            name={teacher.name}
            roles={teacher.roles!}
            bio={teacher.bioHtml!}
            id={teacher.id}
          />
        ))
    }
  </div>
</section>
