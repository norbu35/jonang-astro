---
import SectionTitle from "../components/SectionTitle.astro";
import DonateCard from "../components/DonateCard.astro";

import type { Donation } from "../../payload-types";

const res = await fetch(`${import.meta.env.CMS_API_URL}/donations`);
const data = await res.json();
---

<section class="section-padding accent-panel text-white textured-panel textured-panel--dark">
  <div class="mx-auto max-w-6xl">
    <SectionTitle title="Support Us" iconColor="saffron" titleColor="white" />
    <div class={`cards-grid ${data.docs.length === 1 ? "lg:grid-cols-1" : ""}`.trim()}>
      {
        data.docs.map((item: Donation) => (
          <DonateCard
            headline={item.headline}
            goal={item.goal}
            description={item.description}
            img={item.image}
          />
        ))
      }
    </div>
  </div>
</section>
