---
import SectionTitle from "../components/SectionTitle.astro";
import DonateCard from "../components/DonateCard.astro";

import sustenanceImage from "../assets/images/chanting-trio.webp";
import healthcareImage from "../assets/images/lecture.webp";
import upkeepImage from "../assets/images/housing-landscape.webp";

const causes = [
  {
    headline: "Monastic Sustenance",
    goal: "Ongoing Need",
    description: "Provide daily meals, robes, and essential provisions for the resident sangha. Your support directly sustains those dedicating their lives to study and contemplation.",
    imgStatic: sustenanceImage, 
  },
  {
    headline: "Healthcare & Medicine",
    goal: "Crucial Care",
    description: "The cost of reliable medical care and winter pharmaceuticals is vital for the community. Help supply essential healthcare for elderly masters and young novices.",
    imgStatic: healthcareImage,
  },
  {
    headline: "Himalayan Sanctuary Upkeep",
    goal: "Urgent Maintenance",
    description: "Contribute to the seasonal maintenance and structural upkeep of monastic quarters in the harsh Himalayan climate, ensuring safe and warm shelter for study.",
    imgStatic: upkeepImage,
  }
];
---

<section id="support" class="section-padding bg-surface-muted ring-1 ring-border/20 shadow-inner scroll-mt-12">
  <div class="mx-auto max-w-[85rem] px-4 md:px-8">
    <SectionTitle title="Support the Tradition" iconColor="saffron" titleColor="ink" />
    <div class="cards-grid mt-10 md:mt-16 xl:grid-cols-3">
      {
        causes.map((item) => (
          <DonateCard
            headline={item.headline}
            goal={item.goal}
            description={item.description}
            imgStatic={item.imgStatic}
          />
        ))
      }
    </div>
  </div>
</section>
