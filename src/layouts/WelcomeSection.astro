---
import SectionTitle from "../components/SectionTitle.astro";

const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/introText`);
const data = await res.json();
---

<section>
  <div class="parallax"></div>
  <div class="section-padding bg-surface-muted text-center textured-panel" id="welcome">
    <SectionTitle title="Welcome" iconColor="red" titleColor="black" />
    <p
      class="callout drop-cap lead-text mx-auto max-w-sm text-left font-garamond text-ink/90 md:max-w-lg lg:max-w-3xl"
      set:html={data.body}
    />
    <button class="primary-button mt-10"
      ><a href={data.buttonLink.slug}>About Us</a></button
    >
  </div>
</section>
