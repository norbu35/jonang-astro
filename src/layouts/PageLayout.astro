---
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import TitleBanner from "../components/TitleBanner.astro";
import SectionDivider from "../components/SectionDivider.astro";

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tibetanTitle?: string;
  fullBleed?: boolean;
}

const { title, description, image, imageAlt, tibetanTitle, fullBleed = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <slot name="head" slot="head" />

  <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
    <section>
      <TitleBanner title={title} image={image} imageAlt={imageAlt} tibetanTitle={tibetanTitle} />
      <SectionDivider class="section-divider--page" />

      {
        Astro.slots.has("default") &&
          (fullBleed ? (
            <slot />
          ) : (
            <div class="section-padding max-w-6xl mx-auto">
              <slot />
            </div>
          ))
      }

      <div class="w-full">
        <slot name="full-width" />
      </div>
    </section>
  </main>
</BaseLayout>
