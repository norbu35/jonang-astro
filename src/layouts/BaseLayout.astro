---
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_METADATA } from "../data/site";
import {
  buildCanonicalUrl,
  getGlobalKnowledgeGraph,
  getBreadcrumbSchema,
  getPageSpecificSchema,
  type BreadcrumbItem,
} from "../utils/seo";
import cormorantFont from "../assets/fonts/CormorantGaramond-Medium.woff2";
import notoSerifTibetanFont from "../assets/fonts/NotoSerifTibetan-Regular.woff2";
import "../../base.css";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  canonicalUrl?: string;
  type?: "website" | "article";
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = SITE_METADATA.description,
  image = "/logo512x512.jpg",
  canonicalUrl: customCanonical,
  type = "website",
  breadcrumbs,
} = Astro.props;

const pageTitle = title
  ? title.includes(SITE_METADATA.name) || title.includes(SITE_METADATA.shortName)
    ? title
    : `${title} | ${SITE_METADATA.shortName}`
  : `${SITE_METADATA.name} | Tibetan Buddhist Monastery`;

const canonicalUrl = customCanonical ?? buildCanonicalUrl(Astro.url.pathname);

const imageSrc = typeof image === "string" ? image : (image?.src ?? "/logo512x512.jpg");
const resolvedImageUrl = new URL(imageSrc, SITE_METADATA.siteUrl).toString();

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

const globalGraph = getGlobalKnowledgeGraph();
const breadcrumbSchema = breadcrumbs ? getBreadcrumbSchema(breadcrumbs) : null;
const pageSchema = getPageSpecificSchema(Astro.url.pathname);

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    ...globalGraph,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...(pageSchema ? [pageSchema] : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE_METADATA.keywords} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <!-- Font Preconnect & Network Optimization -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Jomolhari&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
    />

    <!-- Critical Canonical Font Preloads (Eliminates FOUT on first paint) -->
    <link rel="preload" href={cormorantFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={notoSerifTibetanFont} as="font" type="font/woff2" crossorigin />

    <!-- Favicons & App Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph (Facebook / Messaging) -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={SITE_METADATA.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={resolvedImageUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageUrl} />
    <meta name="twitter:image:alt" content={SITE_METADATA.name} />

    <!-- Schema.org JSON-LD Knowledge Graph -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdGraph)} />

    <!-- Dark Mode & Color Scheme Declaration (Modern Web Guidance) -->
    <meta name="color-scheme" content="light dark" />

    <!-- Zero-FOUC Theme Guard (Synchronous inline execution before first paint & after client-side swap) -->
    <script is:inline>
      function applyTheme() {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const isDark = stored === "dark" || (!stored && prefersDark);
          const root = document.documentElement;
          if (isDark) {
            root.classList.add("dark");
            root.classList.remove("light");
            root.setAttribute("data-theme", "dark");
          } else {
            root.classList.add("light");
            root.classList.remove("dark");
            root.setAttribute("data-theme", "light");
          }
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) {
            meta.content = stored ? (isDark ? "dark" : "light") : "light dark";
          }
        } catch {
          // Ignore local storage errors
        }
      }

      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);

      // Dynamic system theme change listener (when no explicit local preference is pinned)
      try {
        const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
        mediaQuery.addEventListener("change", function (e) {
          if (!localStorage.getItem("theme")) {
            applyTheme();
            window.dispatchEvent(
              new CustomEvent("theme-change", { detail: { theme: e.matches ? "dark" : "light" } })
            );
          }
        });
      } catch {
        // Ignore media query errors
      }
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-bg text-fg font-body antialiased flex flex-col justify-between">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10000] focus:px-5 focus:py-3 focus:bg-maroon focus:text-gold focus:font-bold focus:text-sm focus:rounded-xl focus:shadow-2xl focus:ring-2 focus:ring-gold focus:border focus:border-white/30 focus:outline-none"
    >
      Skip to main content
    </a>
    <Header />
    <slot />
    <Footer />

    <!-- High Performance Intersection Observer for Scroll Reveals & Glossary Popover Manager -->
    <script>
      import { initScrollReveal } from "../scripts/scrollReveal.js";
      import { initGlossaryPopovers } from "../scripts/glossaryPopover.ts";

      function initGlobalUI() {
        initScrollReveal();
        initGlossaryPopovers();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initGlobalUI);
      } else {
        initGlobalUI();
      }

      document.addEventListener("astro:page-load", initGlobalUI);
    </script>
    <!-- Observability & Real User Monitoring (Free-tier Netlify Telemetry) -->
    <script>
      import "../scripts/telemetry/index.ts";
    </script>
  </body>
</html>
