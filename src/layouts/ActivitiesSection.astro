---
import type { Activity } from "../../payload-types";
import SectionTitle from "../components/SectionTitle.astro";
import { Image } from "astro:assets";

const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/activities`);
const data: Activity = await res.json();
---

<section class="flex flex-col bg-surface-muted md:flex-row-reverse">
  <div class="md:w-1/2">
    {
      typeof data.image !== "string" ? (
        <Image
          src={data.image!.url!}
          alt={data.image!.alt!}
          width={data.image!.width!}
          height={data.image!.height!}
          class="h-full w-full object-cover"
        />
      ) : (
        <div>Error fetching image</div>
      )
    }
  </div>
  <div class="section-padding textured-panel text-left font-body text-ink md:w-1/2">
    <SectionTitle title="Activities" iconColor="darkgrey" titleColor="black" />
    <p
      class="drop-cap lead-text mx-auto max-w-xl text-left md:max-w-2xl"
      set:html={data.descriptionHtml}
    />
  </div>
</section>
