---
const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/siteTitle`);
const data = await res.json();
---

<div
  class="relative isolate flex min-h-[82vh] flex-col justify-center overflow-hidden md:min-h-[92vh]"
>
  <div
    class="hero-kenburns absolute inset-0 bg-[url('/src/assets/images/main-entrance.webp')] bg-cover bg-bottom md:bg-center"
    aria-hidden="true"
  ></div>
  
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-12 right-[-8%] h-[260px] w-[260px] rounded-full bg-[radial-gradient(circle_at_30%_30%,rgba(255,232,168,0.85),rgba(233,195,73,0.32)_45%,rgba(233,195,73,0.08)_65%,transparent_75%)] blur-2xl opacity-85 mix-blend-screen"
    ></div>
  </div>
  
  <div class="relative z-10 mx-6 md:mx-16 lg:mx-24 mt-16 md:mt-8 max-w-3xl p-8 md:p-12 rounded-[2rem] bg-gradient-to-br from-ink/80 via-ink/40 to-transparent backdrop-blur-lg border border-white/20 shadow-[0_30px_60px_rgba(0,0,0,0.4)]">
    <div
      lang="bo"
      class="font-tibetan text-4xl leading-[1.4] text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-5xl lg:text-[3.5rem] mb-6"
      aria-label="Name of the monastery in Tibetan"
      set:html={data.title}
    />
    
    <div class="h-[2px] w-20 bg-gold my-6 shadow-[0_2px_5px_rgba(0,0,0,0.5)]"></div>
    
    <h2 class="font-display text-4xl text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] md:text-5xl lg:text-[3.2rem] leading-tight mb-5">
      Main Jonang Takten Phuntsok Choeling
    </h2>
    <p class="font-garamond text-xl md:text-2xl tracking-[0.15em] text-white/95 uppercase drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)] m-0">
      The Jonang Monastery in Shimla
    </p>
  </div>
</div>
