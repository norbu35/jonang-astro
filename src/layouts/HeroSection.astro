---
import { Image } from "astro:assets";
import mainEntranceImg from "../assets/images/main-entrance.webp";
import { SITE_METADATA } from "../data/site";
---

<section class="home-hero" aria-labelledby="welcome-heading">
  <div class="home-container home-hero-inner">
    <div class="home-hero-copy">
      <p class="home-kicker">A living Tibetan Buddhist tradition · Shimla, India</p>
      <p lang="bo" class="home-tibetan font-tibetan">{SITE_METADATA.tibetanName}</p>
      <h1 id="welcome-heading">Main Jonang<br />Takten Phuntsok Choeling</h1>
      <p class="home-hero-lede">
        A home for learning, contemplation and community in the Himalayan foothills. Discover the
        Jonang tradition and the monastery that carries it forward.
      </p>
      <div class="home-hero-actions">
        <a class="home-button" href="/introduction"
          >Start with the tradition <span aria-hidden="true">→</span></a
        >
        <a class="home-secondary" href="#community"
          >Meet the community <span aria-hidden="true">↓</span></a
        >
      </div>
    </div>
    <figure class="home-hero-photo">
      <Image
        src={mainEntranceImg}
        alt="Monks gathered in front of the monastery’s colourful entrance"
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 900px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>Sanjauli, Shimla · Main Jonang Takten Phuntsok Choeling</figcaption>
    </figure>
  </div>
</section>
