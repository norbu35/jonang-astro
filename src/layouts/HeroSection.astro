---
import { Image } from "astro:assets";
import mainEntranceImg from "../assets/images/main-entrance.webp";
import Dharmachakra from "../components/icons/Dharmachakra.astro";

const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/siteTitle`);
const data = await res.json();

const heroStats = [
  { value: "1294", label: "Lineage Founded in Tsang" },
  { value: "1990", label: "Consecrated by 14th Dalai Lama" },
  { value: "18-Year", label: "Dialectical Shedra Syllabus" },
  { value: "~120", label: "Resident Sangha & Students" },
];
---

<div class="relative isolate flex min-h-[90vh] lg:min-h-[96vh] w-full flex-col justify-between overflow-hidden pt-[calc(var(--header-offset)+2rem)] pb-8 px-4 sm:px-8 md:px-12 lg:px-16">
  
  <!-- Optimized Responsive Background Image with Ken Burns animation -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none -z-20">
    <Image
      src={mainEntranceImg}
      alt="Main entrance of Main Jonang Takten Phuntsok Choeling in Shimla"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-kenburns h-full w-full object-cover object-bottom"
    />
  </div>

  <!-- Subtle localized scrims: Keeps the monastery facade, monks, and daylight vibrant and bright -->
  <div class="absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-black/60 via-black/20 to-transparent -z-10 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(15,10,10,0.55)_0%,rgba(15,10,10,0.2)_35%,transparent_65%)] -z-10 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/50 via-black/15 to-transparent -z-10 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -top-20 right-[-5%] h-[280px] w-[280px] rounded-full bg-gold/15 blur-3xl mix-blend-screen -z-10 pointer-events-none" aria-hidden="true"></div>

  <!-- Main Hero Content Block (Right-aligned / Top-anchored) -->
  <div class="relative z-10 mx-auto w-full max-w-6xl flex flex-col items-end text-right my-auto py-6">
    <div class="max-w-2xl flex flex-col items-end space-y-5">
      
      <!-- Top Kicker Pill -->
      <div class="inline-flex items-center gap-2 rounded-full bg-black/40 border border-gold/40 px-4 py-1.5 backdrop-blur-md shadow-md">
        <Dharmachakra class="w-3.5 h-3.5 text-gold animate-spin-slow" />
        <span class="text-[11px] sm:text-xs font-mono font-semibold tracking-wider text-gold uppercase">
          Sanjauli, Shimla · Himachal Pradesh, India
        </span>
      </div>

      <!-- Formal Tibetan Monastic Title -->
      <div
        lang="bo"
        class="font-tibetan text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] leading-[1.3] text-white font-bold drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)]"
        aria-label="Name of the monastery in Tibetan"
        set:html={data.title}
      />

      <!-- Decorative Divider -->
      <div class="flex items-center gap-3 w-full justify-end">
        <div class="h-[2px] w-24 bg-gradient-to-l from-gold via-gold/80 to-transparent shadow-[0_2px_8px_rgba(0,0,0,0.6)]"></div>
        <div class="w-2 h-2 rounded-full bg-gold shadow-[0_0_8px_rgba(233,195,73,0.8)]"></div>
      </div>

      <!-- English Monastic Title -->
      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[3.1rem] text-white font-normal leading-[1.18] drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)] m-0">
        Main Jonang Takten Phuntsok Choeling
      </h1>

      <!-- Contextual Subtitle -->
      <p class="text-sm sm:text-base md:text-lg text-white/90 font-sans leading-relaxed drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)] m-0 max-w-xl">
        Principal seat of the Jonang tradition in exile. Preserving Shentong Madhyamaka philosophy, the Kālacakra Six-fold Vajrayoga, and an eighteen-year monastic curriculum.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
        <a
          href="/about-us"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-gold px-5 sm:px-6 py-3 text-xs sm:text-sm font-semibold uppercase tracking-wider text-ink shadow-lg transition-all duration-300 hover:bg-white hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        >
          <span>Monastery History</span>
          <span>→</span>
        </a>

        <a
          href="/curriculum"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-black/50 border border-white/30 backdrop-blur-md px-5 sm:px-6 py-3 text-xs sm:text-sm font-semibold uppercase tracking-wider text-white shadow-md transition-all duration-300 hover:bg-white/15 hover:border-gold hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        >
          <span>18-Year Syllabus</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Bottom Floating Glassmorphism Stats Bar -->
  <div class="relative z-10 mx-auto w-full max-w-6xl pt-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 p-4 sm:p-5 rounded-2xl bg-black/45 border border-white/15 backdrop-blur-md shadow-2xl">
      {
        heroStats.map((stat) => (
          <div class="text-center sm:text-left sm:pl-3 border-r border-white/10 last:border-0 space-y-0.5">
            <span class="text-xl sm:text-2xl font-display font-bold text-gold block leading-tight">
              {stat.value}
            </span>
            <span class="text-[11px] sm:text-xs text-white/75 font-sans leading-tight block">
              {stat.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>

</div>
