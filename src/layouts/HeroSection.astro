---
const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/siteTitle`);
const data = await res.json();
---

<div
  class="relative isolate flex min-h-[82vh] flex-col justify-start pt-[15vh] overflow-hidden md:min-h-[92vh]"
>
  <div
    class="hero-kenburns absolute inset-0 bg-[url('/src/assets/images/main-entrance.webp')] bg-cover bg-bottom md:bg-center"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-ink/90 via-ink/60 to-transparent md:bg-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 hidden md:block bg-gradient-to-r from-ink/95 via-ink/70 to-transparent"
    aria-hidden="true"
  ></div>
  
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-12 right-[-8%] h-[260px] w-[260px] rounded-full bg-[radial-gradient(circle_at_30%_30%,rgba(255,232,168,0.85),rgba(233,195,73,0.32)_45%,rgba(233,195,73,0.08)_65%,transparent_75%)] blur-2xl opacity-85 mix-blend-screen"
    ></div>
  </div>
  
  <div class="relative z-10 w-full px-6 md:px-16 lg:px-24 max-w-3xl">
    <div class="flex h-16 w-16 md:h-20 md:w-20 items-center justify-center rounded-full border-2 border-white/80 bg-accent text-3xl text-white shadow-[0_0_30px_rgba(255,232,168,0.3)] mb-6 md:mb-8">
      ☸
    </div>
    
    <div
      lang="bo"
      class="font-tibetan text-3xl leading-[1.3] text-white drop-shadow-[0_2px_10px_rgba(0,0,0,0.5)] md:text-4xl lg:text-5xl mb-4 md:mb-6"
      aria-label="Name of the monastery in Tibetan"
      set:html={data.title}
    />
    
    <div class="h-[2px] w-16 bg-gold my-4 md:my-6"></div>
    
    <h2 class="font-display text-3xl text-white drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)] md:text-4xl lg:text-[2.8rem] leading-tight mb-4">
      Main Jonang Takten Phuntsok Choeling
    </h2>
    <p class="font-garamond text-lg md:text-xl tracking-[0.1em] text-white/90 uppercase drop-shadow-[0_2px_5px_rgba(0,0,0,0.5)]">
      The Jonang Monastery in Shimla
    </p>
  </div>
</div>
