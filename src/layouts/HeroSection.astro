---
import mainEntranceImg from '../assets/images/main-entrance.webp';

const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/siteTitle`);
const data = await res.json();
---

<div
  class="relative isolate flex min-h-[82vh] w-full flex-col justify-start items-end overflow-hidden md:min-h-[92vh] pt-[15vh] md:pt-[18vh]"
>
  <div
    class="hero-kenburns absolute inset-0 bg-cover bg-bottom"
    style={`background-image: url('${mainEntranceImg.src}')`}
    aria-hidden="true"
  ></div>
  
  <!-- Subtle dark glow in the top right corner only, anchoring the text without covering the monks at the bottom -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(25,25,30,0.65)_0%,rgba(25,25,30,0.2)_40%,transparent_70%)]"
    aria-hidden="true"
  ></div>
  
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-12 right-[-8%] h-[260px] w-[260px] rounded-full bg-[radial-gradient(circle_at_30%_30%,rgba(255,232,168,0.85),rgba(233,195,73,0.32)_45%,rgba(233,195,73,0.08)_65%,transparent_75%)] blur-2xl opacity-85 mix-blend-screen"
    ></div>
  </div>
  
  <div class="relative z-10 mx-6 md:mx-12 lg:mx-20 max-w-xl text-right flex flex-col items-end">
    <div
      lang="bo"
      class="font-tibetan text-3xl leading-[1.3] text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)] md:text-4xl lg:text-5xl mb-4"
      aria-label="Name of the monastery in Tibetan"
      set:html={data.title}
    />
    
    <div class="h-[2px] w-16 bg-gold my-4 shadow-[0_2px_5px_rgba(0,0,0,0.5)]"></div>
    
    <h2 class="font-display text-3xl text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)] md:text-4xl lg:text-[2.6rem] leading-tight mb-4">
      Main Jonang Takten Phuntsok Choeling
    </h2>
    <p class="font-garamond text-lg md:text-xl tracking-[0.15em] text-white/95 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)] m-0">
      The Jonang Monastery in Shimla
    </p>
  </div>
</div>
