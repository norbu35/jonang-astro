---
import { Image } from "astro:assets";
import mainEntranceImg from "../assets/images/main-entrance.webp";
import { SITE_METADATA } from "../data/site";
---

<section
  class="relative w-full h-screen min-h-[100dvh] overflow-hidden flex flex-col justify-between pt-[var(--header-h)] pb-6 sm:pb-8 px-4 sm:px-6 md:px-10 lg:px-12"
>
  <!-- Full-Bleed Hero Background Image covering 100% viewport, anchored so all monks are visible -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <Image
      src={mainEntranceImg}
      alt="Main entrance and monastic community of Main Jonang Takten Phuntsok Choeling in Shimla"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-kenburns h-full w-full object-cover object-bottom sm:object-[center_95%]"
    />
  </div>

  <!-- Subtle localized scrims: Keeps the monastery facade, monks, and daylight vibrant and bright -->
  <div
    class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-black/70 via-black/25 to-transparent z-[1] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/45 via-transparent to-transparent z-[1] pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <!-- Static White-on-Red Consecrated Title Plaque (Elevated & Prominent) -->
  <div class="relative z-10 mx-auto w-full flex justify-center text-center mt-6 sm:mt-8 lg:mt-10">
    <div
      class="inline-flex flex-col items-center rounded-2xl sm:rounded-3xl bg-gradient-to-b from-[#8f1e21]/96 via-[#7b171a]/96 to-[#661214]/96 border border-[#fdbc2d]/50 px-7 py-3.5 sm:px-10 sm:py-4.5 shadow-[0_20px_45px_rgba(40,4,8,0.8),inset_0_1px_1px_rgba(255,255,255,0.25)] backdrop-blur-md transition-all duration-300"
    >
      <!-- Row 1: Tibetan Title in Sacred Gold (Larger) -->
      <div
        lang="bo"
        class="font-tibetan text-base sm:text-lg md:text-xl lg:text-2xl text-[#fdbc2d] font-bold tracking-widest leading-normal sm:leading-relaxed mb-1 drop-shadow-sm"
        aria-label="Monastery Name in Tibetan"
      >
        {SITE_METADATA.tibetanName}
      </div>

      <!-- Row 2: Main English Title in Crisp Static White (Larger) -->
      <h1
        class="font-serif text-xl sm:text-2xl md:text-3xl lg:text-4xl text-white font-bold leading-tight tracking-[0.015em] m-0 drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]"
      >
        {SITE_METADATA.name}
      </h1>
    </div>
  </div>
</section>
