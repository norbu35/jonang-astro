---
import Card from "../components/Card.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { normalizeGalleryHref, resolveStaticPageHref } from "../data/staticPages";
import type { Page } from "../../payload-types";

let cards;
try {
  const response = await fetch(`${import.meta.env.CMS_API_URL}/cards`);

  if (!response.ok) {
    throw Error("Error fetching data.");
  }

  const data = await response.json();
  cards = data.docs;
} catch (error: any) {
  throw Error(error);
}

function isPage(object: unknown): object is Page {
  return (
    typeof object === "object" &&
    object !== null &&
    "slug" in object &&
    typeof (object as Page).slug === "string"
  );
}

function resolvePageLink(page: Page): string {
  return resolveStaticPageHref(page.slug) ?? `/${page.slug}`;
}

function resolveCardLink(card: any): string {
  const header = typeof card.header === "string" ? card.header.toLowerCase() : "";
  if (header.includes("gallery") || header.includes("photo")) {
    return normalizeGalleryHref("gallery");
  }

  if (isPage(card.link)) {
    return resolvePageLink(card.link);
  }

  if (typeof card.link === "string" && card.link.length > 0) {
    return normalizeGalleryHref(card.link);
  }

  return "/";
}
---

<section class="section-padding bg-surface textured-panel">
  <div class="editorial-shell tonal-block mx-auto max-w-6xl px-5 py-8 md:px-10 md:py-12">
    <SectionTitle title="Explore" iconColor="darkgrey" titleColor="black" />
    <p class="section-intro">
      Discover <span class="pill">teachings</span>, <span class="pill">programs</span>,
      and <span class="pill">community life</span> across the monastery.
    </p>
    <div class="cards-grid">
      {
        cards.map((card: any) => (
          <Card
            img={card.image}
            header={card.header}
            body={card.body}
            link={resolveCardLink(card)}
          />
        ))
      }
    </div>
  </div>
</section>
