---
import { Image } from "astro:assets";

interface Props {
  title: string;
  body: string;
  imageSrc: any; // ImageMetadata
}

const { title, body, imageSrc } = Astro.props;
---

<div class="fresco-wall group animate-reveal-up mx-auto max-w-5xl">
  <div class="fresco-text-wrapper">
    <h4 class="font-display text-4xl md:text-5xl text-accent mb-4 leading-tight drop-shadow-sm">{title}</h4>
    <div class="w-16 h-0.5 bg-gold mb-6"></div>
    <p class="font-garamond text-xl md:text-2xl text-ink/90 text-justify leading-relaxed m-0">
      {body}
    </p>
  </div>
  <div class="fresco-inset-wrapper border border-border/30">
    <Image src={imageSrc} alt="" width={800} class="fresco-inset-image" />
    <div class="absolute inset-0 bg-accent/5 transition-opacity duration-500 group-hover:opacity-0 pointer-events-none"></div>
  </div>
</div>