---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  class="title-banner relative flex h-44 items-center justify-center overflow-hidden bg-[url('/src/assets/images/vajra-bell.webp')] bg-cover bg-center md:h-52 lg:h-60"
>
  <div class="title-banner__overlay" aria-hidden="true"></div>
  <div class="title-banner__ornament" aria-hidden="true"></div>
  <h1 class="title-banner__title relative z-10 text-center font-display text-3xl font-semibold text-white md:text-4xl lg:text-5xl">
    {title}
  </h1>
</div>
