---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-12 h-12 text-gold", size = 48 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Outer rim -->
  <circle cx="50" cy="50" r="44" stroke-width="2.5" />
  <circle cx="50" cy="50" r="38" stroke-width="1.5" stroke-dasharray="2 4" />
  
  <!-- Hub -->
  <circle cx="50" cy="50" r="14" stroke-width="2.5" fill="currentColor" fill-opacity="0.1" />
  <circle cx="50" cy="50" r="6" fill="currentColor" />
  
  <!-- 8 Spokes -->
  <line x1="50" y1="6" x2="50" y2="36" stroke-width="2.5" stroke-linecap="round" />
  <line x1="50" y1="64" x2="50" y2="94" stroke-width="2.5" stroke-linecap="round" />
  <line x1="6" y1="50" x2="36" y2="50" stroke-width="2.5" stroke-linecap="round" />
  <line x1="64" y1="50" x2="94" y2="50" stroke-width="2.5" stroke-linecap="round" />
  <line x1="18.89" y1="18.89" x2="40.1" y2="40.1" stroke-width="2.5" stroke-linecap="round" />
  <line x1="59.9" y1="59.9" x2="81.11" y2="81.11" stroke-width="2.5" stroke-linecap="round" />
  <line x1="18.89" y1="81.11" x2="40.1" y2="59.9" stroke-width="2.5" stroke-linecap="round" />
  <line x1="59.9" y1="40.1" x2="81.11" y2="18.89" stroke-width="2.5" stroke-linecap="round" />
  
  <!-- Cardinal Crown Points -->
  <path d="M50 2 L53 6 L47 6 Z" fill="currentColor" stroke="none" />
  <path d="M98 50 L94 47 L94 53 Z" fill="currentColor" stroke="none" />
  <path d="M50 98 L53 94 L47 94 Z" fill="currentColor" stroke="none" />
  <path d="M2 50 L6 47 L6 53 Z" fill="currentColor" stroke="none" />
</svg>
