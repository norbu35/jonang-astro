---
import { Image } from "astro:assets";

interface Props {
  title: string;
  body: string;
  imageSrc: any; // ImageMetadata
  imageAlt: string;
}

const { title, body, imageSrc, imageAlt } = Astro.props;
---

<div class="relative w-full min-h-[72vh] sm:min-h-[82vh] flex items-center justify-start overflow-hidden py-16 sm:py-24 px-4 sm:px-8 md:px-12 lg:px-16 bg-surface-subtle rounded-2xl md:rounded-3xl border border-border shadow-2xl">
  
  <!-- Full-Bleed Sanctuary Background Image at 100% Natural Brightness (Zero Darkening Overlay) -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <Image
      src={imageSrc}
      alt={imageAlt}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      class="w-full h-full object-cover object-[center_30%] sm:object-[center_25%] transform scale-100 transition-transform duration-1000 ease-out"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Left-Directed Editorial Card with its Own Dedicated Background -->
  <div class="relative z-10 w-full max-w-lg lg:max-w-xl text-left text-white space-y-5 sm:space-y-6 p-6 sm:p-8 md:p-10 rounded-2xl md:rounded-3xl bg-[#500c0e]/92 sm:bg-[#500c0e]/90 backdrop-blur-xl border border-gold/50 shadow-2xl">
    
    <div class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-gold/40 px-3.5 py-1.5 backdrop-blur-md shadow-md text-xs font-mono tracking-wider text-gold uppercase font-semibold">
      <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
      The Kālacakra Tantra · དུས་འཁོར་རྫོགས་རིམ།
    </div>

    <h2 class="text-3xl sm:text-4xl md:text-5xl font-display text-white font-normal leading-[1.15] tracking-tight drop-shadow-md mb-6 sm:mb-8">
      {title}
    </h2>

    <p class="font-serif text-base sm:text-lg text-[#f0e6d8] leading-relaxed drop-shadow-sm">
      {body}
    </p>

    <div class="pt-2 sm:pt-4">
      <a
        href="/kalachakra"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gold hover:bg-gold-hover text-stone-950 font-semibold text-xs sm:text-sm uppercase tracking-wider transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5"
      >
        <span>Explore the Six-Fold Vajrayoga</span>
        <span>→</span>
      </a>
    </div>
  </div>

</div>
