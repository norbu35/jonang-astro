---
interface BibItem {
  title: string;
  author: string;
  year: string;
  publisher: string;
  category: string;
  categoryGroup: "treatise" | "academic" | "translation" | "canonical" | "manual" | "contemporary";
  desc: string;
  link: string;
  sourceName: string;
}

