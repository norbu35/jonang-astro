    sourceName: "Univ. Heidelberg JIABS",
  },
  {
    title: "Instructions for Practicing the View of Other Emptiness",
    author: "Jamgön Kongtrul Lodrö Thaye (Trans. Tony Duff)",
    year: "2011",
    publisher: "Padma Karpo Translation Committee (PKTC)",
    category: "Meditation Manual",
    categoryGroup: "manual",
    desc: "Practical manual of oral instructions showing how to apply the Shentong view in direct contemplative meditation.",
    link: "https://search.worldcat.org/search?q=Instructions+for+Practicing+Other+Emptiness+Tony+Duff",
    sourceName: "WorldCat Catalog",
  },
  {
    title: "Opening the Wisdom Door of the Rangtong and Shentong Views",
