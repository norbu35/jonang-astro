<section class="surface-card p-6 sm:p-8 md:p-10 space-y-6 my-10 relative overflow-hidden" id="bibliography">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-6">
    <div class="space-y-1">
      <div class="badge badge-saffron">
        <span class="badge-dot"></span>
        Scholarly Archive
      </div>
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        Bibliography on Shentong (Other-Emptiness)
      </h3>
      <p class="text-xs sm:text-sm text-muted">
        Curated reading list of canonical scriptures, classical Jonang masterworks, and modern academic translations compiled by Jens Näsström.
      </p>
    </div>

    <div class="text-xs font-mono text-muted/80 bg-surface-subtle px-3 py-1.5 rounded-lg border border-border shrink-0 self-start sm:self-center">
      {bibliography.length} Verified Publications
    </div>
  </div>

  <!-- Interactive Filter Search Container -->
  <div class="relative">
    <div class="flex items-center gap-2 mb-4">
      <span class="text-xs font-semibold text-accent uppercase tracking-wider">Explore Shelf:</span>
      <span class="text-xs text-muted">Scroll horizontally or browse publications below with verified links to publisher editions & library catalogs.</span>
    </div>

    <!-- Horizontal Scrolling Shelf -->
    <div class="flex gap-5 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scrollbar-thin scrollbar-thumb-accent-secondary/30">
      {
        bibliography.map((book, idx) => (
          <article class="surface-card p-5 w-76 sm:w-84 shrink-0 snap-start flex flex-col justify-between space-y-4 border-t-4 border-t-accent hover-lift bg-surface shadow-xs">
            <div class="space-y-2">
              <div class="flex justify-between items-center text-[11px] font-mono text-muted">
                <span class="font-bold text-accent">#{String(idx + 1).padStart(2, '0')}</span>
                <span class="text-accent-secondary font-semibold">{book.year}</span>
              </div>
              
              <h4 class="font-display text-base font-bold text-ink leading-snug line-clamp-2">
                {book.title}
              </h4>
              
              <p class="text-xs font-semibold text-ink/80">
                {book.author}
              </p>
              
              <span class="badge badge-neutral text-[10px] inline-block mb-1">
                {book.category}
              </span>
              
              <p class="text-xs text-muted leading-relaxed line-clamp-3">
                {book.desc}
              </p>
            </div>

            <div class="pt-3 border-t border-border flex items-center justify-between">
              <span class="text-[10px] text-muted font-mono truncate max-w-[130px]">
                {book.publisher}
              </span>
              <a
                href={book.link}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary text-[11px] py-1 px-2.5 rounded hover:text-accent font-semibold transition flex items-center gap-1 shrink-0"
                aria-label={`View ${book.title} on ${book.sourceName}`}
              >
                <span>{book.sourceName}</span>
                <span class="text-xs">↗</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Detailed Table / Grid for Comprehensive Browsing -->
  <details class="group mt-6 pt-4 border-t border-border">
    <summary class="cursor-pointer text-xs font-semibold uppercase tracking-wider text-accent flex items-center gap-2 hover:text-accent-hover transition select-none">
      <span>View Complete Index as Catalog Table ({bibliography.length} Entries)</span>
      <span class="group-open:rotate-180 transition-transform">▼</span>
    </summary>
    
    <div class="overflow-x-auto mt-4">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="bg-surface-subtle border-b border-border text-ink font-display">
            <th class="p-3">#</th>
            <th class="p-3">Title & Overview</th>
            <th class="p-3">Author / Translator</th>
            <th class="p-3">Publisher & Year</th>
            <th class="p-3 text-right">Edition Resource</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            bibliography.map((b, i) => (
              <tr class="hover:bg-surface-subtle/40 transition-colors">
                <td class="p-3 font-mono font-bold text-accent align-top">{i + 1}</td>
                <td class="p-3 align-top">
                  <div class="font-bold text-ink mb-0.5">{b.title}</div>
                  <div class="text-[11px] text-muted">{b.desc}</div>
                </td>
                <td class="p-3 text-ink align-top font-medium">{b.author}</td>
                <td class="p-3 text-muted align-top">{b.publisher} ({b.year})</td>
                <td class="p-3 text-right align-top">
                  <a
                    href={b.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-secondary text-[11px] py-1 px-2.5 rounded hover:text-accent font-semibold inline-flex items-center gap-1"
                  >
                    <span>{b.sourceName}</span>
                    <span class="text-xs">↗</span>
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</section>
