    category: "Academic Monograph",
    categoryGroup: "academic",
    desc: "Rigorous historical-critical inquiry into the Indian roots of Shentong terminology in Sanskrit Prajnaparamita commentaries.",
    link: "https://www.istb.univie.ac.at/forschung/arbeitskreis-tibetische-buddhistische-studien/publikationen/wstb/",
    sourceName: "Univ. Wien ISTB",
  },
  {
    title: "A Juggernaut of the Non-Dual View: Ultimate Teachings of the Second Drukchen Gyalwang Je",
    author: "Tony Duff",
    year: "2011",
