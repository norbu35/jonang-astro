---
import { Image } from "astro:assets";
import type { SiteTitle } from "../../payload-types";

const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/siteTitle`);
const data: SiteTitle = await res.json();
---

<div class="section-padding text-center text-ink textured-panel">
  <h1
    class="mb-6 font-siteTitle text-4xl md:mb-10 md:text-5xl lg:text-6xl"
    set:html={data.secondaryTitle}
  />
  <div class="mx-auto w-32 md:w-36">
    {
      typeof data.logo !== "string" ? (
        <Image
          src={data.logo!.url!}
          alt={data.logo!.alt!}
          width={data.logo!.width!}
          height={data.logo!.height!}
          class="mx-auto"
        />
      ) : (
        <div>Error fetching image</div>
      )
    }
  </div>
  <div class="mt-6 text-base italic text-muted md:text-lg" set:html={data.subheading} />
</div>
