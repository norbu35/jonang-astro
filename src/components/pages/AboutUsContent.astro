---

<div class="section-padding max-w-6xl mx-auto space-y-12 pb-0">
  <!-- Introductory Overview -->
  <div
    id="monastery-overview"
    class="surface-card p-6 sm:p-8 md:p-10 space-y-6 scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight m-0"
    >
      Preserving Lineage, Scholarship, and Contemplative Practice
    </h2>

    <p class="lead text-base sm:text-lg text-muted font-serif leading-relaxed m-0">
      Main Jonang Takten Phuntsok Choeling in Sanjauli, Shimla, serves as the central seat of the
      Jonang tradition in exile, dedicated to preserving the definitive <em>Shentong</em> philosophy and
      the unbroken Six Yogas of the Kalachakra Tantra.
    </p>

    <p class="text-ink leading-relaxed text-sm sm:text-base font-serif m-0">
      The monastery's origins trace back to the late 1960s through the tireless efforts of Lama
      Jinpa Gyatso. In 1990, His Holiness the 14th Dalai Lama formally bestowed its enduring title—<em
        >Main Jonang Takten Phuntsok Choeling</em
      >—establishing it as a recognized home of monastic education. The monastery later developed
      under the spiritual guidance of the 9th Khalkha Jetsun Dhampa Jampal Namdrol Chokyi Gyaltsen,
      head of the Jonang tradition until his passing in 2012.
    </p>
  </div>
</div>

<!-- Full-Width Featured Multimedia Ceremony: Tara Puja Assembly -->
<section
  id="monastery-documentary"
  class="w-full bg-gradient-to-b from-surface-subtle/90 via-surface to-surface-subtle/60 py-12 sm:py-16 md:py-20 border-y border-border/80 relative overflow-hidden my-10 sm:my-14 md:my-16 reveal-on-scroll scroll-mt-[calc(var(--header-h)+4.5rem)]"
>
  <!-- Ambient background glow elements -->
  <div
    class="pointer-events-none absolute -top-32 left-1/4 w-[500px] h-[500px] bg-gold/8 blur-3xl rounded-full"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 right-1/4 w-[500px] h-[500px] bg-accent/6 blur-3xl rounded-full"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <VideoFeature
      videoId="pr00n4no4Vc"
      title="First Day of Tara Puja at Shimla Jonang Monastery"
      tibetanTitle="༄༅། །ཇོ་ནང་དགོན་པའི་འཕགས་མ་སྒྲོལ་མའི་ཚོགས་མཆོད། །"
      subtitle="Annual Liturgical Assemblies, Sacred Chanting & Tara Puja at Main Jonang Takten Phuntsok Choeling"
      summary="Archival ceremony recording the commencement of the annual Noble Tārā Puja (Drolma Tsokchod) at Main Jonang Takten Phuntsok Choeling in Sanjauli, Shimla. The assembly of resident Geshes, monastic scholars, and students gather in the main prayer hall to chant the Praises to the Twenty-One Tārās, sound ritual horns and instruments, and dedicate collective merit for the welfare of all beings."
      badge="Monastic Liturgy"
      channelName="Shimla Jonang Buddhist Monastery"
      channelUrl="https://www.youtube.com/watch?v=pr00n4no4Vc"
      duration="Live Assembly Ceremony"
      actionHref="#weekly-schedule"
      actionLabel="View Monastery Liturgical Schedule"
      id="monastery-video"
    />
  </div>
</section>

<div class="section-padding max-w-6xl mx-auto flex flex-col gap-12 sm:gap-16 pt-0">
  <!-- Architecture & Grounds (Location & Facilities) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
    <div class="surface-card overflow-hidden rounded-2xl shadow-card border border-border">
      <Image
        src={entranceImage}
        alt="Entrance to Main Jonang Takten Phuntsok Choeling in Shimla"
        class="w-full h-auto aspect-[16/10] object-cover transition-transform duration-700 hover:scale-105"
        width={640}
        height={400}
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="flex flex-col gap-4">
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">Sanjauli, Shimla</h3>
      <p class="text-sm sm:text-base text-muted leading-relaxed font-serif m-0">
        Located in Sanjauli, Shimla (Himachal Pradesh, India), the monastery complex includes a main
        prayer hall (lhakhang), classrooms for the eighteen-year shedra, a library of classical
        canonical texts, and retreat quarters for three-year Kālacakra dark retreat practice.
      </p>
    </div>
  </div>

  <!-- Historical Milestones: Four Visits of Dalai Lama -->
  <div
    id="dalai-lama-visits"
    class="surface-card p-6 sm:p-8 flex flex-col gap-6 scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
      Four Historic Visits of His Holiness the 14th Dalai Lama
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 pt-2">
      {
        dalaiLamaVisits.map((v) => (
          <div class="p-5 rounded-xl bg-surface-subtle border border-border flex flex-col gap-2 hover-lift">
            <span class="text-xl sm:text-2xl font-display font-bold text-accent block">
              {v.year}
            </span>
            <h4 class="font-display text-base font-bold text-ink m-0">{v.event}</h4>
            <p class="text-sm text-muted leading-relaxed m-0 font-serif">{v.desc}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Monastic Abbots Lineage Timeline -->
  <div id="abbots-lineage" class="flex flex-col gap-6 scroll-mt-[calc(var(--header-h)+4.5rem)]">
    <div class="flex items-center gap-3">
      <Dharmachakra class="w-7 h-7 text-accent-secondary" />
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        Succession of Lineage Abbots (Khenpo Rinpoches)
      </h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        abbots.map((abbot) => (
          <div class="surface-card p-6 flex flex-col justify-between h-full gap-3 border-t-4 border-t-accent hover-lift">
            <div class="flex flex-col gap-1.5">
              <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider block">
                {abbot.years}
              </span>
              <h4 class="font-display text-lg sm:text-xl font-bold text-ink m-0">{abbot.name}</h4>
              <span class="badge badge-neutral text-caption self-start mt-0.5">{abbot.role}</span>
              <p class="text-sm text-muted leading-relaxed font-serif m-0 pt-1">{abbot.note}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Resident Community & Demographics -->
  <div
    id="resident-sangha"
    class="surface-card p-6 sm:p-8 md:p-10 space-y-6 border-l-4 border-l-accent-secondary scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
      Resident Sangha Demographics
    </h3>

    <p class="text-sm sm:text-base text-muted leading-relaxed font-serif m-0">
      The monastery provides lodging, healthcare, and monastic education for approximately <strong
        >120 resident monks and staff members</strong
      >:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
      <div class="p-5 rounded-xl bg-surface-subtle border border-border flex flex-col gap-2">
        <span class="text-2xl font-display font-bold text-accent block">~70 Monks</span>
        <h4 class="font-display text-base sm:text-lg font-bold text-ink m-0">Assam & Mon Tawang</h4>
        <p class="text-sm text-muted leading-relaxed font-serif m-0">
          Students from Himalayan border communities enrolled in primary education and the
          eighteen-year shedra syllabus.
        </p>
      </div>

      <div class="p-5 rounded-xl bg-surface-subtle border border-border flex flex-col gap-2">
        <span class="text-2xl font-display font-bold text-accent-secondary block">~30 Monks</span>
        <h4 class="font-display text-base sm:text-lg font-bold text-ink m-0">Mongolia</h4>
        <p class="text-sm text-muted leading-relaxed font-serif m-0">
          Monks continuing the historical affiliation established under Jetsun Tāranātha and
          Zanabazar, including 12 students under full monastic care.
        </p>
      </div>

      <div class="p-5 rounded-xl bg-surface-subtle border border-border flex flex-col gap-2">
        <span class="text-2xl font-display font-bold text-accent-tertiary block">~20 Monks</span>
        <h4 class="font-display text-base sm:text-lg font-bold text-ink m-0">
          Tibet Lineage Scholars
        </h4>
        <p class="text-sm text-muted leading-relaxed font-serif m-0">
          Scholars from eastern Tibet (Amdo and Kham) who oversee philosophical instruction in
          Shentong Madhyamaka and Kālacakra ritual liturgy.
        </p>
      </div>
    </div>
  </div>

  <!-- Weekly Activities & Daily Prayers -->
  <div
    id="weekly-schedule"
    class="surface-card p-6 sm:p-8 space-y-6 scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
      Weekly Liturgical Assembly
    </h3>

    <p class="text-sm sm:text-base text-muted font-serif m-0">
      The resident sangha conducts communal liturgies according to the monastic calendar:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
      {
        weeklyPrayers.map((w) => (
          <div class="p-5 sm:p-6 rounded-xl bg-surface-subtle border border-border flex flex-col justify-between h-full gap-3 hover-lift">
            <div class="flex flex-col gap-1.5">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-accent">
                {w.day}
              </span>
              <h4 class="font-display text-base sm:text-lg font-bold text-ink leading-snug m-0">
                {w.prayers}
              </h4>
              <span
                lang="bo"
                class="text-sm sm:text-base font-tibetan text-accent-secondary font-bold block pt-0.5 leading-relaxed"
              >
                {w.tibetan}
              </span>
              <p class="text-xs sm:text-sm text-muted leading-relaxed font-serif m-0 pt-1 border-t border-border/40">
                {w.purpose}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Annual Religious Activities -->
  <div id="annual-monlam" class="flex flex-col gap-6 scroll-mt-[calc(var(--header-h)+4.5rem)]">
    <div class="flex flex-col gap-2">
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        Annual Ceremonies and Monlam Assemblies
      </h3>
      <p class="text-sm sm:text-base text-muted font-serif m-0">
        Major liturgical observances, monlam prayer festivals, and sacred anniversaries conducted
        according to the Tibetan lunar calendar:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        annualActivities.map((a) => (
          <div class="surface-card p-6 flex flex-col justify-between h-full gap-3 border-t-4 border-t-accent hover-lift">
            <div class="flex flex-col gap-1.5">
              <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider block">
                {a.tibetanDate}
              </span>
              <h4 class="font-display text-lg sm:text-xl font-bold text-ink m-0">{a.event}</h4>
              <span class="badge badge-neutral text-caption-xs self-start mt-0.5">
                {a.gregorian}
              </span>
              <p class="text-sm text-muted leading-relaxed font-serif m-0 pt-1">{a.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Curricular & Lineage Navigation -->
  <div
    id="study-and-support"
    class="surface-card p-6 sm:p-8 space-y-6 border-l-4 border-l-accent scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <div class="space-y-2">
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        Monastic Study and Support
      </h3>
      <p class="text-sm sm:text-base text-muted leading-relaxed m-0 font-serif">
        Detailed documentation of the eighteen-year shedra syllabus, teacher biographies, and
        monastic sponsorship:
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 pt-2">
      <a
        href="/curriculum"
        class="p-5 rounded-xl bg-surface-subtle border border-border hover:border-accent group transition-all flex flex-col justify-between gap-3"
      >
        <div class="flex flex-col gap-1.5">
          <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider block"
            >Curriculum</span
          >
          <h4
            class="font-display text-lg sm:text-xl font-bold text-ink group-hover:text-accent transition-colors m-0"
          >
            18-Year Syllabus →
          </h4>
          <p class="text-sm text-muted leading-relaxed m-0 font-serif">
            Tibetan grammar, Pramāṇa epistemology, the Five Great Treatises, and monastic ritual
            arts.
          </p>
        </div>
        <span
          class="text-xs sm:text-sm font-semibold text-accent flex items-center gap-1 group-hover:translate-x-1 transition-transform pt-2 border-t border-border/40"
        >
          View Complete Syllabus <span>→</span>
        </span>
      </a>

      <a
        href="/teachers"
        class="p-5 rounded-xl bg-surface-subtle border border-border hover:border-accent-secondary group transition-all flex flex-col justify-between gap-3"
      >
        <div class="flex flex-col gap-1.5">
          <span
            class="text-xs font-mono font-bold text-accent-secondary uppercase tracking-wider block"
            >Lineage</span
          >
          <h4
            class="font-display text-lg sm:text-xl font-bold text-ink group-hover:text-accent-secondary transition-colors m-0"
          >
            Resident Masters →
          </h4>
          <p class="text-sm text-muted leading-relaxed m-0 font-serif">
            Biographies and historical succession of the supreme lineage heads, abbots, and resident
            teachers.
          </p>
        </div>
        <span
          class="text-xs sm:text-sm font-semibold text-accent-secondary flex items-center gap-1 group-hover:translate-x-1 transition-transform pt-2 border-t border-border/40"
        >
          Read Master Biographies <span>→</span>
        </span>
      </a>

      <a
        href="/donate"
        class="p-5 rounded-xl bg-surface-subtle border border-border hover:border-accent-tertiary group transition-all flex flex-col justify-between gap-3"
      >
        <div class="flex flex-col gap-1.5">
          <span
            class="text-xs font-mono font-bold text-accent-tertiary uppercase tracking-wider block"
            >Sponsorship</span
          >
          <h4
            class="font-display text-lg sm:text-xl font-bold text-ink group-hover:text-accent-tertiary transition-colors m-0"
          >
            Monastic Giving →
          </h4>
          <p class="text-sm text-muted leading-relaxed m-0 font-serif">
            Information on meal sponsorship, healthcare funds, study materials, and direct bank wire
            transfers.
          </p>
        </div>
        <span
          class="text-xs sm:text-sm font-semibold text-accent-tertiary flex items-center gap-1 group-hover:translate-x-1 transition-transform pt-2 border-t border-border/40"
        >
          Monastic Giving Options <span>→</span>
        </span>
      </a>
    </div>
  </div>
</div>
