const annualActivities = [
  {
    tibetanDate: "First Month (1st Day) — Losar",
    gregorian: "Tibetan New Year",
    event: "Dharma Protector (Dharmapāla) Prayers",
    desc: "Commencement of the New Year with intensive invocation of protective lineage guardians (Mahākāla, Palden Lhamo) for global peace and the dispelling of adversity.",
  },
  {
    tibetanDate: "First Month (8th Day)",
    gregorian: "Annual Commemoration",
    event: "H.H. 9th Khalkha Jetsun Dampa Parinirvāṇa",
    desc: "Solemn prayer festival commemorating the life, realization, and legacy of the 9th Khalkha Jetsun Dampa, spiritual head of the Jonang lineage.",
  },
  {
    tibetanDate: "First Month (13th – 15th Days)",
    gregorian: "Chötrul Düchen Days",
    event: "Tripiṭaka Chanting (Kangyur Recitation)",
    desc: "The monastic assembly reads the 108 volumes of the canonical Kangyur in unison over three continuous days.",
  },
  {
    tibetanDate: "Fourth Month (15th Day)",
    gregorian: "Saga Dawa Düchen",
    event: "Buddha’s Birth, Enlightenment & Parinirvāṇa",
    desc: "Vast accumulation of merit with 24-hour circumambulations, butter lamp offerings, and Kālacakra sand mandala ceremonies.",
  },
  {
    tibetanDate: "Sixth Month (4th Day)",
    gregorian: "Chökhor Düchen",
    event: "First Turning of the Wheel of Dharma",
    desc: "Celebrating the Buddha's first teaching of the Four Noble Truths at Sarnath with extensive dialectical debate assemblies.",
  },
