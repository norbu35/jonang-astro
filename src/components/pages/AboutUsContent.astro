  {
    day: "Monday",
    prayers: "Lama Chöpa (Guru Puja) & Medicine Buddha (Menlha) Prayers",
    purpose:
      "Healing, dispelling illness and spiritual obstacles, and venerating the lineage masters.",
    tibetan: "བླ་མ་མཆོད་པ་དང་སྨན་བླ།",
  },
  {
    day: "Tuesday",
    prayers: "Āryasaṅghāṭasūtra (Arya Sanghata Sutra) & Kālacakra Ngöndro",
    purpose:
      "Accumulating vast transcendent merit, reciting canonical sūtras, and preliminary tantric purification.",
    tibetan: "འཕགས་པ་ཟུང་གི་མདོ་དང་དུས་འཁོར་སྔོན་འགྲོ།",
  },
  {
    day: "Wednesday",
    prayers: "Noble Tārā (Drolma), Sitātapatrā (Dukar) & Dharmapāla Tsokchod",
