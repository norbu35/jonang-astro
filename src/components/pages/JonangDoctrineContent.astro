---
import Dharmachakra from "../icons/Dharmachakra.astro";
import EndlessKnot from "../icons/EndlessKnot.astro";
import ShentongBibliography from "../ShentongBibliography.astro";
import VideoFeature from "../VideoFeature.astro";
import GlossaryTerm from "../ui/GlossaryTerm.astro";
import { STATIC_PAGE_PATHS } from "../../data/staticPages";

const threeTurnings = [
  {
    id: "first",
    turning: "First Turning",
    location: "Deer Park, Sarnath (Varanasi)",
    theme: "Four Noble Truths & Karma",
    tibetan: "བཀའ་དང་པོ་བདེན་བཞིའི་ཆོས་འཁོར།",
    view: "Establishes ethical discipline, causality, impermanence, and the selflessness of persons (pudgala-nairātmya) to overcome gross afflictive grasping.",
    scope: "Foundational Vehicle (Hīnayāna / Nikāya)",
  },
  {
    id: "second",
    turning: "Second Turning",
    location: "Vulture Peak, Rājagṛha (Rajgir)",
    theme: "Prajñāpāramitā & Non-Proliferation (Rangtong)",
    tibetan: "བཀའ་བར་པ་མཚན་ཉིད་མེད་པའི་ཆོས་འཁོར།",
    view: "Demonstrates that all conditioned entities, conceptual constructs, and conventional phenomena lack intrinsic, independent existence (svabhāva-śūnya).",
    scope: "Provisional Madhyamaka (Nāgārjuna / Candrakīrti)",
  },
  {
    id: "third",
    turning: "Third Turning",
    location: "Vaiśālī, Mount Malaya & Śrāvastī",
    theme: "Tathāgatagarbha & Definitive Shentong",
    tibetan: "བཀའ་ཐ་མ་ལེགས་པར་རྣམ་པར་ཕྱེ་བའི་ཆོས་འཁོར།",
    view: "Elucidates ultimate reality as non-dual primordial wisdom (jñāna), devoid of adventitious obscurations (gzhan stong) yet perpetually complete with inseparable enlightened qualities.",
    scope: "Definitive Great Madhyamaka (Maitreya / Dölpopa)",
  },
];

const philosophicalMatrix = [
  {
    category: "Relative Truth (Kun rdzob)",
    tibetan: "ཀུན་རྫོབ་བདེན་པ།",
    rangtong:
      "Empty of inherent essence (rangtong). Dependently originated, conceptual, and devoid of intrinsic nature.",
    shentong:
      "Agrees completely: all conventional appearances and defilements are dependently arisen and empty of self-nature.",
  },
  {
    category: "Ultimate Truth (Don dam)",
    tibetan: "དོན་དམ་བདེན་པ།",
    rangtong:
      "Defined strictly as the negation of inherent existence; non-affirming negative (prasajya-pratiṣedha).",
    shentong:
      "Definitive reality: luminous Buddha-nature (Tathāgatagarbha), empty of foreign defilements but replete with unconditioned qualities.",
  },
  {
    category: "Enlightenment (Bodhi)",
    tibetan: "བྱང་ཆུབ་ཀྱི་གོ་འཕང་།",
    rangtong: "Cessation of all conceptual fabrications and reification of phenomena.",
    shentong:
      "The direct experiential recognition and actualization of the primordial enlightened ground that was never absent.",
  },
];

const masters = [
  {
    name: "Maitreya & Asaṅga",
    tibetanName: "བྱམས་པ་དང་ཐོགས་མེད།",
    dates: "4th Century CE",
    role: "Indian Lineage Progenitors",
    body: "Composed the seminal treatises including the Uttaratantraśāstra (Ratnagotravibhāga) and Mahāyānasūtrālaṅkāra, founding the definitive Yogācāra-Madhyamaka synthesis of Buddha-nature.",
  },
  {
    name: "Somanātha, Dro Lotsawa & Yumo Mikyö Dorje",
    tibetanName: "ཟླ་མགོན་དང་འབྲོ་ལོ་ཙཱ་བ། ཡུ་མོ་མི་བསྐྱོད་རྡོ་རྗེ།",
    dates: "11th – 12th Century",
    role: "Translators & Tantric Adepts",
    body: "Translated the Kālacakra Mūlatantra and the Vimalaprabhā commentary into Tibetan. Yumo Mikyö Dorje subsequently unfolded the experiential Shentong completion-stage realization in dark retreat.",
  },
  {
    name: "Kunkhyen Dölpopa Sherab Gyaltsen",
    tibetanName: "ཀུན་མཁྱེན་དོལ་པོ་པ་ཤེས་རབ་རྒྱལ་མཚན།",
    dates: "1292 – 1361",
    role: "The Omniscient Master of Jomonang",
    body: "Systematized the Shentong Great Madhyamaka in his monumental work 'Mountain Doctrine' (Ri chos nges don rgya mtsho) and constructed the Great Kumbum of Jomonang.",
  },
  {
    name: "Jetsun Tāranātha",
    tibetanName: "རྗེ་བཙུན་ཏཱ་ར་ནཱ་ཐ།",
    dates: "1575 – 1635",
    role: "Revitalizer & Tantric Polymath",
    body: "Prolific historian, artist, and tantric master who founded Takten Damchö Ling Monastery and composed the definitive practice commentaries for the Kālacakra completion stage.",
  },
  {
    name: "Zanabazar (1st Jebtsundamba Khutuktu)",
    tibetanName: "རྗེ་བཙུན་དམ་པ་སྐུ་ཕྲེང་དང་པོ་ཛྙཱ་ན་བཛྲ།",
    dates: "1635 – 1723",
    role: "1st Bogd Gegeen of Mongolia",
    body: "Recognized as the immediate rebirth of Jetsun Tāranātha by the 5th Dalai Lama, establishing the historical transmission line between Jonang and Mongolian monastic institutions.",
  },
];
---

<div class="section-padding max-w-6xl mx-auto flex flex-col gap-12 sm:gap-16 pb-0">
  <!-- Beginner's Primer Callout -->
  <div
    class="surface-card p-6 sm:p-8 rounded-2xl border-l-4 border-l-gold bg-gradient-to-r from-surface to-surface-subtle shadow-card flex flex-col md:flex-row md:items-center justify-between gap-6"
  >
    <div class="flex flex-col gap-2 max-w-2xl">
      <h3 class="text-xl sm:text-2xl font-display text-ink font-bold m-0">
        Foundational Overview of the Jonang Lineage
      </h3>
      <p class="text-sm text-muted leading-relaxed m-0 font-serif">
        An introductory primer detailing foundational Buddhist tenets, the Five Tibetan Traditions,
        and the definitive Shentong view of ultimate Buddha-nature.
      </p>
    </div>
    <a
      href={STATIC_PAGE_PATHS.introduction}
      class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-accent text-white hover:bg-accent-hover font-semibold text-xs sm:text-sm uppercase tracking-wider transition-all shadow-md shrink-0 self-start md:self-center hover:-translate-y-0.5"
    >
      <span>Introductory Primer</span>
      <span>→</span>
    </a>
  </div>

  <!-- Core Philosophical Vision Callout -->
  <div
    id="shentong-view"
    class="surface-card p-6 sm:p-8 md:p-10 flex flex-col gap-6 scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <div class="flex flex-col gap-2.5">
      <h2
        class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight m-0"
      >
        The Shentong View of Ultimate Reality
      </h2>
      <span
        lang="bo"
        class="font-tibetan text-base sm:text-lg text-accent font-bold block pt-0.5 leading-[1.6]"
      >
        དོན་དམ་གཞན་སྟོང་གི་ལྟ་བ།
      </span>
    </div>

    <p class="lead text-base sm:text-lg text-muted font-serif leading-relaxed m-0">
      The Jonang tradition articulates the <GlossaryTerm id="shentong">Shentong</GlossaryTerm> <GlossaryTerm id="madhyamaka">Madhyamaka</GlossaryTerm> framework: conventional phenomena
      are empty of self-nature (<GlossaryTerm id="rangtong">rangtong</GlossaryTerm>), whereas ultimate reality—Buddha-nature (<GlossaryTerm id="tathagatagarbha">Tathāgatagarbha</GlossaryTerm>)—is empty only of adventitious obscurations (<GlossaryTerm id="agantukamala">āgantukamala</GlossaryTerm>).
    </p>

    <p class="text-ink leading-relaxed text-sm sm:text-base font-serif m-0">
      In contrast to non-affirming negation (<em>prasajya-pratiṣedha</em>) applied across all levels
      of truth, Jonang texts define ultimate reality as unconditioned primordial wisdom (<em
        >prabhāsvara-jñāna</em
      > / <GlossaryTerm id="jnana">ye shes</GlossaryTerm>) in the expanse of reality (<GlossaryTerm id="dharmadhatu">Dharmadhātu</GlossaryTerm>), endowed with reflexive awareness (<GlossaryTerm id="rangrik"><em>rang rig</em></GlossaryTerm>) and inseparable enlightened qualities (<em>guṇa</em>). Distinguishing the pure wisdom-ground from the ordinary storehouse consciousness (<GlossaryTerm id="kunzhi"><em>kun gzhi</em> / ālayavijñāna</GlossaryTerm>), Jonang transcends the conceptual limitations of Mind-Only (<GlossaryTerm id="cittamatra">Cittamātra</GlossaryTerm>) by unifying ultimate emptiness with radiant awareness.
    </p>
  </div>

  <!-- Interactive Three Turnings Matrix -->
  <div id="three-turnings" class="flex flex-col gap-6 scroll-mt-[calc(var(--header-h)+4.5rem)]">
    <div class="flex flex-col gap-2.5">
      <div class="flex items-center gap-3">
        <Dharmachakra class="w-6 h-6 sm:w-7 sm:h-7 text-gold shrink-0" />
        <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
          The Three Turnings of the Dharma Wheel
        </h3>
      </div>
      <span
        lang="bo"
        class="font-tibetan text-sm sm:text-base text-accent font-bold block pt-0.5 leading-[1.6]"
      >
        ཆོས་ཀྱི་འཁོར་ལོ་རིམ་པ་གསུམ།
      </span>
      <p class="text-base sm:text-lg text-muted font-serif leading-relaxed m-0 max-w-3xl pt-1">
        The Mahāyāna sūtras are classified across three progressive hermeneutical cycles.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch pt-2">
      {
        threeTurnings.map((t, idx) => (
          <div class="surface-card p-6 sm:p-7 rounded-2xl border border-border border-t-4 border-t-accent hover-lift flex flex-col justify-between h-full bg-surface shadow-xs">
            <div class="flex flex-col gap-4">
              <!-- Top Metadata Header -->
              <div class="flex items-baseline justify-between gap-2 border-b border-border/80 pb-3">
                <span class="px-2.5 py-0.5 rounded bg-accent/10 text-accent font-mono text-xs font-bold uppercase tracking-wider shrink-0">
                  Turning 0{idx + 1}
                </span>
                <span class="text-xs text-muted font-mono text-right leading-tight">
                  {t.location}
                </span>
              </div>

              <!-- Titles & Tibetan Script -->
              <div class="flex flex-col gap-1.5">
                <h4 class="font-display text-xl sm:text-2xl font-bold text-ink leading-snug m-0">
                  {t.theme}
                </h4>
                <span lang="bo" class="text-base sm:text-lg text-accent-secondary font-tibetan font-bold block pt-1 leading-[1.6]">
                  {t.tibetan}
                </span>
              </div>

              <!-- Main Explanation Subtext -->
              <p class="text-base text-ink/80 leading-relaxed font-serif m-0 pt-1">
                {t.view}
              </p>
            </div>

            <!-- Hermeneutical Scope Footer -->
            <div class="pt-4 border-t border-border/80 mt-6">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent block">
                {t.scope}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<!-- Full-Width Featured Multimedia Documentary: Kunkhyen Dolpopa -->
<section
  id="dolpopa-documentary"
  class="w-full bg-gradient-to-b from-surface-subtle/90 via-surface to-surface-subtle/60 py-12 sm:py-16 md:py-20 border-y border-border/80 relative overflow-hidden my-10 sm:my-14 md:my-16 reveal-on-scroll scroll-mt-[calc(var(--header-h)+4.5rem)]"
>
  <!-- Ambient background glow elements -->
  <div
    class="pointer-events-none absolute -top-32 left-1/4 w-[500px] h-[500px] bg-gold/8 blur-3xl rounded-full"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 right-1/4 w-[500px] h-[500px] bg-accent/6 blur-3xl rounded-full"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <VideoFeature
      videoId="PKFl2_WiUd0"
      title="Dölpopa Biography Part 1: Realization & Jomonang"
      tibetanTitle="༄༅། །ཀུན་མཁྱེན་དོལ་པོ་པ་ཤེས་རབ་རྒྱལ་མཚན་གྱི་རྣམ་ཐར། །"
      subtitle="The Life of Kunkhyen Dölpopa & the Codification of Shentong Madhyamaka"
      summary="A biographical documentary produced by Jonang Dharma Volunteers chronicling the life of Kunkhyen Dölpopa Sherab Gyaltsen (1292–1361). From his early training in Dölpo through scholastic mastery at Sakya to his breakthrough realization at Jomonang, this documentary details his formulation of the definitive Shentong view and the consecration of the Great Kumbum."
      badge="Biographical Documentary"
      channelName="Jonang Dharma Volunteers"
      channelUrl="https://www.youtube.com/@JonangDharma"
      duration="Part 1 · Documentary"
      keyThemes={[
        {
          num: "01",
          title: "Himalayan Origins & Sakya Scholasticism",
          desc: "Early training in western Tibet and comprehensive mastery of Buddhist epistemological texts and Prajñāpāramitā.",
        },
        {
          num: "02",
          title: "The Shentong Realization",
          desc: "Unfolding the definitive Third Turning view of Tathāgatagarbha and Kālacakra Six-fold Vajrayoga at Jomonang.",
        },
        {
          num: "03",
          title: "The Great Kumbum of Jomonang",
          desc: "Architectural and spiritual consecration of the monumental multi-tiered stupa (1330–1333), embodying the cosmic mandala.",
        },
      ]}
      actionHref="#shentong-bibliography"
      actionLabel="Dölpopa Treatises in Bibliography"
      id="dolpopa-documentary"
    />
  </div>
</section>

<div class="section-padding max-w-6xl mx-auto flex flex-col gap-12 sm:gap-16">
  <!-- Shentong vs Rangtong Comparative Matrix -->
  <div
    id="comparative-matrix"
    class="surface-card p-6 sm:p-8 md:p-10 flex flex-col gap-6 sm:gap-8 scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <div class="flex flex-col gap-2.5">
      <div class="flex items-center gap-3">
        <Dharmachakra class="w-6 h-6 sm:w-7 sm:h-7 text-gold shrink-0" />
        <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
          Comparative Framework: Rangtong and Shentong
        </h3>
      </div>
      <span
        lang="bo"
        class="font-tibetan text-sm sm:text-base text-accent font-bold block pt-0.5 leading-[1.6]"
      >
        རང་སྟོང་དང་གཞན་སྟོང་གི་ལྟ་བའི་ཁྱད་པར།
      </span>
      <p class="text-base sm:text-lg text-muted leading-relaxed m-0 font-serif max-w-3xl pt-1">
        Jonang treatises synthesize <GlossaryTerm id="prajnaparamita">Prajñāpāramitā</GlossaryTerm> teachings on emptiness with
        the Third Turning <GlossaryTerm id="tathagatagarbha">Tathāgatagarbha</GlossaryTerm> sūtras.
      </p>
    </div>

    <div class="overflow-x-auto rounded-xl border border-border/80">
      <table class="w-full text-left text-sm sm:text-base border-collapse">
        <thead>
          <tr class="border-b border-border bg-surface-subtle">
            <th class="p-3.5 sm:p-4 font-display font-semibold text-ink text-sm sm:text-base"
              >Dimension</th
            >
            <th class="p-3.5 sm:p-4 font-display font-semibold text-accent text-sm sm:text-base"
              >Rangtong</th
            >
            <th
              class="p-3.5 sm:p-4 font-display font-semibold text-accent-secondary text-sm sm:text-base"
              >Shentong</th
            >
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            philosophicalMatrix.map((row) => (
              <tr class="hover:bg-surface-subtle/50 transition-colors">
                <td class="p-3.5 sm:p-4 font-semibold text-ink align-top">
                  <div>{row.category}</div>
                  {row.tibetan && (
                    <span lang="bo" class="font-tibetan text-xs text-muted block pt-1 leading-[1.6]">
                      {row.tibetan}
                    </span>
                  )}
                </td>
                <td class="p-3.5 sm:p-4 text-muted align-top leading-relaxed font-serif">
                  {row.rangtong}
                </td>
                <td class="p-3.5 sm:p-4 text-ink align-top leading-relaxed font-medium bg-accent-secondary-subtle/30 font-serif">
                  {row.shentong}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Lineage Masters Archive (Balanced 3 + 2 Architecture) -->
  <div id="lineage-masters" class="flex flex-col gap-6 sm:gap-8 scroll-mt-[calc(var(--header-h)+4.5rem)]">
    <div class="flex flex-col gap-2.5 pb-2">
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        Lineage Masters and Commentators
      </h3>
      <span
        lang="bo"
        class="font-tibetan text-sm sm:text-base text-accent font-bold block pt-0.5 leading-[1.6]"
      >
        བརྒྱུད་པའི་ཤིང་རྟའི་སྲོལ་འབྱེད་རྣམས་ཀྱི་མཛད་རྣམ།
      </span>
      <p class="text-sm sm:text-base text-muted leading-relaxed font-serif m-0 max-w-3xl pt-1">
        Indian progenitors, translators, and Jonang omniscient masters who realized and codified the unbroken transmission of the Shentong Great Madhyamaka.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 items-stretch">
      {
        masters.map((m, idx) => (
          <div
            class:list={[
              "p-6 rounded-xl bg-surface border border-border flex flex-col justify-between gap-3 shadow-xs hover-lift h-full",
              idx < 3 ? "lg:col-span-2" : "lg:col-span-3",
            ]}
          >
            <div class="flex flex-col gap-2">
              <div class="flex justify-between items-start mb-1">
                <div>
                  <h4 class="font-display text-lg sm:text-xl font-bold text-ink m-0">{m.name}</h4>
                  {m.tibetanName && (
                    <span lang="bo" class="font-tibetan text-sm text-accent font-medium block pt-1 leading-[1.6]">
                      {m.tibetanName}
                    </span>
                  )}
                  <span class="text-xs sm:text-sm font-mono text-accent uppercase tracking-wider block mt-0.5">
                    {m.dates}
                  </span>
                </div>
                <EndlessKnot size={24} class="text-gold/60 shrink-0" />
              </div>
              <p class="text-xs sm:text-sm font-semibold text-accent-secondary uppercase tracking-wide m-0">
                {m.role}
              </p>
              <p class="text-sm text-muted leading-relaxed m-0 font-serif">{m.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Union of Sutra, Tantra & Dialectics -->
  <div
    id="dialectics-integration"
    class="surface-card p-6 sm:p-8 md:p-10 flex flex-col gap-5 border-l-4 border-l-accent scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <div class="flex flex-col gap-2">
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        Integration of Dialectics & Kālacakra Completion Stage
      </h3>
      <span
        lang="bo"
        class="font-tibetan text-sm sm:text-base text-accent font-bold block pt-0.5 leading-[1.6]"
      >
        མཚན་ཉིད་དང་རྫོགས་རིམ་གྱི་ཟུང་འབྲེལ།
      </span>
    </div>
    <p class="text-sm sm:text-base text-muted leading-relaxed m-0 font-serif">
      In the Jonang tradition, scholastic debate and deep yogic contemplation operate in inseparable
      tandem. Textual analysis of the Five Great Treatises and Buddhist epistemological logic (<GlossaryTerm id="pramana">Pramāṇa</GlossaryTerm>) provides the conceptual grounding required for solitary <GlossaryTerm id="mun-khang">dark retreat</GlossaryTerm>.
    </p>
    <p class="text-sm sm:text-base text-ink leading-relaxed m-0 font-serif">
      The Shentong framework provides the direct theoretical matrix for the <GlossaryTerm id="six-branch-yoga">Six-fold Vajrayoga (Sbyor drug)</GlossaryTerm> of the <GlossaryTerm id="kalachakra">Kālacakra Tantra</GlossaryTerm>. Meditative techniques of wind control (<GlossaryTerm id="prana">Prāṇāyāma</GlossaryTerm>) and
      sensory withdrawal (<GlossaryTerm id="six-branch-yoga">Pratyāhāra</GlossaryTerm>) in dark retreat aim directly at stabilizing <GlossaryTerm id="stong-gzugs">empty forms (śūnyatābimba)</GlossaryTerm> and actualizing <GlossaryTerm id="mahasukha">immutable bliss (akṣarasukha)</GlossaryTerm>.
    </p>
  </div>

  <!-- Shentong Reading Shelf & Bibliography -->
  <ShentongBibliography />
</div>
