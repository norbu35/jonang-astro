---
import Dharmachakra from "../icons/Dharmachakra.astro";
import EndlessKnot from "../icons/EndlessKnot.astro";
import ShentongBibliography from "../ShentongBibliography.astro";

const threeTurnings = [
  {
    id: "first",
    turning: "First Turning",
    location: "Deer Park, Sarnath (Varanasi)",
    theme: "Four Noble Truths & Karma",
    tibetan: "བཀའ་དང་པོ་བདེན་བཞིའི་ཆོས་འཁོར།",
    view: "Establishes ethical discipline, causality, impermanence, and the selflessness of individuals (pudgala-nairatmya) to overcome gross afflictive grasping.",
    scope: "Foundational Vehicle (Hinayana / Nikaya)",
  },
  {
    id: "second",
    turning: "Second Turning",
    location: "Vulture Peak, Rajgir",
    theme: "Prajnaparamita & Non-Proliferation (Rangtong)",
    tibetan: "བཀའ་བར་པ་མཚན་ཉིད་མེད་པའི་ཆོས་འཁོར།",
    view: "Demonstrates that all conditioned entities, conceptual constructs, and conventional phenomena lack intrinsic, independent existence (svabhava-sunya).",
    scope: "Provisional Madhyamaka (Nagarjuna / Candrakirti)",
  },
  {
    id: "third",
    turning: "Third Turning",
    location: "Vaishali, Mount Malaya & Shravasti",
    theme: "Tathagatagarbha & Definitive Other-Emptiness (Shentong)",
    tibetan: "བཀའ་ཐ་མ་ལེགས་པར་རྣམ་པར་ཕྱེ་བའི་ཆོས་འཁོར།",
    view: "Elucidates the ultimate reality as non-dual primordial wisdom (jnana), devoid of adventitious obscurations (shentong) yet perpetually complete with inseparable enlightened qualities.",
    scope: "Definitive Great Madhyamaka (Maitreya / Dolpopa)",
  },
];

const philosophicalMatrix = [
  {
    category: "Relative Truth (Kun rzob)",
    rangtong: "Empty of inherent essence (rangtong). Dependently originated, conceptual, and devoid of intrinsic nature.",
    shentong: "Agrees completely: all conventional appearances and defilements are dependently arisen and empty of self-nature.",
  },
  {
    category: "Ultimate Truth (Don dam)",
    rangtong: "Defined strictly as the negation of inherent existence; non-affirming negative (prasajya-pratisedha).",
    shentong: "Definitive reality: luminous Buddha-nature (Tathagatagarbha), empty of foreign defilements but replete with unconditioned qualities.",
  },
  {
    category: "Enlightenment (Bodhi)",
    rangtong: "Cessation of all conceptual fabrications and reification of phenomena.",
    shentong: "The direct experiential recognition and actualization of the primordial enlightened ground that was never absent.",
  },
];

const masters = [
  {
    name: "Maitreya & Asanga",
    dates: "4th Century CE",
    role: "Indian Lineage Progenitors",
    body: "Composed the seminal treatises including the Uttaratantra Shastra (Ratnagotravibhaga) and Mahayanasutralankara, founding the Yogacara-Madhyamaka synthesis of Buddha-nature.",
  },
  {
    name: "Yumo Mikyo Dorje & Dro Lotsawa",
    dates: "11th – 12th Century",
    role: "Tibetan Translators & Early Adepts",
    body: "Translated the Kalachakra Mulatantra and the Vimalaprabha commentary into Tibetan, establishing the unbroken Dro lineage transmission of the Six Yogas.",
  },
  {
    name: "Kunchen Dolpopa Sherab Gyaltsen",
    dates: "1292 – 1361",
    role: "The Omniscient Master of Jomonang",
    body: "Systematized the Shentong Great Madhyamaka in his monumental work 'Mountain Doctrine' (Ri chos nges don rgya mtsho) and constructed the Great Kumbum of Jomonang.",
  },
  {
    name: "Jetsun Taranatha",
    dates: "1575 – 1634",
    role: "Revitalizer & Tantric Polymath",
    body: "Prolific historian, artist, and tantric master who founded Takten Damcho Ling Monastery and composed the definitive practice commentaries for the Kalachakra completion stage.",
  },
  {
    name: "Zanabazar (1st Jebtsundamba Khutuktu)",
    dates: "1635 – 1723",
    role: "1st Bogd Gegeen of Mongolia",
    body: "Recognized as the immediate rebirth of Jetsun Tāranātha by the 5th Dalai Lama, establishing the historical transmission line between Jonang and Mongolian monastic institutions.",
  },
];
---

<div class="space-y-12">
  <!-- Beginner's Orientation Callout Banner -->
  <div class="p-4 sm:p-5 rounded-2xl bg-surface-subtle border border-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-accent text-white flex items-center justify-center text-sm font-bold shrink-0">
        ༄
      </div>
      <div>
        <h4 class="text-sm font-bold text-ink m-0">Introduction to Shentong (Other-Emptiness)</h4>
        <p class="text-xs text-muted m-0">Structured 4-pillar overview covering core doctrinal definitions.</p>
      </div>
    </div>
    <a
      href="/jonang-doctrine/beginners-introduction"
      class="text-xs font-semibold py-2 px-3.5 rounded-lg bg-surface text-accent hover:bg-accent hover:text-white border border-border transition-colors shrink-0 flex items-center gap-1.5 shadow-xs"
    >
      <span>Introductory Guide</span>
      <span>→</span>
    </a>
  </div>

  <!-- Core Philosophical Vision Callout -->
  <div class="surface-card p-6 sm:p-8 md:p-10 space-y-6">
    <div class="badge badge-crimson">
      <span class="badge-dot"></span>
      Madhyamaka View
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight">
      The Shentong (Other-Empty) View of Ultimate Reality
    </h2>

    <p class="lead text-base sm:text-lg text-muted">
      The Jonang tradition articulates the <em>Shentong</em> (Other-Emptiness) Madhyamaka framework: conventional phenomena are empty of self-nature (<em>rangtong</em>), whereas ultimate reality—Buddha-nature (<em>Tathāgatagarbha</em>)—is empty only of adventitious obscurations (<em>āgantukamala</em>).
    </p>

    <p class="text-ink leading-relaxed">
      In contrast to non-affirming negation (<em>prasajya-pratiṣedha</em>) applied across all levels of truth, Jonang texts define ultimate reality as unconditioned primordial wisdom (<em>prabhāsvara-jñāna</em> / <em>ye shes</em>) endowed with inseparable enlightened qualities (<em>guṇa</em>).
    </p>
  </div>

  <!-- Interactive Three Turnings Matrix -->
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <Dharmachakra class="w-7 h-7 text-accent-secondary" />
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        The Three Turnings of the Dharma Wheel
      </h3>
    </div>
    <p class="text-sm text-muted">
      The Mahayana sutras are classified across three hermeneutical cycles:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        threeTurnings.map((t, idx) => (
          <div class="surface-card p-6 flex flex-col justify-between space-y-4 border-t-4 border-t-accent hover-lift relative">
            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-accent">
                  Turn 0{idx + 1}
                </span>
                <span class="text-xs text-muted font-mono">{t.location}</span>
              </div>
              <h4 class="font-display text-lg font-bold text-ink mb-1">{t.theme}</h4>
              <span class="text-xs text-accent-secondary font-tibetan block mb-3">{t.tibetan}</span>
              <p class="text-xs sm:text-sm text-muted leading-relaxed">{t.view}</p>
            </div>
            <div class="pt-3 border-t border-border text-[11px] font-semibold uppercase tracking-wider text-ink/70">
              {t.scope}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Shentong vs Rangtong Comparative Matrix -->
  <div class="surface-card p-6 sm:p-8 space-y-6">
    <div class="badge badge-saffron">
      <span class="badge-dot"></span>
      Doctrinal Distinctions
    </div>

    <h3 class="text-2xl font-display text-ink font-normal">
      Comparative Framework: Rangtong and Shentong
    </h3>

    <p class="text-sm text-muted leading-relaxed">
      Jonang treatises state that Shentong synthesizes Prajñāpāramitā teachings on emptiness with the Third Turning Tathāgatagarbha sutras:
    </p>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <thead>
          <tr class="border-b border-border bg-surface-subtle">
            <th class="p-3.5 font-display font-semibold text-ink">Dimension</th>
            <th class="p-3.5 font-display font-semibold text-accent">Rangtong (Self-Empty)</th>
            <th class="p-3.5 font-display font-semibold text-accent-secondary">Shentong (Other-Empty)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            philosophicalMatrix.map((row) => (
              <tr class="hover:bg-surface-subtle/50 transition-colors">
                <td class="p-3.5 font-semibold text-ink align-top">{row.category}</td>
                <td class="p-3.5 text-muted align-top leading-relaxed">{row.rangtong}</td>
                <td class="p-3.5 text-ink align-top leading-relaxed bg-accent-secondary-subtle/30">{row.shentong}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Lineage Masters Archive -->
  <div class="space-y-6">
    <div class="badge badge-lapis">
      <span class="badge-dot"></span>
      Lineage Succession
    </div>

    <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal">
      Lineage Masters and Commentators
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        masters.map((m) => (
          <div class="p-6 rounded-xl bg-surface border border-border space-y-3 shadow-xs hover-lift">
            <div class="flex justify-between items-start">
              <div>
                <h4 class="font-display text-lg font-bold text-ink">{m.name}</h4>
                <span class="text-xs font-mono text-accent uppercase tracking-wider block">{m.dates}</span>
              </div>
              <EndlessKnot size={24} class="text-gold/60 shrink-0" />
            </div>
            <p class="text-xs font-semibold text-accent-secondary uppercase tracking-wide">{m.role}</p>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">{m.body}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Union of Sutra and Tantra -->
  <div class="surface-card p-6 sm:p-8 space-y-4 border-l-4 border-l-accent">
    <h3 class="text-2xl font-display text-ink">Integration with Kālacakra Completion Stage</h3>
    <p class="text-sm sm:text-base text-muted leading-relaxed">
      The Shentong framework provides the theoretical basis for the Six-fold Vajrayoga (<em>Sbyor drug</em>) of the Kālacakra Tantra. Meditative techniques of wind control (Prāṇāyāma) and sensory withdrawal (Pratyāhāra) in dark retreat aim directly at stabilizing empty forms (<em>śūnyatābimba</em>) and actualizing immutable bliss (<em>akṣarasukha</em>).
    </p>
  </div>

  <!-- Shentong Reading Shelf & Bibliography -->
  <ShentongBibliography />
</div>
