---
import { Image } from "astro:assets";
import yardRitualImg from "../../assets/images/yard-ritual.webp";
---

<section
  id="living-tradition-hero"
  class="relative w-full min-h-[85vh] lg:min-h-screen flex flex-col justify-center overflow-hidden bg-[#240506] text-white pt-[calc(var(--header-h)+2rem)] pb-12 sm:pb-16"
  aria-label="Living Tradition Hero Banner"
>
  <!-- Full-Bleed Ultra-HD Background Photograph -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <Image
      src={yardRitualImg}
      alt="Resident monastic sangha gathered in the courtyard of Main Jonang Takten Phuntsok Choeling, Sanjauli, Shimla"
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      class="w-full h-full object-cover object-[center_35%] transform scale-100 will-change-transform"
      loading="eager"
      decoding="async"
    />
    <!-- Asymmetric left-feathered scrim: softens ONLY the text column on the left, keeping the center and right 100% bright & sunlit -->
    <div class="absolute inset-y-0 left-0 w-full sm:w-3/4 lg:w-3/5 bg-gradient-to-r from-black/80 via-black/40 to-transparent pointer-events-none"></div>
    <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
  </div>

  <!-- Main Hero Content: Asymmetric Left-Anchored Editorial Layout -->
  <div class="relative z-10 max-w-7xl mx-auto w-full px-5 sm:px-8 lg:px-12 my-auto flex flex-col items-start text-left">
    <div class="max-w-xl lg:max-w-2xl flex flex-col gap-4 sm:gap-5">
      <!-- Consecrated Tibetan Calligraphy Headline -->
      <div
        lang="bo"
        class="font-tibetan text-2xl sm:text-3xl lg:text-4xl text-gold font-bold leading-relaxed whitespace-normal sm:whitespace-nowrap drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]"
      >
        ༄༅། །ཇོ་ནང་དགོན་པའི་ཉིན་རེའི་འཚོ་བ་དང་སྲོལ་རྒྱུན། །
      </div>

      <!-- Monumental Display Title -->
      <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-normal text-white tracking-tight leading-[1.08] drop-shadow-[0_4px_16px_rgba(0,0,0,0.95)] m-0">
        The Living Tradition
      </h1>

      <!-- Evocative Narrative Lede -->
      <p class="font-serif text-base sm:text-lg lg:text-xl text-white/95 max-w-xl leading-relaxed drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)] m-0">
        From pre-dawn slit-gongs and bubbling cauldrons of butter tea to kinetic courtyard debate and mountain arboriculture—experience the daily rhythm and human warmth of the Jonang sangha on the cedar ridges of the Himalayas.
      </p>
    </div>
  </div>
</section>
