---
import { STATIC_PAGE_PATHS } from "../../data/staticPages";

const keyPillars = [
  {
    title: "Emptiness & Buddha-Nature",
    description:
      "Every sentient being is endowed with primordial Buddha-nature (Tathagatagarbha). The Jonang view clarifies that enlightenment is not a fabricated mental state, but the intrinsic, luminous nature of awareness revealed when adventitious stains are cleared.",
  },
  {
    title: "The Kalachakra Six Yogas (Jordruk)",
    description:
      "Jonang holds the unbroken completion-stage transmission of the Kalachakra Tantra. The six-fold yogic system provides systematic methods for channeling subtle energies (prana, bindu) into direct realization.",
  },
  {
    title: "The Shentong Philosophical View",
    description:
      "Systematized by Kunchen Dolpopa Sherab Gyaltsen in the 14th century, the Shentong (Other-Empty) view resolves the relationship between emptiness and luminous awareness across the Mahayana sutras and tantras.",
  },
  {
    title: "Unified Dialectics & Contemplation",
    description:
      "Intellectual debate and silent meditation are practiced as mutually reinforcing pillars. Scholastic mastery of epistemology and treatises directly prepares the mind for long-term solitary retreat.",
  },
];

const exploratoryPaths = [
  {
    href: STATIC_PAGE_PATHS.aboutUs,
    title: "The Monastery & Community",
    body: "Learn about the living community in Shimla, its resident abbots, Himalayan students, and day-to-day life.",
  },
  {
    href: STATIC_PAGE_PATHS.jonangDoctrine,
    title: "The Shentong Doctrine",
    body: "Explore the Three Turnings of the Dharma Wheel and the definitive Other-Emptiness philosophy.",
  },
  {
    href: STATIC_PAGE_PATHS.kalachakra,
    title: "Kalachakra Practice Path",
    body: "Read the sequential outline of foundational preliminaries, dark retreats, and Six-fold Vajrayoga.",
  },
  {
    href: STATIC_PAGE_PATHS.curriculum,
    title: "18-Year Monastic Syllabus",
    body: "Discover how classical treatises, Tibetan languages, ritual arts, and modern sciences are integrated.",
  },
];
---

<div class="space-y-12">
  <!-- Introductory Lead -->
  <div class="surface-card p-6 sm:p-8 md:p-10 space-y-6">
    <div class="badge badge-crimson">
      <span class="badge-dot"></span>
      Orientation
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight">
      Foundational Pillars of the Jonang Tradition
    </h2>

    <p class="lead text-base sm:text-lg text-muted">
      The Jonang tradition is an ancient school of Tibetan Buddhism celebrated for its definitive philosophy of Other-Emptiness (<em>Shentong</em>) and its unbroken practice lineage of the Kalachakra Tantra completion stage.
    </p>

    <p class="text-ink">
      Whether you are exploring Tibetan Buddhism for the first time or deepening your understanding of Madhyamaka philosophy, the Jonang path offers a complete, integrated system combining rigorous scriptural study, dialectical logic, and profound meditative training.
    </p>
  </div>

  <!-- Four Pillars Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      keyPillars.map((p, idx) => (
        <div class="surface-card p-6 space-y-3 border-l-4 border-l-accent">
          <div class="badge badge-neutral text-xs">Pillar 0{idx + 1}</div>
          <h3 class="text-xl font-display text-ink font-normal">{p.title}</h3>
          <p class="text-sm text-muted leading-relaxed">{p.description}</p>
        </div>
      ))
    }
  </div>

  <!-- Navigation Pathways -->
  <div class="surface-card p-6 sm:p-8 md:p-10 space-y-6">
    <div class="badge badge-saffron">
      <span class="badge-dot"></span>
      Recommended Exploration
    </div>

    <h3 class="text-2xl font-display text-ink font-normal">
      Explore Further
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        exploratoryPaths.map((path) => (
          <a
            href={path.href}
            class="p-5 rounded-xl bg-surface-subtle border border-border hover:border-accent group transition-all block"
          >
            <h4 class="font-display text-lg text-ink group-hover:text-accent font-normal mb-1 transition-colors">
              {path.title} →
            </h4>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">{path.body}</p>
          </a>
        ))
      }
    </div>
  </div>
</div>
