---
import { STATIC_PAGE_PATHS } from "../../data/staticPages";

const keyPillars = [
  {
    title: "Buddha-Nature (Tathāgatagarbha)",
    description:
      "Sentient beings possess primordial Buddha-nature (Tathāgatagarbha). The Jonang tradition teaches that awakening is not an engineered construct, but unconditioned luminous awareness (ye shes) revealed upon the purification of adventitious stains (āgantukamala).",
  },
  {
    title: "Kālacakra Six-fold Vajrayoga (Sbyor drug)",
    description:
      "Jonang preserves the complete Dro lineage completion stage of the Kālacakra Tantra. The six-stage yogic system provides concrete physical and meditative instructions for drawing winds and drops into the central channel (avadhūtī).",
  },
  {
    title: "Shentong Madhyamaka",
    description:
      "Codified by Kunkhyen Dolpopa Sherab Gyaltsen in the 14th century, Shentong (Other-Emptiness) distinguishes between conventional phenomena empty of self-nature (Rangtong) and ultimate reality empty only of adventitious obscurations (Shentong).",
  },
  {
    title: "Integration of Dialectics & Retreat",
    description:
      "Debate and contemplation operate in tandem. Textual analysis of the Five Great Treatises and Pramāṇa logic provides the conceptual grounding required for multi-year dark retreat.",
  },
];

const exploratoryPaths = [
  {
    href: STATIC_PAGE_PATHS.aboutUs,
    title: "Monastery & Community",
    body: "History in Shimla, succession of abbots, Himalayan student body, and liturgical calendar.",
  },
  {
    href: STATIC_PAGE_PATHS.jonangDoctrine,
    title: "Shentong Doctrine",
    body: "The Three Turnings of the Dharma Wheel, scriptural citations, and the Rangtong-Shentong distinction.",
  },
  {
    href: STATIC_PAGE_PATHS.kalachakra,
    title: "Kālacakra Tantra",
    body: "Sequential outline of preliminary practices, three isolations dark retreat, and the Six-fold Vajrayoga.",
  },
  {
    href: STATIC_PAGE_PATHS.curriculum,
    title: "18-Year Monastic Syllabus",
    body: "Structure of classical treatises, Tibetan grammar, Pramāṇa epistemology, and liturgical arts.",
  },
];
---

<div class="space-y-12">
  <!-- Introductory Lead -->
  <div class="surface-card p-6 sm:p-8 md:p-10 space-y-6">
    <div class="badge badge-crimson">
      <span class="badge-dot"></span>
      Introduction
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight">
      Foundational Pillars of the Jonang Tradition
    </h2>

    <p class="lead text-base sm:text-lg text-muted">
      The Jonang school of Tibetan Buddhism is defined by its philosophical framework of Other-Emptiness (<em>Shentong</em>) and its transmission lineage of the Kālacakra completion stage.
    </p>

    <p class="text-ink leading-relaxed">
      The school integrates Indian canonical treatises, Tibetan Pramāṇa dialectics, and contemplative practices centered on the Six-fold Vajrayoga (<em>Ṣaḍaṅgayoga</em>).
    </p>
  </div>

  <!-- Four Pillars Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      keyPillars.map((p, idx) => (
        <div class="surface-card p-6 space-y-3 border-l-4 border-l-accent">
          <div class="badge badge-neutral text-xs">Pillar 0{idx + 1}</div>
          <h3 class="text-xl font-display text-ink font-normal">{p.title}</h3>
          <p class="text-sm text-muted leading-relaxed">{p.description}</p>
        </div>
      ))
    }
  </div>

  <!-- Navigation Pathways -->
  <div class="surface-card p-6 sm:p-8 md:p-10 space-y-6">
    <div class="badge badge-saffron">
      <span class="badge-dot"></span>
      Curricular Links
    </div>

    <h3 class="text-2xl font-display text-ink font-normal">
      Detailed Documentation
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        exploratoryPaths.map((path) => (
          <a
            href={path.href}
            class="p-5 rounded-xl bg-surface-subtle border border-border hover:border-accent group transition-all block"
          >
            <h4 class="font-display text-lg text-ink group-hover:text-accent font-normal mb-1 transition-colors">
              {path.title} →
            </h4>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">{path.body}</p>
          </a>
        ))
      }
    </div>
  </div>
</div>
