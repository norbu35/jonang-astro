---
const treatises = [
  { name: "Pramana", subject: "Valid Cognition & Epistemology", author: "Dignaga & Dharmakirti" },
  { name: "Prajnaparamita", subject: "Perfection of Wisdom & Bodhisattva Paths", author: "Maitreya / Asanga" },
  { name: "Madhyamaka", subject: "Middle Way & Definitive Shentong View", author: "Nagarjuna / Dolpopa" },
  { name: "Abhidharma", subject: "Phenomenology, Mind Factors & Cosmology", author: "Vasubandhu" },
  { name: "Vinaya", subject: "Monastic Ethics, Discipline & Vows", author: "Gunaprabha" },
];

const ritualArts = [
  { name: "Liturgical Chanting (dbyangs)", desc: "Mastering deep, resonant tonal cadences of the ancient Jonang melodic lineage." },
  { name: "Monastic Instrumentation", desc: "Training in long horn (dungchen), oboe (gyaling), frame drum (nga), and cymbals (silnyen/rolmo)." },
  { name: "Sand Mandala Drafting", desc: "Complex geometric measurements and mineral sand placement for the Kalachakra mandala." },
  { name: "Sacred Cham Choreography", desc: "Ritual religious dance performed during major prayer festivals and annual assemblies." },
];
---

<div class="space-y-12">
  <!-- Introductory Lead -->
  <div class="surface-card p-6 sm:p-8 md:p-10 space-y-6">
    <div class="badge badge-crimson">
      <span class="badge-dot"></span>
      18-Year Curriculum
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight">
      Scholastic Treatises, Ritual Arts & Meditative Retreat
    </h2>

    <p class="lead text-base sm:text-lg text-muted">
      The monastic curriculum at Main Jonang Takten Phuntsok Choeling integrates classical Buddhist scholasticism, tantric ritual arts, and foundational modern education across an eighteen-year progressive syllabus.
    </p>
  </div>

  <!-- 1. The Five Great Treatises -->
  <div class="space-y-6">
    <div class="badge badge-saffron">
      <span class="badge-dot"></span>
      Scholastic Core
    </div>

    <h3 class="text-2xl font-display text-ink">
      The Five Great Treatises (<em>Gzhung Chen Bka' Pod Lnga</em>)
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {
        treatises.map((t) => (
          <div class="surface-card p-5 space-y-2 border-t-4 border-t-accent">
            <h4 class="font-display text-lg font-bold text-ink">{t.name}</h4>
            <p class="text-xs font-semibold text-accent uppercase tracking-wider">{t.subject}</p>
            <p class="text-xs text-muted">Root Masters: {t.author}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- 2. Ritual Arts & Disciplines -->
  <div class="surface-card p-6 sm:p-8 space-y-6">
    <div class="badge badge-lapis">
      <span class="badge-dot"></span>
      Liturgical Disciplines
    </div>

    <h3 class="text-2xl font-display text-ink font-normal">
      Ritual Arts, Calligraphy & Sacred Music
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        ritualArts.map((art) => (
          <div class="p-4 rounded-xl bg-surface-subtle border border-border space-y-1">
            <h4 class="font-display text-base font-bold text-ink">{art.name}</h4>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">{art.desc}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- 3. Meditative Retreat Track -->
  <div class="surface-card p-6 sm:p-8 space-y-4">
    <h3 class="text-2xl font-display text-ink">Intensive 3.5-Year Solitary Retreat</h3>
    <p class="text-sm sm:text-base text-muted leading-relaxed">
      Senior monks who have completed the requisite scholastic foundations enter the dedicated retreat center for a minimum <strong>three-and-a-half-year retreat</strong>. This intensive period is dedicated entirely to Generation Stage deity yoga, the Three Isolations dark retreat, and the completion-stage <strong>Six Yogas of the Kalachakra Tantra</strong> under the daily direction of the retreat master.
    </p>
  </div>

  <!-- 4. Community Demographics -->
  <div class="surface-card p-6 sm:p-8 space-y-4 border-l-4 border-l-accent-secondary">
    <div class="badge badge-neutral mb-2">Resident Sangha</div>
    <h3 class="text-2xl font-display text-ink">Student Demographics & Care</h3>
    <p class="text-sm sm:text-base text-muted leading-relaxed">
      The monastery accommodates approximately <strong>120 resident students and staff members</strong>:
    </p>
    <ul class="text-xs sm:text-sm text-muted space-y-2 list-none p-0">
      <li class="p-3 rounded-lg bg-surface-subtle border border-border">
        <strong>Assam & Mon Tawang (~70 students):</strong> Monks from remote Himalayan border regions where transportation and educational access are limited.
      </li>
      <li class="p-3 rounded-lg bg-surface-subtle border border-border">
        <strong>Outer Mongolia (~30 students):</strong> Monks with historical ties to the Jonang lineage of Jetsun Taranatha, including 12 young orphans aged 6–18 supported under full monastic care.
      </li>
      <li class="p-3 rounded-lg bg-surface-subtle border border-border">
        <strong>Tibet (~20 monks):</strong> Monks from Tibet who have arrived to study classical Jonang philosophy and practice freely in exile.
      </li>
    </ul>
  </div>
</div>
