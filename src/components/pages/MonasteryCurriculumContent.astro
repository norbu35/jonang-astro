---
import Dharmachakra from "../icons/Dharmachakra.astro";
import GlossaryTerm from "../ui/GlossaryTerm.astro";
import { STATIC_PAGE_PATHS } from "../../data/staticPages";

const syllabusStages = [
  {
    stage: "Stage 01",
    years: "Years 1 – 4",
    title: "Foundational Languages & Memorization",
    tibetan: "གཞི་རིམ་བསླབ་གཞི།",
    curriculum:
      "Tibetan orthography (Uchen/Umey calligraphy), classical Tibetan grammar (Sum rtags), ritual memorization, conversational English, Hindi, and basic arithmetic.",
    focus: "Literacy & Memorization",
  },
  {
    stage: "Stage 02",
    years: "Years 5 – 8",
    title: "Epistemology, Logic & Dialectics",
    tibetan: "ཚད་མ་དང་བསྡུས་གྲྭ།",
    curriculum:
      "Collected Topics (Bsdus grwa), Mind & Awareness (Blo rig), Signs & Reasoning (Takrig / Rtags rigs), and Buddhist Epistemology (Pramāṇa) through rigorous daily debating assemblies.",
    focus: "Debate & Dialectics",
  },
  {
    stage: "Stage 03",
    years: "Years 9 – 14",
    title: "The Five Great Treatises & Shentong",
    tibetan: "གཞུང་ཆེན་བཀའ་པོད་ལྔ།",
    curriculum:
      "Mastery of Prajñāpāramitā, Madhyamaka, Abhidharma, and Vinaya, alongside Kunkhyen Dölpopa’s Mountain Doctrine and definitive Shentong commentaries.",
    focus: "Scholastic Philosophy",
  },
  {
    stage: "Stage 04",
    years: "Years 15 – 18",
    title: "Ritual Arts, Music & Completion Retreat",
    tibetan: "དཀྱིལ་ཆོག་དང་སྒྲུབ་པ།",
    curriculum:
      "Sand mandala drafting, ritual instruments (dungchen, gyaling, nga, rolmo), chām mask dance, and the 3.5-year Kālacakra completion retreat.",
    focus: "Tantra & Realization",
  },
];

const sutraFoundations = [
  {
    sno: "1",
    name: "Dudra (Collected Topics)",
    tibetan: "བསྡུས་གྲྭ།",
    duration: "2 Years",
    mainText: "Bamda Gelek Gyatso’s Dudra",
    partText: "Yongzin Rinpoche’s Text",
    desc: "Foundational logic, definitions, classifications of phenomena, and formal Tibetan debating methodology.",
  },
  {
    sno: "2",
    name: "Takrig (Signs & Reasoning)",
    tibetan: "རྟགས་རིགས།",
    duration: "1 Year",
    mainText: "Tsoknyi Gyamtso’s Takrig",
    partText: "Yongzin Rinpoche’s Text",
    desc: "Classification of logical proofs, valid reasons, correct relationships, and fallacious arguments.",
  },
  {
    sno: "3",
    name: "Lorig (Mind & Awareness)",
    tibetan: "བློ་རིག",
    duration: "1 Year",
    mainText: "Bamda Gelek Gyatso’s Lorig",
    partText: "Yongzin Rinpoche’s Text",
    desc: "Epistemological study of consciousness, direct perception, inferential cognition, doubt, and cognitive errors.",
  },
];

const fiveTreatises = [
  {
    title: "Pramāṇa (Epistemology & Logic)",
    tibetan: "ཚད་མ།",
    text: "Dharmakīrti’s Pramāṇavārttika (Commentary on Valid Cognition)",
    desc: "Rigorous training in valid cognition, formal syllogisms, logic, and perception to refute fallacies and establish rational discernment.",
  },
  {
    title: "Prajñāpāramitā (Perfection of Wisdom)",
    tibetan: "ཕར་ཕྱིན།",
    text: "Maitreya’s Abhisamayālaṅkāra (Ornament of Realization)",
    desc: "Detailed mapping of the bodhisattva grounds (bhūmis), spiritual paths (mārgas), and realizations leading to omniscience.",
  },
  {
    title: "Madhyamaka (The Middle Way)",
    tibetan: "དབུ་མ།",
    text: "Candrakīrti’s Madhyamakāvatāra & Dölpopa’s Mountain Doctrine",
    desc: "Deconstructs all extremes of eternalism and nihilism, presenting the definitive union of freedom from fabrications and primordial luminous awareness.",
  },
  {
    title: "Abhidharma (Cosmology & Psychology)",
    tibetan: "མངོན་པ།",
    text: "Vasubandhu’s Abhidharmakośa (Treasury of Higher Knowledge)",
    desc: "Systematic analysis of mental factors, consciousness, karma, cosmology, and the mechanics of samsaric rebirth.",
  },
  {
    title: "Vinaya (Monastic Ethics & Discipline)",
    tibetan: "འདུལ་བ།",
    text: "Guṇaprabha’s Vinayasūtra (Root Discipline)",
    desc: "Detailed study of individual liberation vows (Prātimokṣa), monastic jurisprudence, and community ethical integrity.",
  },
];

const ritualArts = [
  {
    name: "Liturgical Instruments",
    tibetan: "རོལ་མོ་དང་དུང་རྒྱ།",
    items:
      "Dungchen (long horns), Gyaling (reed oboes), Nga (ceremonial frame drums), and Rolmo / Silnyen (cymbals).",
  },
  {
    name: "Sand Mandala Construction",
    tibetan: "རྡུལ་ཚོན་དཀྱིལ་འཁོར།",
    items:
      "Geometrical drafting and mineral sand placement for the Kālacakra and associated mandalas.",
  },
  {
    name: "Chām Mask Dance",
    tibetan: "འཆམ་གར།",
    items:
      "Ritual dances representing protective deities and lineage masters, coordinated with drum notation.",
  },
  {
    name: "Butter Sculptures (Torma)",
    tibetan: "གཏོར་མ་བཅའ་བཟོ།",
    items: "Symbolic ritual offerings sculpted from roasted barley flour and colored butter.",
  },
];
---

<div class="space-y-12 sm:space-y-16">
  <!-- Educational Mission Header -->
  <div
    id="curriculum-overview"
    class="surface-card p-6 sm:p-8 md:p-10 space-y-6 scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <div class="space-y-2">
      <h2
        class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight m-0"
      >
        The 18-Year Progressive Monastic Curriculum
      </h2>
      <span
        lang="bo"
        class="text-lg sm:text-xl font-tibetan text-accent-secondary font-bold block pt-1 leading-[1.6]"
      >
        ལོ་ངོ་བཅོ་བརྒྱད་ཀྱི་དགོན་པའི་སློབ་ཚན་རིམ་པ།
      </span>
    </div>

    <p class="lead text-base sm:text-lg text-muted font-serif leading-relaxed m-0">
      Main Jonang Takten Phuntsok Choeling conducts an 18-year curriculum integrating Tibetan
      classical grammar, Buddhist epistemology (<GlossaryTerm id="pramana">Pramāṇa</GlossaryTerm>), the Five Great Treatises, ritual arts, and
      multi-year <GlossaryTerm id="kalachakra">Kālacakra</GlossaryTerm> retreat.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <div class="p-4 rounded-xl bg-surface-subtle border border-border text-center space-y-1">
        <span class="text-xs font-semibold text-accent uppercase block font-mono">Duration</span>
        <span class="text-2xl font-display font-bold text-ink block">18 Years</span>
        <span class="text-xs text-muted block font-serif">Primary through Acharya</span>
      </div>
      <div class="p-4 rounded-xl bg-surface-subtle border border-border text-center space-y-1">
        <span class="text-xs font-semibold text-accent-secondary uppercase block font-mono"
          >Sangha Body</span
        >
        <span class="text-2xl font-display font-bold text-ink block">~120 Monks</span>
        <span class="text-xs text-muted block font-serif">100% Tuition-Free Support</span>
      </div>
      <div class="p-4 rounded-xl bg-surface-subtle border border-border text-center space-y-1">
        <span class="text-xs font-semibold text-accent-tertiary uppercase block font-mono"
          >Culmination</span
        >
        <span class="text-2xl font-display font-bold text-ink block">3.5 Years</span>
        <span class="text-xs text-muted block font-serif">Solitary Kālacakra Retreat</span>
      </div>
    </div>
  </div>

  <!-- Interactive 18-Year Roadmap Timeline -->
  <div id="four-epochs" class="space-y-6 scroll-mt-[calc(var(--header-h)+4.5rem)]">
    <div class="flex items-center gap-3">
      <Dharmachakra class="w-7 h-7 text-accent-secondary" />
      <div>
        <h3 class="text-2xl sm:text-3xl font-display text-ink m-0">The Four Academic Epochs</h3>
        <span
          lang="bo"
          class="text-sm sm:text-base font-tibetan text-accent-secondary font-bold block pt-1 leading-[1.6]"
        >
          བསླབ་གཞི་དུས་མཚམས་རིམ་པ་བཞི།
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {
        syllabusStages.map((s) => (
          <div class="surface-card p-6 flex flex-col justify-between gap-4 border-t-4 border-t-accent hover-lift h-full">
            <div class="flex flex-col gap-2">
              <div class="flex justify-between items-center text-xs font-mono text-muted mb-1">
                <span class="font-bold text-accent">{s.stage}</span>
                <span class="text-accent-secondary font-semibold font-mono">{s.years}</span>
              </div>
              <h4 class="font-display text-lg sm:text-xl font-bold text-ink leading-snug m-0">
                {s.title}
              </h4>
              <span
                lang="bo"
                class="text-sm sm:text-base font-tibetan text-accent-secondary font-bold block pt-1 leading-[1.6]"
              >
                {s.tibetan}
              </span>
              <p class="text-sm text-muted leading-relaxed m-0 font-serif pt-1">{s.curriculum}</p>
            </div>
            <div class="pt-3 border-t border-border text-xs sm:text-sm font-semibold uppercase tracking-wider text-accent font-mono">
              {s.focus}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Foundational Sutra & Dialectics Syllabus (Studying Sutra Part) -->
  <div
    id="sutra-epistemology"
    class="surface-card p-6 sm:p-8 space-y-6 border-l-4 border-l-accent scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <div>
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        Foundational Sūtra Epistemology: Logic, Mind & Dialectics
      </h3>
      <span
        lang="bo"
        class="text-sm sm:text-base font-tibetan text-accent-secondary font-bold block pt-1 leading-[1.6]"
      >
        བསྡུས་གྲྭ་དང་ཚད་མའི་གཞུང་ལུགས།
      </span>
    </div>

    <p class="text-sm sm:text-base text-muted leading-relaxed m-0 font-serif">
      Prior to undertaking the Five Great Treatises, students complete a four-year
      foundational sequence in logic, cognitive definitions, and debate methodology
      anchored in the canonical textbooks of <GlossaryTerm id="bamda-gelek">Bamda Gelek Gyatso</GlossaryTerm>.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2 items-stretch">
      {
        sutraFoundations.map((item) => (
          <div class="p-5 rounded-xl bg-surface-subtle border border-border flex flex-col justify-between gap-3 hover-lift h-full">
            <div class="flex flex-col gap-2">
              <div class="flex justify-between items-center text-xs font-mono text-muted mb-1">
                <span class="font-bold text-accent">Stage {item.sno}</span>
                <span class="text-accent-secondary font-semibold font-mono">{item.duration}</span>
              </div>
              <h4 class="font-display text-lg sm:text-xl font-bold text-ink m-0">{item.name}</h4>
              <span
                lang="bo"
                class="text-sm sm:text-base font-tibetan text-accent-secondary font-bold block pt-1 leading-[1.6]"
              >
                {item.tibetan}
              </span>

              <div class="flex flex-col gap-1.5 text-xs pt-1">
                <div class="p-2.5 rounded-lg bg-surface border border-border">
                  <span class="text-caption-xs uppercase font-bold text-accent block font-mono">
                    Main Text:
                  </span>
                  <span class="font-medium text-ink font-serif text-sm">{item.mainText}</span>
                </div>
                <div class="p-2.5 rounded-lg bg-surface border border-border">
                  <span class="text-caption-xs uppercase font-bold text-muted block font-mono">
                    Supplementary Text:
                  </span>
                  <span class="text-muted font-serif text-sm">{item.partText}</span>
                </div>
              </div>

              <p class="text-sm text-muted leading-relaxed m-0 font-serif pt-1">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- The Five Great Treatises (Balanced 3 + 2 Architecture) -->
  <div
    id="five-treatises"
    class="surface-card p-6 sm:p-8 space-y-6 scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <div>
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        The Five Great Treatises (<em>Gzhung Chen Bka' Pod Lnga</em>)
      </h3>
      <span
        lang="bo"
        class="text-sm sm:text-base font-tibetan text-accent-secondary font-bold block pt-1 leading-[1.6]"
      >
        གཞུང་ཆེན་བཀའ་པོད་ལྔ།
      </span>
    </div>

    <p class="text-sm sm:text-base text-muted leading-relaxed m-0 font-serif">
      The scholastic core of the <GlossaryTerm id="shedra">shedra</GlossaryTerm> curriculum comprises comprehensive study of the canonical Indian root treatises and Jonang commentaries across five disciplines: <GlossaryTerm id="pramana">epistemology (Pramāṇa)</GlossaryTerm>, <GlossaryTerm id="prajnaparamita">Perfection of Wisdom (Prajñāpāramitā)</GlossaryTerm>, <GlossaryTerm id="madhyamaka">the Middle Way (Madhyamaka)</GlossaryTerm>, <GlossaryTerm id="abhidharma">phenomenology (Abhidharma)</GlossaryTerm>, and <GlossaryTerm id="vinaya">monastic discipline (Vinaya)</GlossaryTerm>, studied through traditional loose-leaf <GlossaryTerm id="pecha">pecha</GlossaryTerm> folios.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 items-stretch">
      {
        fiveTreatises.map((t, idx) => (
          <div
            class:list={[
              "p-5 rounded-xl bg-surface-subtle border border-border flex flex-col justify-between gap-2 shadow-xs hover-lift h-full",
              idx < 3 ? "lg:col-span-2" : "lg:col-span-3",
            ]}
          >
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-start gap-2 mb-1">
                <h4 class="font-display text-base sm:text-lg font-bold text-ink m-0">{t.title}</h4>
                <span
                  lang="bo"
                  class="text-sm sm:text-base font-tibetan text-accent-secondary font-bold shrink-0 pt-0.5 leading-[1.6]"
                >
                  {t.tibetan}
                </span>
              </div>
              <p class="text-xs sm:text-sm font-semibold text-accent m-0 font-serif">{t.text}</p>
              <p class="text-sm text-muted leading-relaxed m-0 font-serif pt-1">{t.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Liturgical Arts & Instruments -->
  <div id="ritual-arts" class="space-y-6 scroll-mt-[calc(var(--header-h)+4.5rem)]">
    <div>
      <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal m-0">
        Liturgical Arts and Ritual Music
      </h3>
      <span
        lang="bo"
        class="text-sm sm:text-base font-tibetan text-accent font-bold block pt-1 leading-[1.6]"
      >
        ཆོ་ག་ཕྱག་ལེན་དང་རོལ་མོའི་རིག་གནས།
      </span>
    </div>

    <p class="text-sm sm:text-base text-muted leading-relaxed m-0 font-serif">
      Complementing philosophical debate, monks master sacred tantric arts including ritual dance (<GlossaryTerm id="cham"><em>chām</em></GlossaryTerm>), ritual offerings (<GlossaryTerm id="torma"><em>torma</em></GlossaryTerm>), and colored powder sand mandalas (<GlossaryTerm id="dul-tshon"><em>rdul tshon</em></GlossaryTerm>).
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {
        ritualArts.map((art) => (
          <div class="p-6 rounded-xl bg-surface border border-border flex flex-col justify-between gap-2 shadow-xs hover-lift h-full">
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-center mb-1">
                <h4 class="font-display text-base sm:text-lg font-bold text-ink m-0">{art.name}</h4>
              </div>
              <span
                lang="bo"
                class="text-sm sm:text-base font-tibetan text-accent font-bold block pt-1 leading-[1.6]"
              >
                {art.tibetan}
              </span>
              <p class="text-sm text-muted leading-relaxed m-0 font-serif pt-1">{art.items}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Meditative Retreat Track -->
  <div
    id="completion-retreat"
    class="surface-card p-6 sm:p-8 space-y-4 border-l-4 border-l-accent-secondary scroll-mt-[calc(var(--header-h)+4.5rem)]"
  >
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-2xl sm:text-3xl font-display text-ink m-0">3.5-Year Kālacakra Retreat</h3>
        <span
          lang="bo"
          class="text-base sm:text-lg font-tibetan text-accent-secondary font-bold block pt-1 leading-[1.6]"
        >
          དུས་འཁོར་ལོ་ལོ་གསུམ་ཕྱོགས་གསུམ་གྱི་སྒྲུབ་པ།
        </span>
      </div>
      <a
        href={STATIC_PAGE_PATHS.kalachakra}
        class="inline-flex items-center gap-2 self-start px-4 py-2 rounded-lg bg-surface-subtle hover:bg-accent/10 text-accent font-mono text-xs font-semibold uppercase tracking-wider border border-border transition-colors min-h-[36px]"
      >
        <span>Kālacakra Tantra Overview</span>
        <span>→</span>
      </a>
    </div>
    <p class="text-sm sm:text-base text-muted leading-relaxed m-0 font-serif">
      Monks who complete the dialectical syllabus qualify to enter the retreat facility (<GlossaryTerm id="drupdra"><em>sgrub grwa</em></GlossaryTerm>) for a
      three-and-a-half-year cycle. Practice centers on <GlossaryTerm id="kyerim">Generation Stage</GlossaryTerm> deity yoga, Three Isolations
      <GlossaryTerm id="mun-khang">dark retreat</GlossaryTerm>, and the completion-stage <strong><GlossaryTerm id="six-branch-yoga">Six-fold Vajrayoga (Sbyor drug)</GlossaryTerm></strong> under the
      direct supervision of the retreat master.
    </p>
  </div>
</div>
