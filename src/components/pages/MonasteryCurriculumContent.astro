---
import Dharmachakra from "../icons/Dharmachakra.astro";

const syllabusStages = [
  {
    stage: "Stage 01",
    years: "Years 1 – 4",
    title: "Foundational Languages & Memorization",
    tibetan: "གཞི་རིམ་བསླབ་གཞི།",
    curriculum: "Tibetan orthography (Uchen/Umey calligraphy), classical Tibetan grammar (Sum rtags), ritual memorization, conversational English, Hindi, and basic arithmetic.",
    focus: "Literacy & Memorization",
  },
  {
    stage: "Stage 02",
    years: "Years 5 – 8",
    title: "Epistemology, Logic & Dialectics",
    tibetan: "ཚད་མ་དང་བསྡུས་གྲྭ།",
    curriculum: "Collected Topics (Bsdus grwa), Mind & Awareness (Blo rig), Signs & Reasoning (Takrig / Rtags rigs), and Buddhist Epistemology (Pramāṇa) through rigorous daily debating assemblies.",
    focus: "Debate & Dialectics",
  },
  {
    stage: "Stage 03",
    years: "Years 9 – 14",
    title: "The Five Great Treatises & Shentong",
    tibetan: "གཞུང་ཆེན་བཀའ་པོད་ལྔ།",
    curriculum: "Mastery of Prajñāpāramitā, Madhyamaka, Abhidharma, and Vinaya, alongside Kunkhyen Dolpopa’s Mountain Doctrine and definitive Shentong commentaries.",
    focus: "Scholastic Philosophy",
  },
  {
    stage: "Stage 04",
    years: "Years 15 – 18",
    title: "Ritual Arts, Music & Completion Retreat",
    tibetan: "དཀྱིལ་ཆོག་དང་སྒྲུབ་པ།",
    curriculum: "Sand mandala drafting, ritual instruments (dungchen, gyaling, nga, rolmo), chām mask dance, and the 3.5-year Kālacakra completion retreat.",
    focus: "Tantra & Realization",
  },
];

const sutraFoundations = [
  {
    sno: "1",
    name: "Dudra (Collected Topics)",
    tibetan: "བསྡུས་གྲྭ།",
    duration: "2 Years",
    mainText: "Bamda Gelek Gyatso’s Dudra",
    partText: "Yongzin Rinpoche’s Text",
    desc: "Foundational logic, definitions, classifications of phenomena, and formal Tibetan debating methodology.",
  },
  {
    sno: "2",
    name: "Takrig (Signs & Reasoning)",
    tibetan: "རྟགས་རིགས།",
    duration: "1 Year",
    mainText: "Tsoknyi Gyamtso’s Takrig",
    partText: "Yongzin Rinpoche’s Text",
    desc: "Classification of logical proofs, valid reasons, correct relationships, and fallacious arguments.",
  },
  {
    sno: "3",
    name: "Lorig (Mind & Awareness)",
    tibetan: "བློ་རིག",
    duration: "1 Year",
    mainText: "Bamda Gelek Gyatso’s Lorig",
    partText: "Yongzin Rinpoche’s Text",
    desc: "Epistemological study of consciousness, direct perception, inferential cognition, doubt, and cognitive errors.",
  },
];

const fiveTreatises = [
  {
    title: "Pramāṇa (Epistemology & Logic)",
    tibetan: "ཚད་མ།",
    text: "Dharmakīrti’s Pramāṇavārttika (Commentary on Valid Cognition)",
    desc: "Rigorous training in valid cognition, formal syllogisms, logic, and perception to refute fallacies and establish rational discernment.",
  },
  {
    title: "Prajñāpāramitā (Perfection of Wisdom)",
    tibetan: "ཕར་ཕྱིན།",
    text: "Maitreya’s Abhisamayālaṅkāra (Ornament of Realization)",
    desc: "Detailed mapping of the bodhisattva grounds (bhūmis), spiritual paths (mārgas), and realizations leading to omniscience.",
  },
  {
    title: "Madhyamaka (The Middle Way)",
    tibetan: "དབུ་མ།",
    text: "Candrakīrti’s Madhyamakāvatāra & Dolpopa’s Mountain Doctrine",
    desc: "Deconstructs all extremes of eternalism and nihilism, presenting the definitive union of freedom from fabrications and primordial luminous awareness.",
  },
  {
    title: "Abhidharma (Cosmology & Psychology)",
    tibetan: "མངོན་པ།",
    text: "Vasubandhu’s Abhidharmakośa (Treasury of Higher Knowledge)",
    desc: "Systematic analysis of mental factors, consciousness, karma, cosmology, and the mechanics of samsaric rebirth.",
  },
  {
    title: "Vinaya (Monastic Ethics & Discipline)",
    tibetan: "འདུལ་བ།",
    text: "Guṇaprabha’s Vinayasūtra (Root Discipline)",
    desc: "Detailed study of individual liberation vows (Prātimokṣa), monastic jurisprudence, and community ethical integrity.",
  },
];

const ritualArts = [
  {
    name: "Liturgical Instruments",
    tibetan: "རོལ་མོ་དང་དུང་རྒྱ།",
    items: "Dungchen (long horns), Gyaling (reed oboes), Nga (ceremonial frame drums), and Rolmo / Silnyen (cymbals).",
  },
  {
    name: "Sand Mandala Construction",
    tibetan: "རྡུལ་ཚོན་དཀྱིལ་འཁོར།",
    items: "Geometrical drafting and mineral sand placement for the Kālacakra and associated mandalas.",
  },
  {
    name: "Chām Mask Dance",
    tibetan: "འཆམ་གར།",
    items: "Ritual dances representing protective deities and lineage masters, coordinated with drum notation.",
  },
  {
    name: "Butter Sculptures (Torma)",
    tibetan: "གཏོར་མ་བཅའ་བཟོ།",
    items: "Symbolic ritual offerings sculpted from roasted barley flour and colored butter.",
  },
];
---

<div class="space-y-12 sm:space-y-16">
  <!-- Educational Mission Header -->
  <div class="surface-card p-6 sm:p-8 md:p-10 space-y-6">
    <div class="badge badge-crimson">
      <span class="badge-dot"></span>
      Monastic Syllabus
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight mb-6 sm:mb-8">
      The 18-Year Progressive Monastic Curriculum
    </h2>

    <p class="lead text-base sm:text-lg text-muted">
      Main Jonang Takten Phuntsok Choeling conducts an 18-year curriculum integrating Tibetan classical grammar, Buddhist epistemology (Pramāṇa), the Five Great Treatises, ritual arts, and multi-year Kālacakra retreat.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <div class="p-4 rounded-xl bg-surface-subtle border border-border text-center space-y-1">
        <span class="text-xs font-semibold text-accent uppercase block">Duration</span>
        <span class="text-2xl font-display font-bold text-ink block">18 Years</span>
        <span class="text-caption text-muted block">Primary through Acharya</span>
      </div>
      <div class="p-4 rounded-xl bg-surface-subtle border border-border text-center space-y-1">
        <span class="text-xs font-semibold text-accent-secondary uppercase block">Sangha Body</span>
        <span class="text-2xl font-display font-bold text-ink block">~120 Monks</span>
        <span class="text-caption text-muted block">100% Tuition-Free Support</span>
      </div>
      <div class="p-4 rounded-xl bg-surface-subtle border border-border text-center space-y-1">
        <span class="text-xs font-semibold text-accent-tertiary uppercase block">Culmination</span>
        <span class="text-2xl font-display font-bold text-ink block">3.5 Years</span>
        <span class="text-caption text-muted block">Solitary Kālacakra Retreat</span>
      </div>
    </div>
  </div>

  <!-- Interactive 18-Year Roadmap Timeline -->
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <Dharmachakra class="w-7 h-7 text-accent-secondary" />
      <h3 class="text-2xl font-display text-ink m-0">
        The Four Academic Epochs
      </h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {
        syllabusStages.map((s) => (
          <div class="surface-card p-6 flex flex-col justify-between space-y-4 border-t-4 border-t-accent hover-lift h-full">
            <div class="space-y-2">
              <div class="flex justify-between items-center text-xs font-mono text-muted">
                <span class="font-bold text-accent">{s.stage}</span>
                <span class="text-accent-secondary font-semibold font-mono">{s.years}</span>
              </div>
              <h4 class="font-display text-lg font-bold text-ink leading-snug">{s.title}</h4>
              <span class="text-xs font-tibetan text-accent-secondary font-bold block">{s.tibetan}</span>
              <p class="text-xs text-muted leading-relaxed pt-1">{s.curriculum}</p>
            </div>
            <div class="pt-3 border-t border-border text-caption font-semibold uppercase tracking-wider text-accent">
              {s.focus}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Foundational Sutra & Dialectics Syllabus (Studying Sutra Part) -->
  <div class="surface-card p-6 sm:p-8 space-y-6 border-l-4 border-l-accent">
    <div class="badge badge-crimson">
      <span class="badge-dot"></span>
      Foundational Sutra Dialectics
    </div>

    <h3 class="text-2xl sm:text-3xl font-display text-ink font-normal">
      Foundational Sūtra Epistemology: Logic, Mind & Dialectics
    </h3>

    <p class="text-sm text-muted leading-relaxed">
      Before embarking on the Five Great Treatises, students undergo a rigorous four-year foundational sequence mastering logic, cognitive theory, and debate manuals:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2 items-stretch">
      {
        sutraFoundations.map((item) => (
          <div class="p-5 rounded-xl bg-surface-subtle border border-border space-y-3 hover-lift flex flex-col justify-between h-full">
            <div>
              <div class="flex justify-between items-center text-xs font-mono text-muted mb-1">
                <span class="font-bold text-accent">Stage {item.sno}</span>
                <span class="text-accent-secondary font-semibold font-mono">{item.duration}</span>
              </div>
              <h4 class="font-display text-lg font-bold text-ink mb-1">{item.name}</h4>
              <span class="text-xs font-tibetan text-accent-secondary block mb-2">{item.tibetan}</span>
              
              <div class="space-y-1.5 text-xs">
                <div class="p-2 rounded bg-surface border border-border">
                  <span class="text-caption-xs uppercase font-bold text-accent block">Main Text:</span>
                  <span class="font-medium text-ink">{item.mainText}</span>
                </div>
                <div class="p-2 rounded bg-surface border border-border">
                  <span class="text-caption-xs uppercase font-bold text-muted block">Supplementary Text:</span>
                  <span class="text-muted">{item.partText}</span>
                </div>
              </div>

              <p class="text-xs text-muted leading-relaxed pt-2">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- The Five Great Treatises (Balanced 3 + 2 Architecture) -->
  <div class="surface-card p-6 sm:p-8 space-y-6">
    <div class="badge badge-saffron">
      <span class="badge-dot"></span>
      Dialectical Corpus
    </div>

    <h3 class="text-2xl font-display text-ink font-normal">
      The Five Great Treatises (<em>Gzhung Chen Bka' Pod Lnga</em>)
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 items-stretch">
      {
        fiveTreatises.map((t, idx) => (
          <div class:list={[
            "p-5 rounded-xl bg-surface-subtle border border-border space-y-2 shadow-xs hover-lift flex flex-col justify-between h-full",
            idx < 3 ? "lg:col-span-2" : "lg:col-span-3",
          ]}>
            <div>
              <div class="flex justify-between items-start mb-1">
                <h4 class="font-display text-base font-bold text-ink">{t.title}</h4>
                <span class="text-xs font-tibetan text-accent-secondary font-bold">{t.tibetan}</span>
              </div>
              <p class="text-xs font-semibold text-accent mb-2">{t.text}</p>
              <p class="text-xs text-muted leading-relaxed m-0">{t.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Liturgical Arts & Instruments -->
  <div class="space-y-6">
    <div class="badge badge-lapis">
      <span class="badge-dot"></span>
      Tantric Arts & Ritual Crafts
    </div>

    <h3 class="text-2xl font-display text-ink font-normal">
      Liturgical Arts and Ritual Music
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {
        ritualArts.map((art) => (
          <div class="p-6 rounded-xl bg-surface border border-border space-y-2 shadow-xs hover-lift flex flex-col justify-between h-full">
            <div>
              <div class="flex justify-between items-center mb-1">
                <h4 class="font-display text-base font-bold text-ink">{art.name}</h4>
              </div>
              <span class="text-xs font-tibetan text-accent font-semibold block mb-2">{art.tibetan}</span>
              <p class="text-xs text-muted leading-relaxed m-0">{art.items}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Meditative Retreat Track -->
  <div class="surface-card p-6 sm:p-8 space-y-4 border-l-4 border-l-accent-secondary">
    <h3 class="text-2xl font-display text-ink">3.5-Year Kālacakra Retreat</h3>
    <p class="text-sm sm:text-base text-muted leading-relaxed">
      Monks who complete the dialectical syllabus qualify to enter the retreat facility for a three-and-a-half-year cycle. Practice centers on Generation Stage deity yoga, Three Isolations dark retreat, and the completion-stage <strong>Six-fold Vajrayoga (Sbyor drug)</strong> under the direct supervision of the retreat master.
    </p>
  </div>
</div>
