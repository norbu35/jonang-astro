---
const commonPreliminaries = [
  { step: "01", name: "Refuge & Prostrations", detail: "100,000 accumulations purifying physical obscurations." },
  { step: "02", name: "Bodhicitta Generation", detail: "100,000 accumulations cultivating altruistic awakening for all beings." },
  { step: "03", name: "Vajrasattva Purification", detail: "100,000 recitations of the 100-syllable mantra." },
  { step: "04", name: "Mandala Offerings", detail: "100,000 offerings accumulating vast merit and wisdom." },
  { step: "05", name: "Guru Yoga", detail: "100,000 supplications unifying practitioner mind with the lineage master." },
];

const sixYogas = [
  {
    num: "1",
    sanskrit: "Pratyahara",
    tibetan: "Sor sdud",
    name: "Withdrawal",
    desc: "Drawing sensory consciousness inward from external objects to perceive the ten night and day signs of empty form.",
  },
  {
    num: "2",
    sanskrit: "Dhyana",
    tibetan: "Bsam gtan",
    name: "Meditative Absorption",
    desc: "Stabilizing unwavering single-pointed concentration upon the arisen empty forms.",
  },
  {
    num: "3",
    sanskrit: "Pranayama",
    tibetan: "Srog rtsol",
    name: "Breath Control",
    desc: "Guiding subtle winds (prana) into the central channel (avadhuti) through vase retention breathing.",
  },
  {
    num: "4",
    sanskrit: "Dharana",
    tibetan: "'Dzin pa",
    name: "Retention",
    desc: "Binding the subtle winds and drops securely at the six main energy focal points along the central channel.",
  },
  {
    num: "5",
    sanskrit: "Anusmriti",
    tibetan: "Rjes dran",
    name: "Recollection",
    desc: "Igniting the inner heat (candali / tummo) to blaze through the channels, inducing the experience of sublime unconditioned bliss.",
  },
  {
    num: "6",
    sanskrit: "Samadhi",
    tibetan: "Ting nge 'dzin",
    name: "Meditative Stabilization",
    desc: "Complete non-dual union of immutable great bliss and pristine empty form, actualizing complete Buddhahood.",
  },
];
---

<div class="space-y-12">
  <!-- Introductory Lead -->
  <div class="surface-card p-6 sm:p-8 md:p-10 space-y-6">
    <div class="badge badge-crimson">
      <span class="badge-dot"></span>
      Tantric Completion Stage
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight">
      The Kalachakra Contemplative Path (Jordruk)
    </h2>

    <p class="lead text-base sm:text-lg text-muted">
      The Jonang Kalachakra curriculum structures the contemplative path from foundational preliminary accumulations (<em>ngondro</em>) through generation stage deity yoga to the completion-stage Six-fold Vajrayoga (<em>sbyor drug</em>).
    </p>

    <div class="callout my-4 text-sm">
      <strong>Sacred Lineage Requirement:</strong> This overview documents the institutional training path followed in formal three-year to nine-year solitary retreats. Engaging in these practices requires receiving the Kalachakra empowerment (<em>wang</em>), scriptural transmission (<em>lung</em>), and experiential guidance (<em>tri</em>) directly from a qualified lineage master.
    </div>
  </div>

  <!-- I. Common Preliminaries -->
  <div class="space-y-6">
    <div class="badge badge-saffron">
      <span class="badge-dot"></span>
      Phase I: Foundational Accumulations
    </div>

    <h3 class="text-2xl font-display text-ink">
      Common Preliminaries (<em>thun mong gi sngon 'gro</em>)
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {
        commonPreliminaries.map((p) => (
          <div class="p-5 rounded-xl bg-surface border border-border space-y-2">
            <span class="text-xs font-mono font-bold text-accent">{p.step}</span>
            <h4 class="font-display text-base font-bold text-ink">{p.name}</h4>
            <p class="text-xs text-muted leading-relaxed">{p.detail}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- II. Uncommon Preliminaries -->
  <div class="surface-card p-6 sm:p-8 space-y-6">
    <div class="badge badge-lapis">
      <span class="badge-dot"></span>
      Phase II: Deity Yoga & Dark Retreat
    </div>

    <h3 class="text-2xl font-display text-ink font-normal">
      Uncommon Preliminaries (<em>thun mong ma yin pa'i sngon 'gro</em>)
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-xl bg-surface-subtle border border-border space-y-3">
        <h4 class="font-display text-lg font-bold text-ink">A. Generation Stage (<em>bskyed rim</em>)</h4>
        <ul class="text-xs sm:text-sm text-muted space-y-2 list-none p-0">
          <li class="border-b border-border/60 pb-2"><strong>Condensed Track:</strong> Connate Deity with Consort (<em>lhan skyes</em>) — 1,000,000 mantra recitations.</li>
          <li class="border-b border-border/60 pb-2"><strong>Medium Track:</strong> Nine-Deity Mind Mandala (<em>lha dgu thugs dkyil</em>) — 1,000,000 recitations.</li>
          <li><strong>Extensive Track:</strong> Four-Fold Approach & Accomplishment for the complete 636-Deity Mandala (<em>drug brgya so drug</em>) — 10,000,000 mantra recitations across one year.</li>
        </ul>
      </div>

      <div class="p-5 rounded-xl bg-surface-subtle border border-border space-y-3">
        <h4 class="font-display text-lg font-bold text-ink">B. The Three Isolations (<em>dben pa gsum</em>)</h4>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          Conducted in strict dark retreat (<em>mun khang</em>) to isolate the physical body, ordinary speech, and conceptual mind from external sensory distraction:
        </p>
        <div class="grid grid-cols-2 gap-3 pt-2">
          <div class="p-3 rounded-lg bg-surface text-center border border-border">
            <span class="text-xs text-muted block">Condensed</span>
            <span class="font-bold text-ink text-sm">50 Days</span>
          </div>
          <div class="p-3 rounded-lg bg-surface text-center border border-border">
            <span class="text-xs text-muted block">Extended</span>
            <span class="font-bold text-ink text-sm">100 Days</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- III. The Six Yogas of Kalachakra Completion Stage -->
  <div class="space-y-6">
    <div class="badge badge-crimson">
      <span class="badge-dot"></span>
      Phase III: Primary Practice
    </div>

    <h3 class="text-2xl font-display text-ink">
      The Six-fold Vajrayoga (<em>dngos gzhi sbyor drug</em>)
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        sixYogas.map((yoga) => (
          <div class="surface-card p-6 flex flex-col justify-between space-y-3 border-t-4 border-t-accent">
            <div>
              <div class="flex justify-between items-center text-xs font-mono text-muted mb-1">
                <span class="font-bold text-accent">Branch 0{yoga.num}</span>
                <span>{yoga.tibetan}</span>
              </div>
              <h4 class="font-display text-lg font-bold text-ink">{yoga.name}</h4>
              <span class="text-xs italic text-muted block mb-2">{yoga.sanskrit}</span>
              <p class="text-xs sm:text-sm text-muted leading-relaxed">{yoga.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
