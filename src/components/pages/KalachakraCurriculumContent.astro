  },
  {
    num: "03",
    sanskrit: "Prāṇāyāma",
    tibetan: "སྲོག་རྩོལ།",
    wylie: "srog rtsol",
    title: "Vajra-Breath & Wind Control",
    tier: "Tier II: Controlling Winds & Channels",
    chakra: "Throat Center (Viśuddha)",
    mechanic: "Vajra-recitation (OṂ ĀḤ HŪṂ) and vase-retention breathing arrest coarse respiratory movement.",
    experience: "Karmic winds from the left (lalanā) and right (rasanā) channels enter and dissolve into the central channel (avadhūti).",
    source: "Tāranātha's Meaningful to Behold: 'When the winds enter the avadhūti, all dualistic conceptuality naturally subsides.'",
  },
  {
    num: "04",
    sanskrit: "Dhāraṇā",
    tibetan: "འཛིན་པ།",
    wylie: "'dzin pa",
    title: "Immutable Retention",
    tier: "Tier II: Controlling Winds & Channels",
    chakra: "Six Bodily Chakras",
    mechanic: "Binding the purified prāṇas and essential drops (bindus) firmly at the six primary energy centers.",
    experience: "Coarse respiration ceases entirely; the practitioner abides in unmoving retention for days.",
    source: "Sekoddeśa: 'Retention is fixing the prāṇas in the central channel at the crown, forehead, throat, heart, navel, and secret.'",
  },
  {
    num: "05",
    sanskrit: "Anusmṛti",
    tibetan: "རྗེས་དྲན།",
    wylie: "rjes dran",
    title: "Recollective Inner Blaze",
    tier: "Tier III: Igniting Great Bliss",
    chakra: "Navel & Central Channel",
    mechanic: "Igniting the fierce inner heat (caṇḍālī / tummo) at the navel to melt the white drops at the crown.",
    experience: "Blissful bodhicitta nectar descends through the chakras, inducing the Four Joys and supreme unchanging bliss.",
    source: "Kālacakratantra V.124: 'Through the touch of caṇḍālī, the nectar melts and the 21,600 moments of immutable bliss dawn.'",
  },
  {
    num: "06",
    sanskrit: "Samādhi",
    tibetan: "ཏིང་ངེ་འཛིན།",
    wylie: "ting nge 'dzin",
    title: "Non-Dual Realization",
    tier: "Tier III: Supreme Awakening",
    chakra: "Omnipresent Sahajakāya",
    mechanic: "Complete and irreversible unification of supreme immutable bliss (mahāsukha) and pristine empty form (śūnyatā).",
    experience: "The physical aggregates transmute into the Sambhogakāya rainbow body endowed with all 112 marks of Buddhahood.",
    source: "Dolpopa's Mountain Dharma: 'The definitive union of supreme empty form and unchanging bliss is the state of the Primordial Buddha.'",
  },
