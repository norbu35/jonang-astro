const nightSigns = [
  { no: "01", name: "Smoke", tibetan: "དུ་བ།", sanskrit: "Dhūma", desc: "Wisps of shimmering blue vapor undulating in the pure void of the dark cell." },
  { no: "02", name: "Mirage", tibetan: "སྨིག་རྒྱུ།", sanskrit: "Marīci", desc: "Wavelike shimmering streams of clear luminous water glistening in space." },
  { no: "03", name: "Fireflies", tibetan: "མཁྱེར་མ།", sanskrit: "Khadyota", desc: "Twinkling golden sparks and luminescent orbs drifting without point of origin." },
  { no: "04", name: "Butter Lamp", tibetan: "མར་མེ།", sanskrit: "Pradīpa", desc: "A calm, constant, unflickering golden radiance dispelling all coarse obscurations." },
];

const daySigns = [
  { no: "05", name: "Blazing Flame", tibetan: "འབར་བ།", sanskrit: "Jvālā", desc: "A towering pristine wisdom fire consuming all conceptual proliferation." },
  { no: "06", name: "Moon Radiance", tibetan: "ཟླ་བ།", sanskrit: "Candra", desc: "A cool, shimmering full moon disc symbolizing supreme bodhicitta nectar." },
  { no: "07", name: "Sun Orb", tibetan: "ཉི་མ།", sanskrit: "Sūrya", desc: "A brilliant solar orb radiating unconditioned luminous heat and clarity." },
  { no: "08", name: "Rāhu (Eclipse)", tibetan: "སྒྲ་གཅན།", sanskrit: "Tamas / Rāhu", desc: "A profound black void absorbing all solar and lunar conceptual winds." },
  { no: "09", name: "Lightning", tibetan: "གློག", sanskrit: "Vidyut", desc: "A flash of diamond lightning striking through the subtle channels." },
  { no: "10", name: "Great Bindu", tibetan: "ཐིག་ལེ་ཆེན་པོ།", sanskrit: "Mahābindu", desc: "The ultimate luminous sphere within which the complete Kālacakra Buddha form arises." },
];

const retreatCurriculum = [
  {
    stage: "Tome I",
    name: "Common Kālacakra Ngöndro",
    tibetan: "ཐུན་མོང་སྔོན་འགྲོ།",
    duration: "6 Months",
    manual: "Sgom rim, Mthong ba don ldan & Lhan thabs",
    desc: "Complete accumulation of the fivefold 100,000 foundational practices utilizing the root Jonang liturgy.",
  },
  {
    stage: "Tome II",
    name: "Extraordinary Kālacakra Ngöndro",
    tibetan: "ཐུན་མིན་སྔོན་འགྲོ།",
    duration: "3 Months",
    manual: "Sgom rim, Mthong ba don ldan & Lhan thabs",
    desc: "Uncommon physical postures (yantras), subtle body channel purification, and Kālacakra-specific Guru Yoga.",
  },
  {
    stage: "Tome III",
    name: "Generation Stage & Dark Retreat",
    tibetan: "དུས་འཁོར་བསྐྱེད་རིམ་དང་མུན་ཁང་།",
    duration: "6 Months",
    manual: "Sgom rim, Mthong ba don ldan & Lhan thabs",
    desc: "Self-visualization of the deity mandala followed by strict 50–100 day dark retreat in specialized cells.",
  },
  {
    stage: "Tome IV",
    name: "The Six-fold Vajrayoga",
    tibetan: "སྦྱོར་བ་ཡན་ལག་དྲུག",
    duration: "24 Months",
    manual: "Sgom rim, Mthong ba don ldan & Lhan thabs",
    desc: "Intensive two-year retreat mastering Pratyāhāra through Samādhi under the personal guidance of the Dorje Lopön.",
  },
];
---

<div class="space-y-16 sm:space-y-24">
  
  <!-- I. Preamble: The Tantric Matrix & Transmission Prerequisites -->
  <section class="relative rounded-2xl sm:rounded-3xl p-6 sm:p-10 bg-gradient-to-b from-[#8f1e21] via-[#7b171a] to-[#661214] border border-[#fdbc2d]/40 text-white shadow-xl overflow-hidden">
    <div class="pointer-events-none absolute top-0 right-0 w-96 h-96 bg-[#fdbc2d]/15 blur-[120px] rounded-full" aria-hidden="true"></div>

    <div class="relative z-10 space-y-6">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#85181b] pb-5">
        <div class="flex items-center gap-3">
          <Dharmachakra class="w-7 h-7 text-[#fdbc2d] shrink-0" />
          <div class="space-y-0.5">
            <span class="text-caption font-mono uppercase font-bold text-[#fdbc2d] tracking-wider block">
              Canonical Preface · སྔོན་འགྲོའི་གསལ་བཤད།
            </span>
            <h2 class="text-2xl sm:text-3xl font-display font-bold text-white m-0">
              The Matrix of the Three Kālacakras
            </h2>
          </div>
        </div>

        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#500c0e] border border-[#fdbc2d]/50 text-xs font-mono text-[#fdbc2d] font-semibold">
          <span class="w-2 h-2 rounded-full bg-[#fdbc2d]"></span>
          Unbroken Jonang Lineage
        </span>
      </div>

      <p class="text-base sm:text-lg text-white/90 leading-relaxed font-serif m-0">
        In the Jonang tradition, the Kālacakra (*Wheel of Time*) is expounded as a threefold indivisible reality that harmonizes the external universe, the inner human subtle anatomy, and the transcendent path of liberation:
      </p>

      <!-- Threefold Matrix Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-2">
        <div class="p-5 rounded-2xl bg-[#500c0e] border border-[#85181b] space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-caption font-mono font-bold text-[#fdbc2d] uppercase">1. Outer Kālacakra</span>
            <span class="text-xs font-tibetan text-[#fdbc2d] font-bold">ཕྱི་དུས་ཀྱི་འཁོར་ལོ།</span>
          </div>
          <h4 class="font-display text-base font-bold text-white m-0">The Macrocosm</h4>
          <p class="text-xs text-white/80 leading-relaxed m-0 font-serif">
            The external cosmos: planetary motions, astrological cycles, seasons, and the physical universe structured around Mount Meru.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#500c0e] border border-[#85181b] space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-caption font-mono font-bold text-[#fdbc2d] uppercase">2. Inner Kālacakra</span>
            <span class="text-xs font-tibetan text-[#fdbc2d] font-bold">ནང་དུས་ཀྱི་འཁོར་ལོ།</span>
          </div>
          <h4 class="font-display text-base font-bold text-white m-0">The Microcosm</h4>
          <p class="text-xs text-white/80 leading-relaxed m-0 font-serif">
            The psycho-physical human body: the 72,000 subtle channels (<em>nāḍī</em>), 21,600 daily breaths (<em>prāṇa</em>), and essential drops (<em>bindu</em>).
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#500c0e] border border-[#85181b] space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-caption font-mono font-bold text-[#fdbc2d] uppercase">3. Other Kālacakra</span>
            <span class="text-xs font-tibetan text-[#fdbc2d] font-bold">གཞན་དུས་ཀྱི་འཁོར་ལོ།</span>
          </div>
          <h4 class="font-display text-base font-bold text-white m-0">The Spiritual Path</h4>
          <p class="text-xs text-white/80 leading-relaxed m-0 font-serif">
            The contemplative method: the empowerments, generation stage deity mandalas, and the definitive Six-fold Vajrayoga completion stage.
          </p>
        </div>
      </div>

      <!-- Lineage Transmission Solemn Requirement Callout -->
      <div class="p-4 sm:p-5 rounded-xl bg-[#500c0e]/90 border border-[#fdbc2d]/40 text-xs sm:text-sm text-white/90 space-y-1">
        <div class="font-bold text-[#fdbc2d] flex items-center gap-2">
          <span>❖ Sacred Transmission Requirement</span>
        </div>
        <p class="m-0 leading-relaxed font-serif">
          This treatise provides a scholastic overview of the institutional curriculum practiced in traditional Jonang three-year retreats. Authentic practice requires receiving the supreme Kālacakra empowerment (<em>dbang</em>), reading transmission (<em>lung</em>), and experiential guidance (<em>khrid</em>) from a qualified Dorje Lopön.
        </p>
      </div>

    </div>
  </section>

  <!-- II. Tome I: The Foundational Accumulations (Thun mong sngon 'gro) -->
  <section class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-border/80 pb-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 text-caption-xs font-mono font-bold uppercase tracking-wider text-accent">
          <LotusFlower class="w-3.5 h-3.5 text-accent" />
          Tome I · Foundational Purification
        </div>
        <h3 class="text-2xl sm:text-3xl font-display font-bold text-ink m-0">
          The Five Foundational Accumulations (<em>Thun Mong Sngon 'Gro</em>)
        </h3>
      </div>
      <span class="text-caption font-mono text-muted">
        500,000 Total Accumulations
      </span>
    </div>

    <p class="text-sm sm:text-base text-muted leading-relaxed font-serif m-0">
      Before being admitted into the Kālacakra retreat facility, each candidate must complete 500,000 preliminary accumulations to purify obscurations and cultivate spiritual momentum:
    </p>

    <!-- Classical Illuminated Manuscript Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-stretch">
      {
        commonPreliminaries.map((p) => (
          <div class="surface-card p-5 rounded-2xl border-t-4 border-t-accent hover-lift flex flex-col justify-between space-y-4 h-full">
            <div class="space-y-2.5">
              <div class="flex items-center justify-between border-b border-border/60 pb-2">
                <span class="text-caption-xs font-mono font-bold text-accent uppercase">
                  Practice {p.order}
                </span>
                <span class="text-xs font-tibetan font-bold text-accent-secondary">
                  {p.tibetan}
                </span>
              </div>

              <h4 class="font-display text-base font-bold text-ink m-0 leading-snug">
                {p.name}
              </h4>

              <div class="inline-block badge badge-saffron text-caption-xs font-mono font-semibold">
                {p.target}
              </div>

              <p class="text-xs text-muted leading-relaxed font-serif m-0">
                {p.purification}
              </p>
            </div>

            <div class="pt-3 border-t border-border/60 text-caption-xs text-muted">
              <span class="font-mono text-accent uppercase block mb-0.5 font-semibold">Target Domain</span>
              <span class="text-ink font-medium leading-snug block">{p.dimension}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- III. Tome II: The Hermitage of the Three Isolations & Dark Retreat -->
  <section class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-border/80 pb-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 text-caption-xs font-mono font-bold uppercase tracking-wider text-accent-secondary">
          <Dharmachakra class="w-3.5 h-3.5 text-accent-secondary" />
          Tome II · The Secret Hermitage
        </div>
        <h3 class="text-2xl sm:text-3xl font-display font-bold text-ink m-0">
          Deity Generation & The Three Isolations (<em>Dben Pa Gsum</em>)
        </h3>
      </div>
      <span class="text-caption font-mono text-muted">
        50–100 Day Dark Retreat
      </span>
    </div>

    <p class="text-sm sm:text-base text-muted leading-relaxed font-serif m-0">
      Having established the foundational matrix, the yogi enters the extraordinary preliminaries comprising Generation Stage deity visualization (<em>bskyed rim</em>) and total sensory deprivation within dark retreat cells (<em>mun khang</em>):
    </p>

    <!-- Two-Column Scholastic Exposition -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Left Column: Generation Stage Tracks -->
      <div class="lg:col-span-6 surface-card p-6 sm:p-8 rounded-2xl space-y-5">
        <div class="flex items-center justify-between border-b border-border/80 pb-3">
          <div class="space-y-0.5">
            <span class="text-caption-xs font-mono text-accent-secondary font-bold uppercase">Deity Yoga (Bskyed Rim)</span>
            <h4 class="font-display text-xl font-bold text-ink m-0">The Three Generation Tracks</h4>
          </div>
          <span class="badge badge-lapis text-caption">Mandala Matrix</span>
        </div>

        <p class="text-xs text-muted leading-relaxed font-serif m-0">
          Structured progressively according to student capacity and retreat cycle under the root Jonang meditation commentaries:
        </p>

        <div class="space-y-3 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-surface-subtle border border-border space-y-1">
            <div class="flex items-center justify-between font-bold text-ink">
              <span>1. Condensed Track (Lhan skyes)</span>
              <span class="font-mono text-accent text-xs">1,000,000 Recitations</span>
            </div>
            <p class="text-muted text-xs m-0 leading-relaxed font-serif">
              Single-deity Kālacakra with Consort (two-armed Sahaja form) focused on essential mantra recitation.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-surface-subtle border border-border space-y-1">
            <div class="flex items-center justify-between font-bold text-ink">
              <span>2. Medium Track (Lha dgu thugs dkyil)</span>
              <span class="font-mono text-accent text-xs">1,000,000 Recitations</span>
            </div>
            <p class="text-muted text-xs m-0 leading-relaxed font-serif">
              Nine-Deity Mind Mandala generating the principal retinue deities and directional protectors.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-surface-subtle border border-border space-y-1.5">
            <div class="flex items-center justify-between font-bold text-ink">
              <span>3. Extensive Track (Drug brgya so drug)</span>
              <span class="font-mono text-accent text-xs">10,000,000 Recitations / 1 Year</span>
            </div>
            <p class="text-muted text-xs m-0 leading-relaxed font-serif">
              Complete 636-Deity Mandala of Body, Speech, and Mind, practicing the <strong>Fourfold Approach & Accomplishment (<em>bsnyen sgrub yan lag bzhi</em>)</strong>:
            </p>
            <ol class="text-caption-xs text-muted list-decimal list-inside space-y-0.5 pt-1 font-serif m-0">
              <li>Supreme Royal Mandala (<em>dkyil 'khor rgyal mchog</em>)</li>
              <li>Supreme Royal Activity (<em>las rgyal mchog</em>)</li>
              <li>Essential Sphere Activity (<em>thig le'i rnal 'byor</em>)</li>
              <li>Subtle Yoga (<em>phra mo'i rnal 'byor</em>)</li>
            </ol>
          </div>
        </div>
      </div>

      <!-- Right Column: The Three Isolations & Dark Retreat -->
      <div class="lg:col-span-6 surface-card p-6 sm:p-8 rounded-2xl space-y-5 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-border/80 pb-3">
            <div class="space-y-0.5">
              <span class="text-caption-xs font-mono text-accent font-bold uppercase">Dark Cell Hermitage (Mun Khang)</span>
              <h4 class="font-display text-xl font-bold text-ink m-0">The Three Isolations (Dben Pa Gsum)</h4>
            </div>
            <span class="badge badge-crimson text-caption">Sensory Void</span>
          </div>

          <p class="text-xs text-muted leading-relaxed font-serif m-0">
            Conducted in complete sensory deprivation within pitch-black meditation cells. The practitioner systematically isolates the three doors:
          </p>

          <ul class="text-xs text-muted space-y-2 list-none p-0 m-0">
            <li class="p-3 rounded-lg bg-surface-subtle border border-border">
              <strong class="text-ink">1. Physical Isolation (Lus dben):</strong> Ceasing all ordinary bodily movement, adopting the sevenfold Vairocana or Kālacakra bodhisattva posture.
            </li>
            <li class="p-3 rounded-lg bg-surface-subtle border border-border">
