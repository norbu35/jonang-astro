const nightSigns = [
  {
    no: "01",
    name: "Smoke",
    tibetan: "དུ་བ།",
    sanskrit: "Dhūma",
    desc: "Wisps of shimmering blue vapor undulating in the pure void of the dark cell.",
  },
  {
    no: "02",
    name: "Mirage",
    tibetan: "སྨིག་རྒྱུ།",
    sanskrit: "Marīci",
    desc: "Wavelike shimmering streams of clear luminous water glistening in space.",
  },
  {
    no: "03",
    name: "Fireflies",
    tibetan: "མཁྱེར་མ།",
    sanskrit: "Khadyota",
    desc: "Twinkling golden sparks and luminescent orbs drifting without point of origin.",
  },
  {
    no: "04",
    name: "Butter Lamp",
    tibetan: "མར་མེ།",
    sanskrit: "Pradīpa",
    desc: "A calm, constant, unflickering golden radiance dispelling all coarse obscurations.",
  },
