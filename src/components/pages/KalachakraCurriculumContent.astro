const daySigns = [
  {
    no: "05",
    name: "Blazing Flame",
    tibetan: "འབར་བ།",
    sanskrit: "Jvālā",
    desc: "A towering pristine wisdom fire consuming all conceptual proliferation.",
  },
  {
    no: "06",
    name: "Moon Radiance",
    tibetan: "ཟླ་བ།",
    sanskrit: "Candra",
    desc: "A cool, shimmering full moon disc symbolizing supreme bodhicitta nectar.",
  },
  {
    no: "07",
    name: "Sun Orb",
    tibetan: "ཉི་མ།",
    sanskrit: "Sūrya",
    desc: "A brilliant solar orb radiating unconditioned luminous heat and clarity.",
  },
  {
    no: "08",
    name: "Rāhu (Eclipse)",
    tibetan: "སྒྲ་གཅན།",
    sanskrit: "Tamas / Rāhu",
