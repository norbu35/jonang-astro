const retreatCurriculum = [
  {
    stage: "Stage 01",
    name: "Common Kālacakra Ngöndro",
    tibetan: "ཐུན་མོང་སྔོན་འགྲོ།",
    duration: "6 Months",
    manual: "Sgom rim, Mthong ba don ldan & Lhan thabs",
    desc: "Complete accumulation of the fivefold 100,000 foundational practices utilizing the root Jonang liturgy.",
  },
  {
    stage: "Stage 02",
    name: "Extraordinary Kālacakra Ngöndro",
    tibetan: "ཐུན་མིན་སྔོན་འགྲོ།",
    duration: "3 Months",
    manual: "Sgom rim, Mthong ba don ldan & Lhan thabs",
    desc: "Uncommon physical postures (yantras), subtle body channel purification, and Kālacakra-specific Guru Yoga.",
  },
  {
    stage: "Stage 03",
    name: "Generation Stage & Dark Retreat",
    tibetan: "དུས་འཁོར་བསྐྱེད་རིམ་དང་མུན་ཁང་།",
    duration: "6 Months",
    manual: "Sgom rim, Mthong ba don ldan & Lhan thabs",
    desc: "Self-visualization of the deity mandala followed by strict 50–100 day dark retreat in specialized cells.",
  },
  {
    stage: "Stage 04",
    name: "The Six-fold Vajrayoga",
    tibetan: "སྦྱོར་བ་ཡན་ལག་དྲུག",
    duration: "24 Months",
    manual: "Sgom rim, Mthong ba don ldan & Lhan thabs",
    desc: "Intensive two-year retreat mastering Pratyāhāra through Samādhi under the personal guidance of the Dorje Lopön.",
  },
