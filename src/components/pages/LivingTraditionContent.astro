---
import { Image } from "astro:assets";
import ChapterHeader from "../ui/ChapterHeader.astro";
import PillarCard from "../ui/PillarCard.astro";
import Dharmachakra from "../icons/Dharmachakra.astro";
import EndlessKnot from "../icons/EndlessKnot.astro";
import LotusFlower from "../icons/LotusFlower.astro";

// Verified image assets
import youngStudentsImg from "../../assets/images/young-students.webp";
import lectureImg from "../../assets/images/lecture.webp";
import plantingTreesImg from "../../assets/images/planting-trees.webp";
import taranathaThangka from "../../assets/images/taranatha-dzamthang-thangka.webp";

const dailySchedule = [
  {
    time: "05:00",
    event: "Gandi Slit-Gong & Horn Call",
    tibetan: "གཎྜི་དང་དུང་ཆེན།",
    desc: "The morning wakes with the rhythmic, syncopated clack of the wooden gandi slit-gong, building to a rapid crescendo across the deodar pines, answered by the deep reverberation of the brass dungchen horns.",
    tag: "Dawn Awakening",
  },
  {
    time: "05:30 – 07:00",
    event: "Morning Liturgical Assembly",
    tibetan: "ཞོགས་ཚོགས། (ཚོགས་ཆེན།)",
    desc: "The monastic sangha convenes in the Main Prayer Hall ('du khang) for the Praises to the Twenty-One Tārās (sgrol ma), lineage refuge prayers, and solemn auspicious dedications.",
    tag: "Assembly Prayer",
  },
  {
    time: "07:00 – 08:30",
    event: "Morning Tea & Root Recitation",
    tibetan: "ཞོགས་ཇ་དང་བློ་འཛིན།",
    desc: "Junior tea servers circulate with steaming butter tea (bod ja) and tsampa. Monks engage in individual memorization (blo 'dzin) of foundational root treatises and philosophical texts.",
    tag: "Nourishment & Study",
  },
  {
    time: "08:30 – 11:30",
    event: "Shedra Classes & Novice Calligraphy",
    tibetan: "དཔེ་ཁྲིད་དང་དག་བྲིས།",
    desc: "Formal classroom lectures on Buddhist epistemology (pramāṇa), classical Tibetan grammar (sum rtags), and novice penmanship practice on chalk-dusted wooden slates (byang shing).",
    tag: "Scholastic Shedra",
  },
  {
    time: "11:30 – 13:00",
    event: "Communal Lunch & Grounds Maintenance",
    tibetan: "གདུགས་ཚོད་དང་ཕྱག་ལས།",
    desc: "The primary hot meal in the monastic dining hall (za khang)—tingmo steamed buns, lentils, rice, and fresh vegetables—followed by light chores and personal laundry.",
    tag: "Midday Meal",
  },
  {
    time: "13:00 – 16:30",
    event: "Specialized Treatises & Sacred Arts",
    tibetan: "གཞུང་ཆེན་དང་མཆོད་རྫས་སྦྱོང་བརྡར།",
    desc: "Advanced Madhyamaka study, Kalachakra liturgical training, ritual music instruction (cymbals, gyaling oboes), and the sculpting of intricate ceremonial butter cakes (torma).",
    tag: "Ritual & Philosophy",
  },
  {
    time: "16:30 – 18:30",
    event: "Evening Dharmapāla Protector Assembly",
    tibetan: "དགོང་མོའི་བསྐང་གསོ།",
    desc: "Chanting of protector fulfillment rituals (bkang gso) honoring Mahākāla and Palden Lhamo, accompanied by the measured clash of sil snyan cymbals and thunderous bass drums (rnga).",
    tag: "Protector Liturgy",
  },
  {
    time: "18:30 – 19:30",
    event: "Evening Nourishment & Tea",
    tibetan: "དགོང་ཇ་དང་ཐུག་པ།",
    desc: "A light evening repast of traditional warming noodle soup (thukpa / bag thug) or sweet milk tea with fresh mountain flatbreads.",
    tag: "Supper",
  },
  {
    time: "19:30 – 22:00",
    event: "Dialectical Debate Assembly",
    tibetan: "ཆོས་རྭའི་རྩོད་པ།",
    desc: "High-energy dialectical debate in the open-air courtyard (chos rwa). Pairs of monks test epistemological definitions and philosophical logic through vocal sparring and kinetic hand-claps.",
    tag: "Courtyard Debate",
  },
  {
    time: "22:00 – 22:30",
    event: "Bedside Recitations & Dormitory Lights Out",
    tibetan: "མཚན་མོའི་ཁ་ཏོན་དང་གཟིམ་ཁང་།",
    desc: "Quiet individual prayer commitments and mantra recitations in residential quarters before the monastery settles into quiet Himalayan nightfall.",
    tag: "Nightfall",
  },
];

const debateKinetics = [
  {
    step: "01. The Stance & Upraised Arm",
    tibetan: "འགྱིང་སྟབས་དང་རལ་གྲི།",
    symbol: "Sword of Mañjuśrī",
    desc: "The challenger circles the seated respondent, extending his left hand outward and raising his right arm high overhead—brandishing the invisible sword of transcendent wisdom (prajñā) poised to sever conceptual doubt.",
  },
  {
    step: "02. The Kinetic Clap (Thal 'phen pa)",
    tibetan: "ཐལ་འཕེན་པའི་སྒྲ།",
    symbol: "Wisdom & Compassion Union",
    desc: "With a swift, sweeping motion, the right palm strikes down into the open left hand with a sharp crack, symbolizing the union of wisdom and compassionate skillful means (upāya), while slamming shut the gates of rebirth.",
  },
  {
    step: "03. The Grounded Foot Stamp",
    tibetan: "ཞབས་བརྡབས།",
    symbol: "Subduing Ego & Delusion",
    desc: "As the hands strike, the challenger's left foot stamps down firmly onto the courtyard paving stones, enacting the symbolic subjugation of ignorance and the crushing of cyclical self-fixation.",
  },
  {
    step: "04. The Mala Cadence ('Phreng ba)",
    tibetan: "ཕྲེང་བའི་བརྡ་རྟགས།",
    symbol: "Rhythmic Dialectic",
    desc: "Brandishing his prayer beads coiled around his left wrist, the challenger sweeps them forward to punctuate formal syllogistic premises, accompanied by the piercing seed cry 'Dhih!'—the invocation of Mañjuśrī.",
  },
];

const monasticFlavors = [
  {
    title: "Po Cha (Butter Tea)",
    tibetanTitle: "བོད་ཇ། / སྲུབ་ཇ།",
    kicker: "Himalayan Elixir",
    accent: "gold" as const,
    description: "Compressed brick tea leaves (ja ril) boiled into a dense dark liquor, then churned with rich butter, fresh milk, and rock salt. Served scalding hot in birch-burl wooden bowls (phor pa) throughout morning assemblies.",
  },
  {
    title: "Highland Tsampa",
    tibetanTitle: "རྩམ་པ།",
    kicker: "The Ancient Staple",
    accent: "secondary" as const,
    description: "Roasted highland barley ground into fine nutty flour. Mixed by hand with hot butter tea and dried mountain curd (chura), rolled into dense dough dumplings (pak) that sustain long hours of meditation.",
  },
  {
    title: "Tingmo & Thukpa",
    tibetanTitle: "ཀྲིང་མོ་དང་ཐུག་པ།",
    kicker: "Communal Hearth",
    accent: "accent" as const,
    description: "Fluffy yeast-steamed rosette buns (tingmo) paired with savory spiced lentils at midday, followed at dusk by hand-pulled noodle broth (thukpa) or pinch dumplings (bhatuk) with mountain vegetables.",
  },
];

const sacredCrafts = [
  {
    title: "Xylography (Par Shing)",
    tibetanTitle: "ཤིང་པར་གྱི་སྲོལ་རྒྱུན།",
    kicker: "Living Pecha Archives",
    accent: "accent" as const,
    description: "Birch and pear-wood blocks chiseled in reverse relief by master carvers. Monks ink the blocks with carbon soot ink and hand-press them onto insect-resistant daphne root paper (shog gu), producing scriptures that endure for centuries.",
  },
  {
    title: "Mineral Thangka Pigments",
    tibetanTitle: "རྡོ་ཚོན་དང་གསེར་ཆུ།",
    kicker: "Dzamthang Art Heritage",
    accent: "gold" as const,
    description: "Artisans pulverize raw Himalayan minerals: lapis lazuli (mthing) for sky and water, malachite (spang ma) for mountain greens, and cinnabar (mtshal) for vermilion robes. Shimmering details are gilded in real gold leaf burnished with agate.",
  },
  {
    title: "Ritual Butter Sculptures (Torma)",
    tibetanTitle: "དཀར་རྒྱན་གཏོར་མ།",
    kicker: "Ephemeral Offering",
    accent: "secondary" as const,
    description: "Consecrated roasted barley dough sculpted with astonishing geometric precision and adorned with vibrant floral medallions made from clarified, dyed butter—crafted fresh for annual Kalachakra and Monlam ceremonies.",
  },
];

const authenticProverbs = [
  {
    tibetan: "གྲྭ་ཚང་ཇ་མེད་ཁང་སྟོང་རེད། དཔེ་ཆ་དགོད་མེད་ཤིང་སྐམ་རེད།",
    phonetic: "Dratsang ja-mey khang-tong rey; pecha gö-mey shing-kam rey.",
    english: "A monastery without hot tea is just a cold cavern; a scholar without laughter is a dry stick.",
    meaning: "Compassion, hospitality, and joy are the essential soil in which deep philosophy thrives.",
  },
  {
    tibetan: "བླ་མའི་གསུང་ལ་ཉོན། གྲྭ་པའི་ཞབས་ལ་ལྟོས།",
    phonetic: "Lamey sung la nyon; drapey zhab la tö.",
    english: "Listen to the words of the lama, but watch the feet of the monk.",
    meaning: "Genuine spiritual attainment is validated not by intellectual eloquence, but by humble daily conduct and compassionate steps.",
  },
  {
    tibetan: "རྩམ་པ་མ་ཞུ་ན། གཡག་རུས་མ་འཆའ།",
    phonetic: "Tsampa ma-zhu na; yak-rü ma-cha.",
    english: "If you cannot digest roasted barley flour, do not try to bite a yak bone.",
    meaning: "Master fundamental ethical discipline, patience, and humility before attempting advanced tantric austerities.",
  },
  {
    tibetan: "ལུག་དཀར་པོ་གངས་ལ་མ་ནོར།",
    phonetic: "Luk karpo gang la ma-nor.",
    english: "Do not mistake the white sheep for the mountain snow.",
    meaning: "A razor-sharp warning from the debate courtyard against making hasty, superficial assumptions based on appearance alone.",
  },
];
---

<div class="section-padding max-w-6xl mx-auto space-y-20 editorial-offset pt-8 sm:pt-12">
  <!-- Glimpse 01: The Monastic Clock -->
  <section class="space-y-8 scroll-mt-[calc(var(--header-h)+4rem)]" id="monastic-clock">
    <ChapterHeader
      chapter="Glimpse 01"
      title="The Monastic Clock: A Day on the Ridge"
      tibetanTitle="ཉིན་རེའི་དུས་ཚོད་དང་འཚོ་བའི་རིམ་པ།"
      lede="Monastic time is measured not by mechanical clockwork, but by sacred sound cues that structure prayer, scholarship, physical labor, and restorative quiet from pre-dawn mist to starlight."
    />

    <!-- Sensory Landscape Highlight Banner -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="surface-card p-6 border-l-4 border-l-gold flex flex-col gap-3">
        <div class="flex items-center gap-2 text-accent font-mono font-bold text-xs uppercase tracking-wider">
          <Dharmachakra class="w-4 h-4 text-gold shrink-0" />
          <span>Olfactory Landscape (Dri zhim)</span>
        </div>
        <p class="text-sm text-muted font-serif leading-relaxed m-0">
          The monastic atmosphere awakens with the sweet, resinous aroma of wild mountain juniper (<em>shug pa</em>) ignited inside whitewashed outdoor kilns (<em>bsang khang</em>), mingling with the nutty richness of brick tea, melting butter lamps (<em>mar me</em>), and rain-soaked deodar needles.
        </p>
      </div>

      <div class="surface-card p-6 border-l-4 border-l-accent flex flex-col gap-3">
        <div class="flex items-center gap-2 text-accent font-mono font-bold text-xs uppercase tracking-wider">
          <EndlessKnot class="w-4 h-4 text-accent shrink-0" />
          <span>Sonic Landscape (Sgra dbyangs)</span>
        </div>
        <p class="text-sm text-muted font-serif leading-relaxed m-0">
          From the sharp syncopation of the wooden <em>gandi</em> slit-gong and the deep drone of <em>dungchen</em> long-horns to the subterranean resonance of overtone chanting and clashing debate palms, the monastery resounds with acoustic mindfulness.
        </p>
      </div>
    </div>

    <!-- 24-Hour Timetable Schedule -->
    <div class="surface-card overflow-hidden rounded-2xl border border-border">
      <div class="bg-gradient-to-r from-accent via-accent-hover to-maroon px-6 py-4 text-white flex items-center justify-between">
        <span class="font-mono text-xs uppercase tracking-wider text-gold font-bold">Sanjauli Daily Routine</span>
        <span class="font-tibetan text-base text-gold font-bold" lang="bo">ཉིན་རེའི་ལས་རིམ།</span>
      </div>

      <div class="divide-y divide-border">
        {dailySchedule.map((slot, index) => (
          <div
            id={`time-slot-${index}`}
            class="time-slot-row p-4 sm:p-6 flex flex-col sm:flex-row sm:items-start gap-4 transition-all duration-300 hover:bg-surface-subtle/60"
          >
            <div class="sm:w-36 shrink-0 flex sm:flex-col items-center sm:items-start justify-between sm:justify-start gap-2">
              <span class="font-mono text-sm sm:text-base font-bold text-accent">
                {slot.time}
              </span>
              <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-muted bg-surface-subtle px-2 py-0.5 rounded border border-border/80">
                {slot.tag}
              </span>
            </div>
            <div class="flex-1 space-y-1.5">
              <div class="flex flex-wrap items-baseline gap-2">
                <h3 class="text-base sm:text-lg font-display font-bold text-ink m-0">
                  {slot.event}
                </h3>
                <span class="text-xs sm:text-sm font-tibetan text-accent-secondary font-bold" lang="bo">
                  {slot.tibetan}
                </span>
              </div>
              <p class="text-sm text-muted font-serif leading-relaxed m-0">
                {slot.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Glimpse 02: The Kinetic Theater of Debate -->
  <section class="space-y-8 scroll-mt-[calc(var(--header-h)+4rem)]" id="debate-theater">
    <ChapterHeader
      chapter="Glimpse 02"
      title="The Kinetic Theater of Debate (Chö-ra)"
      tibetanTitle="ཆོས་རྭའི་རྩོད་པ། བློ་གྲོས་ཀྱི་རྩལ་སྦྱོང་།"
      lede="Debate in the Tibetan monastic courtyard is neither cold scholastic dialogue nor hostile confrontation. It is an embodied martial art of logic—joyful, rigorous, and dedicated to severing the roots of ignorance."
    />

    <!-- Narrative & Image Pair -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-6 space-y-4 font-serif text-ink text-sm sm:text-base leading-relaxed">
        <p class="m-0">
          Each evening under the courtyard floodlights, the monastery courtyard (<em>chos rwa</em>) transforms into a theater of dialectical combat. Monks pair off: the <strong>Defender</strong> (<em>dam bca' pa</em>) sits calmly cross-legged on a low felt cushion, while the <strong>Questioner</strong> (<em>thal 'phen pa</em>) stands, circles, and launches rapid-fire formal syllogisms.
        </p>
        <p class="m-0">
          The practice is intensely egalitarian. Rank and age vanish on the stone flagstones: a sharp sixteen-year-old novice can cross-examine a senior Geshe. If the master falters in his premises, the entire circle of onlookers erupts into good-natured laughter, chanting <em>"Khyi! Khyi!"</em> ("You dog!"), signaling that the opponent's reasoning has strayed from the path.
        </p>
        <p class="m-0 text-muted">
          Through hundreds of hours of sparring, fear of public failure vanishes. Young monks learn to withstand intense intellectual scrutiny with equanimity, replacing defensive pride with intellectual agility and genuine humility.
        </p>
      </div>

      <div class="lg:col-span-6">
        <div class="surface-card overflow-hidden rounded-2xl border border-border shadow-card">
          <Image
            src={lectureImg}
            alt="Monks in dialectical discussion and scholastic training"
            class="w-full h-auto aspect-[4/3] object-cover transition-transform duration-700 hover:scale-105"
            width={640}
            height={480}
            loading="lazy"
            decoding="async"
          />
          <div class="p-4 bg-surface-subtle border-t border-border">
            <span class="text-xs font-mono uppercase tracking-wider text-accent font-bold block mb-1">
              Courtyard Epistemology
            </span>
            <p class="text-xs text-muted font-serif m-0">
              Challenging premises through Pramāṇa logic, where every gesture carries centuries of symbolic intent.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- The Mechanics of the Clap: Thal 'Phen Pa -->
    <div class="space-y-4 pt-4">
      <div class="flex items-center justify-between border-b border-border pb-2">
        <h3 class="text-xl sm:text-2xl font-display text-ink font-normal m-0">
          The Anatomy of the Questioner's Clap
        </h3>
        <span class="text-sm font-tibetan text-accent-secondary font-bold" lang="bo">ཐལ་འཕེན་པའི་བརྡ་དོན།</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {debateKinetics.map((item) => (
          <div class="surface-card p-5 rounded-xl border border-border flex flex-col justify-between hover-lift">
            <div class="space-y-2">
              <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider block">
                {item.step}
              </span>
              <h4 class="text-base font-display font-bold text-ink m-0">
                {item.symbol}
              </h4>
              <span class="text-xs font-tibetan text-accent-secondary font-bold block mt-1" lang="bo">
                {item.tibetan}
              </span>
              <p class="text-xs text-muted font-serif leading-relaxed m-0 pt-1">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Glimpse 03: The Monastic Hearth & Nourishment -->
  <section class="space-y-8 scroll-mt-[calc(var(--header-h)+4rem)]" id="kitchen-hearth">
    <ChapterHeader
      chapter="Glimpse 03"
      title="The Monastic Hearth: Butter Tea & Sustenance"
      tibetanTitle="ཇ་ཁང་དང་གསོལ་ཚིགས། དགེ་འདུན་པའི་ཞལ་ལག"
      lede="In the crisp Himalayan climate of Shimla, nourishment is an essential communal rhythm. The monastic kitchen cauldrons bubble from 4:30 AM, warming cold mornings and sustaining hours of intense contemplative study."
    />

    <!-- The 3 Pillars of Monastic Food -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {monasticFlavors.map((item) => (
        <PillarCard
          title={item.title}
          tibetanTitle={item.tibetanTitle}
          kicker={item.kicker}
          accent={item.accent}
          description={item.description}
        />
      ))}
    </div>

    <!-- The Ja Ma and Assembly Tea Service -->
    <div class="surface-card p-6 sm:p-8 rounded-2xl border border-border space-y-4">
      <div class="flex items-center gap-3">
        <LotusFlower class="w-5 h-5 text-accent shrink-0" />
        <h3 class="text-xl sm:text-2xl font-display text-ink font-normal m-0">
          The Craft of the Tea Master (Ja Ma)
        </h3>
        <span class="text-sm font-tibetan text-accent-secondary font-bold ml-auto" lang="bo">ཇ་མའི་ཕྱག་ལས།</span>
      </div>

      <p class="text-sm sm:text-base text-muted font-serif leading-relaxed m-0">
        In Tibetan monastic culture, the head cook (<em>ja ma</em>) holds a position of immense communal esteem. Preparing butter tea for dozens or hundreds of monks requires boiling compressed brick tea (<em>ja ril</em>) for hours until it yields a rich, dark concentrate (<em>ja dang</em>). This essence is churned with fresh butter, wholesome milk, and pure rock salt, achieving a velvety emulsion.
      </p>

      <p class="text-sm sm:text-base text-muted font-serif leading-relaxed m-0">
        During extensive prayer services, adolescent monks appointed as tea servers (<em>chab ril</em>) weave through the long assembly rows with heavy, long-spouted kettles (<em>tib ril</em>). Monks draw polished wooden birch-burl bowls (<em>phor pa</em>) from the deep folds of their maroon robes, blowing back the shimmering golden film before sipping. Leaving a half-filled bowl signals readiness for continuous, warm hospitality.
      </p>
    </div>
  </section>

  <!-- Glimpse 04: Sacred Arts & Dzamthang Heritage -->
  <section class="space-y-8 scroll-mt-[calc(var(--header-h)+4rem)]" id="sacred-crafts">
    <ChapterHeader
      chapter="Glimpse 04"
      title="Sacred Crafts: Woodblock Carving & Mineral Pigments"
      tibetanTitle="དགོན་པའི་བཟོ་རིག་དང་འཛམ་ཐང་གི་སྲོལ་རྒྱུན།"
      lede="The physical preservation of the Jonang lineage survived centuries in the isolated mountain valleys of Amdo Dzamthang through an extraordinary tradition of artisanal woodblock printing, natural mineral thangkas, and sacred geometry."
    />

    <!-- Crafts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sacredCrafts.map((craft) => (
        <PillarCard
          title={craft.title}
          tibetanTitle={craft.tibetanTitle}
          kicker={craft.kicker}
          accent={craft.accent}
          description={craft.description}
        />
      ))}
    </div>

    <!-- Visual Feature & Mineral Pigments Table -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pt-2">
      <div class="lg:col-span-5">
        <div class="surface-card overflow-hidden rounded-2xl border border-border shadow-card">
          <Image
            src={taranathaThangka}
            alt="Traditional Dzamthang school thangka painting of Jetsun Tāranātha"
