            height={360}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div class="md:col-span-7 space-y-3 font-serif">
        <span class="text-xs font-mono uppercase tracking-wider text-accent font-bold block">
          The Novice Journey (Grwa Chung)
        </span>
        <h3 class="text-xl sm:text-2xl font-display text-ink font-normal m-0">
          The Chalked Slate (Byang Shing)
        </h3>
        <p class="text-sm text-muted leading-relaxed m-0">
          Young boys entering the monastery—often arriving from remote Himalayan borderlands like Spiti, Kinnaur, Ladakh, and Nepal—begin their education with a planed pine board (<em>byang shing</em>) dusted in white chalk. With split-bamboo pens dipped in soot-ink, they master the thirty Tibetan consonants.
        </p>
        <p class="text-sm text-muted leading-relaxed m-0">
          When an error is made, the boy simply licks his thumb or rubs a smooth river pebble over the board to refresh the slate. Between grammar lessons, novices tuck up their maroon robes for impromptu cricket or marble games in the courtyard, balancing sacred devotion with the playful innocence of youth.
        </p>
      </div>
    </div>

    <!-- Authentic Proverbs Grid -->
    <div class="space-y-4 pt-4">
      <div class="flex items-center justify-between border-b border-border pb-2">
