---
interface Props {
  videoId: string;
  title: string;
  thumbnailUrl?: string;
  aspectRatio?: string; // e.g. "16/9", "4/3"
  badge?: string;
  channelName?: string;
  channelUrl?: string;
  duration?: string;
  class?: string;
}

const {
  videoId,
  title,
  thumbnailUrl = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`,
  aspectRatio = "16/9",
  badge = "Featured Video",
  channelName,
  channelUrl,
  duration,
  class: className = "",
} = Astro.props;
---

<youtube-embed
  data-video-id={videoId}
  data-title={title}
  class={`group/yt relative block w-full overflow-hidden rounded-2xl md:rounded-3xl border-2 border-gold/40 bg-surface shadow-2xl transition-all duration-500 hover:border-gold hover:shadow-[0_20px_50px_rgba(112,16,35,0.22)] ${className}`}
  style={`aspect-ratio: ${aspectRatio};`}
>
  <!-- Ambient Candlelight / Altar Glow Halo -->
  <div class="pointer-events-none absolute -inset-4 bg-gradient-to-tr from-accent/20 via-gold/15 to-transparent opacity-0 blur-2xl transition-opacity duration-700 group-hover/yt:opacity-100 -z-10" aria-hidden="true"></div>

  <!-- Facade Container (Shown initially) -->
  <div class="yt-facade absolute inset-0 flex flex-col justify-between p-4 sm:p-6 md:p-8 cursor-pointer z-10 select-none" tabindex="0" role="button" aria-label={`Play video: ${title}`}>
    <!-- Thumbnail Image with Fallback -->
    <div class="absolute inset-0 -z-10 overflow-hidden bg-ink">
      <img
        src={thumbnailUrl}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover/yt:scale-105"
        loading="lazy"
        decoding="async"
        onerror={`this.onerror=null; this.src='https://i.ytimg.com/vi/${videoId}/hqdefault.jpg';`}
      />
      <!-- Dramatic Monastic Gradient Vignette -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/60 transition-opacity duration-500 group-hover/yt:via-black/25"></div>
      <!-- Subtle Canvas Texture / Scanline -->
      <div class="absolute inset-0 opacity-15 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(0,0,0,0.8)_100%)] pointer-events-none"></div>
    </div>

    <!-- Top Metadata Bar -->
    <div class="relative z-10 flex items-start justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-accent/90 border border-gold/40 px-3 py-1 text-caption font-mono font-semibold uppercase tracking-wider text-white shadow-md backdrop-blur-md">
          <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
          {badge}
        </span>
        {channelName && (
          channelUrl ? (
            <a
              href={channelUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 rounded-full bg-black/50 hover:bg-black/70 border border-white/20 px-3 py-1 text-caption font-sans text-white/90 backdrop-blur-md transition-colors"
            >
              <span>{channelName}</span>
              <span class="text-[9px] text-gold">↗</span>
            </a>
          ) : (
            <span class="inline-flex items-center gap-1 rounded-full bg-black/50 border border-white/20 px-3 py-1 text-caption font-sans text-white/90 backdrop-blur-md">
              {channelName}
            </span>
          )
        )}
      </div>

      <div class="hidden sm:flex items-center gap-1.5 text-xs font-mono font-semibold text-gold/90 bg-black/40 px-2.5 py-1 rounded-lg border border-gold/30 backdrop-blur-md">
        <span class="text-caption-xs">HD</span>
        <span>1080p</span>
      </div>
    </div>

    <!-- Center Play Button with Sacred Lotus Mandala Aura -->
    <button
      type="button"
      class="yt-play-btn relative mx-auto my-auto flex items-center justify-center rounded-full transition-all duration-500 group-hover/yt:scale-110 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-gold/60 cursor-pointer"
      aria-label={`Play video: ${title}`}
      tabindex="-1"
    >
      <!-- Outer Pulsing Glow Ring -->
      <div class="absolute -inset-3 sm:-inset-4 rounded-full border border-gold/40 bg-gold/15 blur-sm transition-all duration-500 group-hover/yt:bg-gold/25 group-hover/yt:-inset-5"></div>
      
      <!-- Middle Ornate Ring -->
      <div class="relative flex h-14 w-14 sm:h-18 sm:w-18 md:h-22 md:w-22 items-center justify-center rounded-full bg-gradient-to-br from-gold via-accent-secondary to-accent p-0.5 shadow-[0_0_30px_rgba(198,127,27,0.6)]">
        <!-- Inner Disc -->
        <div class="flex h-full w-full items-center justify-center rounded-full bg-ink/90 border border-white/30 backdrop-blur-md transition-colors duration-300 group-hover/yt:bg-accent/85">
          <!-- Play Triangle SVG -->
          <svg
            class="h-6 w-6 sm:h-8 sm:w-8 md:h-9 md:w-9 translate-x-0.5 text-gold transition-colors duration-300 group-hover/yt:text-white drop-shadow-md"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>
    </button>

    <!-- Bottom Title & Prompt Bar -->
    <div class="relative z-10 flex flex-col sm:flex-row sm:items-end justify-between gap-3 pt-2">
      <div class="space-y-1 max-w-xl">
        <h3 class="font-display text-base sm:text-lg md:text-xl font-bold text-white leading-snug drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)] m-0">
          {title}
        </h3>
        <p class="text-xs text-white/80 font-sans line-clamp-1 m-0">
          Click to play documentary
        </p>
      </div>

      {duration && (
        <div class="self-start sm:self-end shrink-0">
          <span class="inline-flex items-center gap-1.5 rounded-lg bg-black/60 border border-white/20 px-2.5 py-1 text-xs font-mono font-semibold text-white/90 backdrop-blur-md shadow-sm">
            <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {duration}
          </span>
        </div>
      )}
    </div>

    <!-- Ornate Double-Bezel Corner Accents -->
    <div class="pointer-events-none absolute inset-2 rounded-xl md:rounded-2xl border border-gold/20"></div>
    <div class="pointer-events-none absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-gold/70"></div>
    <div class="pointer-events-none absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-gold/70"></div>
    <div class="pointer-events-none absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-gold/70"></div>
    <div class="pointer-events-none absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-gold/70"></div>
  </div>

  <!-- Video Iframe Container (Populated on click) -->
  <div class="yt-player-container absolute inset-0 hidden z-20 bg-black"></div>
</youtube-embed>

<script>
  class YouTubeEmbed extends HTMLElement {
    connectedCallback() {
      const facade = this.querySelector<HTMLElement>(".yt-facade");
      const playerContainer = this.querySelector<HTMLElement>(".yt-player-container");
      const videoId = this.dataset.videoId;
      const title = this.dataset.title || "YouTube Video";

      if (!facade || !playerContainer || !videoId) return;

      const loadVideo = () => {
        if (playerContainer.querySelector("iframe")) return;

        const iframe = document.createElement("iframe");
        iframe.setAttribute("src", `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1`);
        iframe.setAttribute("title", title);
        iframe.setAttribute("frameborder", "0");
        iframe.setAttribute("allow", "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share");
        iframe.setAttribute("referrerpolicy", "strict-origin-when-cross-origin");
        iframe.setAttribute("allowfullscreen", "true");
        iframe.className = "w-full h-full border-0 absolute inset-0";

        playerContainer.appendChild(iframe);
        playerContainer.classList.remove("hidden");
        facade.classList.add("hidden");
      };

      facade.addEventListener("click", (e: MouseEvent) => {
        if ((e.target as HTMLElement)?.closest("a")) return;
        loadVideo();
      });

      facade.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          loadVideo();
        }
      });
    }
  }

  if (!customElements.get("youtube-embed")) {
    customElements.define("youtube-embed", YouTubeEmbed);
  }
</script>
