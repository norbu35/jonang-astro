---
import { Image } from "astro:assets";
import type { Footer } from "../../payload-types";

import NewsLetter from "./NewsLetter.astro";
import Quote from "./Quote.astro";

import kalachakraIcon from "../assets/icons/kalachakra-icon.webp";
import kalachakraMantra from "../assets/icons/kalachakra-mantra.svg";

const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/footer`);
const data: Footer = await res.json();
---

<Quote />
<NewsLetter />
<footer class="relative flex flex-col items-center gap-10 border-t border-border/40 bg-[rgb(99,20,20)] px-6 pb-6 pt-10 text-surface before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:via-saffron/70 before:to-transparent before:content-['']">
  <div class="mx-auto w-full max-w-6xl grid gap-10 text-sm text-surface/80 md:grid-cols-[1.2fr_1fr] md:items-start">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-surface/70">
        Blessing
      </div>
      <div class="flex flex-row gap-4">
        <Image class="mx-auto" src={kalachakraIcon} alt="" width="125" />
        <Image class="mx-auto invert" src={kalachakraMantra} alt="" height="150" />
      </div>
      <div class="max-w-[420px] text-center text-sm italic text-surface/80 md:text-left">
        <div class="mb-2 text-xs font-bold not-italic text-surface">
          OṂ HA KṢA MA LA VA RA YAM SVĀHĀ
        </div>
        {data.blessing}
      </div>
    </div>

    <div class="flex flex-col items-center gap-6 md:items-start">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-surface/70">
        Contact
      </div>
      <address class="not-italic text-base text-surface/85">
        <div class="leading-relaxed" set:html={data.addressHtml} />
        <div class="mt-4 leading-relaxed text-surface">
          {data.email}<br />
          {data.phone}
        </div>
      </address>
      <button class="secondary-button">
        <a href="/donate">Donate</a>
      </button>
    </div>
  </div>

  <div class="text-center text-sm text-surface/80 xl:mt-8">
    <div>
      <a href="/sitemap" class="transition-colors hover:text-gold">Sitemap</a>
      <span class="mx-2">|</span>
      <a href="#" class="transition-colors hover:text-gold">Cookie & Privacy Policy</a>
    </div>
    <div class="mt-4 text-xs text-surface/60">
      &copy 2024 Jonang Monastery | made by norbu
    </div>
  </div>
</footer>
