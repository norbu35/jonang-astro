---
import { Image } from "astro:assets";
import type { Footer } from "../../payload-types";
import { FOOTER_NAVIGATION } from "../data/navigation";
import { STATIC_PAGE_PATHS } from "../data/staticPages";

import Quote from "./Quote.astro";

import kalachakraIcon from "../assets/icons/kalachakra-icon.webp";
import kalachakraMantra from "../assets/icons/kalachakra-mantra.svg";

const res = await fetch(`${import.meta.env.CMS_API_URL}/globals/footer`);
const data: Footer = await res.json();
---

<Quote />
<footer class="relative flex flex-col items-center gap-10 bg-accent px-6 pb-6 pt-10 text-surface before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:via-saffron/50 before:to-transparent before:content-['']">
  <div class="mx-auto grid w-full max-w-6xl gap-10 text-sm text-surface/80 md:grid-cols-[1.1fr_1fr_0.95fr] md:items-start">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-surface/70">
        Blessing
      </div>
      <div class="flex flex-row gap-4">
        <Image class="mx-auto" src={kalachakraIcon} alt="" width="125" />
        <Image class="mx-auto invert" src={kalachakraMantra} alt="" height="150" />
      </div>
      <div class="max-w-[420px] text-center text-sm italic text-surface/80 md:text-left">
        <div class="mb-2 text-xs font-bold not-italic text-surface">
          OṂ HA KṢA MA LA VA RA YAM SVĀHĀ
        </div>
        {data.blessing}
      </div>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      {FOOTER_NAVIGATION.map((section) => (
        <div class="flex flex-col items-center gap-4 md:items-start">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-surface/70">
            {section.heading}
          </div>
          <nav aria-label={section.heading} class="w-full">
            <ul class="m-0 flex list-none flex-col gap-3 text-sm">
              {section.links.map((link) => (
                <li class="m-0 list-none">
                  <a class="transition-colors hover:text-gold" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      ))}
    </div>

    <div class="flex flex-col items-center gap-6 md:items-start">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-surface/70">
        Contact
      </div>
      <address class="not-italic text-base text-surface/85">
        <div class="leading-relaxed" set:html={data.addressHtml} />
        <div class="mt-4 leading-relaxed text-surface">
          {data.email}<br />
          {data.phone}
        </div>
      </address>
      <a
        href={STATIC_PAGE_PATHS.donate}
        class="inline-flex items-center justify-center rounded-lg bg-surface px-6 py-2.5 text-sm font-semibold uppercase tracking-[0.08em] text-accent border border-gold/40 shadow-sm transition-all duration-300 hover:bg-gold hover:text-ink hover:border-gold hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
      >
        Donate
      </a>
    </div>
  </div>

  <div class="text-center text-sm text-surface/80 xl:mt-8 space-y-3">
    <div class="flex items-center justify-center gap-4 text-xs font-semibold uppercase tracking-wider text-surface/70">
      <a href={STATIC_PAGE_PATHS.sitemap} class="transition-colors hover:text-gold">Sitemap</a>
      <span>·</span>
      <a href={STATIC_PAGE_PATHS.donate} class="transition-colors hover:text-gold">Support Monks</a>
      <span>·</span>
      <a href={STATIC_PAGE_PATHS.aboutUs} class="transition-colors hover:text-gold">About Sanjauli</a>
    </div>
    <div class="mt-4 text-xs text-surface/70 space-y-1">
      <div>
        &copy; {new Date().getFullYear()} Main Jonang Takten Phuntsok Choeling Tibetan Buddhist Monastery. All rights reserved.
      </div>
      <div class="text-[11px] text-surface/50">
        Registered Society under the Societies Registration Act · Sanjauli, Shimla, Himachal Pradesh 171006, India
      </div>
    </div>
  </div>
</footer>
