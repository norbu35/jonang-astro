---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  img: ImageMetadata;
  name: string;
  roles: string[];
  bio: string;
  id: string;
  portraitAlt?: string;
}

const { img, name, roles, bio, id, portraitAlt } = Astro.props;
---

<bio-card
  data-id={id}
  class="surface-card group mx-auto mb-10 sm:mb-16 md:mb-24 flex w-full flex-col items-start gap-8 sm:gap-10 p-6 sm:p-8 md:p-10 lg:p-12 text-left md:grid md:grid-cols-12 md:gap-10 lg:gap-14 hover-lift rounded-2xl md:rounded-3xl border border-border bg-surface shadow-card scroll-mt-24 overflow-hidden"
  id={id}
>
  <!-- Large Prominent Master Portrait Column (5 of 12 cols on desktop) -->
  <div class="md:col-span-5 lg:col-span-5 w-full flex flex-col items-center">
    <div class="relative w-full aspect-[3/4] sm:aspect-[4/5] md:aspect-[3/4] rounded-2xl overflow-hidden bg-surface-subtle shadow-md border border-gold/30 group-hover:border-gold/60 transition-colors">
      <Image
        src={img}
        alt={portraitAlt || `Portrait of ${name}`}
        width={900}
        height={1200}
        class="h-full w-full object-cover object-top sm:object-center transition-transform duration-700 ease-out group-hover:scale-103"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none opacity-30 group-hover:opacity-15 transition-opacity"></div>
    </div>
  </div>
  
  <!-- Biography & Lineage Details Column (7 of 12 cols on desktop) -->
  <div class="md:col-span-7 lg:col-span-7 w-full flex flex-col justify-start space-y-5 md:pt-1">
    <div>
      <h2 class="mt-0! mb-4 sm:mb-6 text-center font-display text-3xl sm:text-4xl md:text-5xl lg:text-[3.75rem] font-medium text-accent-secondary md:text-left tracking-tight leading-[1.1] drop-shadow-xs break-words">
        {name}
      </h2>
      
      <div class="flex flex-wrap justify-center gap-2 md:justify-start pt-1">
        {roles.map((role) => (
          <span class="badge badge-saffron text-xs font-semibold uppercase tracking-wider">{role}</span>
        ))}
      </div>
    </div>

    <!-- Biography Content -->
    <div class="space-y-4 pt-2 text-left text-sm sm:text-base text-ink/90 leading-relaxed font-serif">
      <div set:html={bio} class="rich-text space-y-4" />
    </div>
  </div>
</bio-card>

<script>
  class BioCard extends HTMLElement {
    connectedCallback() {
      const toggleButton = this.querySelector<HTMLButtonElement>(".bio-toggle");
      const bioContent = this.querySelector<HTMLElement>(".bio-content");
      const buttonText = this.querySelector<HTMLElement>(".button-text");
      const buttonIcon = this.querySelector<HTMLElement>(".button-icon");

      if (!toggleButton || !bioContent) return;

      let isExpanded = false;

      const setExpanded = (expanded: boolean) => {
        isExpanded = expanded;
        toggleButton.setAttribute("aria-expanded", expanded ? "true" : "false");
        bioContent.setAttribute("data-expanded", expanded ? "true" : "false");

        if (expanded) {
          bioContent.classList.remove("grid-rows-[0fr]", "opacity-0", "pointer-events-none");
          bioContent.classList.add("grid-rows-[1fr]", "opacity-100", "pointer-events-auto");
          if (buttonText) buttonText.textContent = "Hide Biography";
          if (buttonIcon) buttonIcon.classList.add("rotate-180");
        } else {
          bioContent.classList.remove("grid-rows-[1fr]", "opacity-100", "pointer-events-auto");
          bioContent.classList.add("grid-rows-[0fr]", "opacity-0", "pointer-events-none");
          if (buttonText) buttonText.textContent = "Show Biography";
          if (buttonIcon) buttonIcon.classList.remove("rotate-180");
        }
      };

      toggleButton.addEventListener("click", () => {
        setExpanded(!isExpanded);
      });

      // Expand automatically if linked directly by hash ID
      const cardId = this.getAttribute("data-id");
      if (cardId && window.location.hash === `#${cardId}`) {
        setExpanded(true);
      }
    }
  }

  if (!customElements.get("bio-card")) {
    customElements.define("bio-card", BioCard);
  }
</script>
