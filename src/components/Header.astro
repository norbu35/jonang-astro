---
import { PRIMARY_NAVIGATION } from "../data/navigation";
import ThemeToggle from "./ThemeToggle.astro";
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => pathname === href;
---

<header id="site-header" class="site-header">
  <div class="header-inner">
    <a href="/" class="header-brand" aria-label="Jonang Takten Phuntsok Choeling home">
      <img src="/logo512x512.jpg" alt="" width="56" height="56" />
      <span>Jonang Takten<br />Phuntsok Choeling</span>
    </a>
    <nav class="desktop-navigation" aria-label="Primary navigation">
      <ul>
        {
          PRIMARY_NAVIGATION.map((item) => (
            <li>
              {item.sublinks?.length ? (
                <details class="header-dropdown">
                  <summary>{item.shortLabel ?? item.label}</summary>
                  <ul>
                    {item.sublinks.map((link) => (
                      <li>
                        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.shortLabel ?? item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <ThemeToggle id="themeToggleDesktop" />
      <a href="/donate" class="header-donate">Support</a>
    </nav>
    <div class="mobile-header-actions">
      <ThemeToggle id="themeToggleMobile" compact={true} />
      <button
        id="menuToggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobileMenuPanel"
        aria-label="Open navigation menu">Menu <span aria-hidden="true">☰</span></button
      >
    </div>
  </div>
  <dialog id="mobileMenuPanel" aria-label="Site navigation">
    <div class="menu-heading">
      <span>Explore Jonang</span><button
        id="menuClose"
        type="button"
        aria-label="Close navigation menu"
        autofocus>Close <span aria-hidden="true">×</span></button
      >
    </div>
    <nav aria-label="Mobile primary navigation">
      <ul>
        {
          PRIMARY_NAVIGATION.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
              {item.sublinks?.length && (
                <ul>
                  {item.sublinks
                    .filter((link) => link.href !== item.href)
                    .map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                      </li>
                    ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <a href="/donate" class="header-donate">Support the monastery</a>
  </dialog>
  <noscript>
    <style>
      .mobile-header-actions #menuToggle {
        display: none;
      }
    </style>
    <details class="fallback-navigation">
      <summary>Explore Jonang</summary><nav aria-label="Navigation without JavaScript">
        <ul>
          {
            PRIMARY_NAVIGATION.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
                {item.sublinks?.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </li>
            ))
          }<li><a href="/donate">Support the monastery</a></li>
        </ul>
      </nav>
    </details>
  </noscript>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 9999;
    background: #500c0e;
    color: #fff;
    border-bottom: 1px solid #9e6530;
  }
  .header-inner {
    width: min(100% - 2rem, 1160px);
    height: var(--header-h);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: #fff;
    text-decoration: none;
  }
  .header-brand img {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .header-brand span {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.15rem;
    line-height: 1.15;
  }
  .desktop-navigation {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-navigation > ul {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .desktop-navigation a,
  summary {
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }
  a {
    color: #fff;
  }
  .desktop-navigation a:hover,
  summary:hover {
    color: #fdbc2d;
  }
  .site-header :is(a, button, summary):focus-visible {
    outline: 2px solid #fdbc2d;
    outline-offset: 4px;
  }
  .header-dropdown {
    position: relative;
  }
  summary {
    cursor: pointer;
    padding-block: 0.75rem;
  }
  .header-dropdown > ul {
    position: absolute;
    top: 100%;
    left: 0;
    width: 15rem;
    padding: 0.5rem;
    background: #500c0e;
    border: 1px solid #9e6530;
    border-radius: 4px;
    box-shadow: 0 10px 30px #0004;
  }
  .header-dropdown a {
    display: block;
    padding: 0.7rem;
  }
  .header-dropdown a:hover {
    background: #6e1416;
  }
  .header-donate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.65rem 1rem;
    background: #fdbc2d;
    color: #190a0c;
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
  }
  .desktop-navigation .header-donate:hover {
    color: #190a0c;
    background: #ffd476;
  }
  .mobile-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  button {
    cursor: pointer;
    min-height: 44px;
    padding: 0.6rem 0.7rem;
    color: #fff;
    font-size: 0.8125rem;
    border: 1px solid #b17956;
    border-radius: 4px;
    background: transparent;
  }
  button span {
    margin-left: 0.4rem;
  }
  dialog {
    position: fixed;
    inset: 1rem;
    width: min(100% - 2rem, 32rem);
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1.5rem;
    border: 1px solid #b17956;
    border-radius: 6px;
    background: #500c0e;
    color: #fff;
    overflow-y: auto;
  }
  dialog::backdrop {
    background: #0009;
  }
  .menu-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #b17956;
    color: #fdbc2d;
  }
  dialog nav {
    margin-block: 1rem;
  }
  dialog nav a {
    display: block;
    padding: 0.65rem 0;
    font-size: 1rem;
    text-decoration: none;
  }
  dialog nav ul ul {
    padding-left: 1rem;
  }
  dialog nav ul ul a {
    font-size: 0.875rem;
    color: #f4dbcf;
  }
  dialog nav a:hover {
    text-decoration: underline;
  }
  .fallback-navigation {
    padding: 0.5rem 1rem;
    background: #500c0e;
    max-height: 75vh;
    overflow-y: auto;
  }
  .fallback-navigation a {
    display: block;
    padding: 0.5rem;
  }
  @media (min-width: 1280px) {
    .desktop-navigation {
      display: flex;
    }
    .mobile-header-actions,
    .fallback-navigation {
      display: none;
    }
  }
  @media (max-width: 359px) {
    .header-brand span {
      font-size: 0.9375rem;
    }
    .header-brand img {
      width: 2.75rem;
      height: 2.75rem;
    }
    .header-brand {
      gap: 0.5rem;
    }
    .header-inner {
      gap: 0.5rem;
    }
  }
</style>

<script>
  function initHeader() {
    const menu = document.querySelector<HTMLDialogElement>("#mobileMenuPanel");
    const opener = document.querySelector<HTMLButtonElement>("#menuToggle");
    if (!menu || !opener || menu.dataset.initialized) return;
    menu.dataset.initialized = "true";
    opener.addEventListener("click", () => {
      menu.showModal();
      opener.setAttribute("aria-expanded", "true");
      document.body.classList.add("stop-scrolling");
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      const controls = Array.from(
        menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")
      );
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
    const close = () => {
      if (menu.open) menu.close();
    };
    document.querySelector("#menuClose")?.addEventListener("click", close);
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) close();
      if (event.target === menu) {
        const rect = menu.getBoundingClientRect();
        if (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        )
          close();
      }
    });
    menu.addEventListener("close", () => {
      opener.setAttribute("aria-expanded", "false");
      document.body.classList.remove("stop-scrolling");
      if (opener.getClientRects().length) opener.focus();
    });
    window.matchMedia("(min-width: 1280px)").addEventListener("change", (event) => {
      if (event.matches) close();
    });
    document.addEventListener("astro:before-swap", close, { once: true });
    document.querySelectorAll<HTMLDetailsElement>(".header-dropdown").forEach((dropdown) => {
      dropdown.addEventListener("toggle", () => {
        if (dropdown.open)
          document.querySelectorAll<HTMLDetailsElement>(".header-dropdown").forEach((other) => {
            if (other !== dropdown) other.open = false;
          });
      });
      dropdown.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          dropdown.open = false;
          dropdown.querySelector("summary")?.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (!dropdown.contains(event.target as Node)) dropdown.open = false;
      });
    });
  }
  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>
