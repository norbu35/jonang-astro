---
import { PRIMARY_NAVIGATION } from "../data/navigation";
import { STATIC_PAGE_PATHS } from "../data/staticPages";

function hasSublinks(item: (typeof PRIMARY_NAVIGATION)[number]) {
  return Array.isArray(item.sublinks) && item.sublinks.length > 0;
}

function normalizePath(path: string) {
  return path.replace(/\/+$/, "") || "/";
}

const pathname = normalizePath(Astro.url.pathname);

function isActivePath(href?: string) {
  if (!href) return false;
  const target = normalizePath(href);
  return pathname === target || (target !== "/" && pathname.startsWith(`${target}/`));
}

function isActiveItem(item: (typeof PRIMARY_NAVIGATION)[number]) {
  if (isActivePath(item.href)) return true;
  return item.sublinks?.some((sublink) => isActivePath(sublink.href)) ?? false;
}
---

<header
  id="site-header"
  class="fixed top-0 z-[9999] w-full bg-surface/70 backdrop-blur-xl"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(700px_240px_at_10%_-30%,rgb(var(--accent-soft)_/_0.22),transparent_60%)]"
    aria-hidden="true"
  ></div>
  <div
    class="container relative flex h-16 items-center justify-between gap-4 md:h-20 lg:h-24"
  >
    <a
      href="/"
      class="focus flex items-center gap-3"
      aria-label="Homepage"
    >
      <div
        class="flex h-12 w-12 items-center justify-center rounded-full bg-white/85 p-1.5 shadow-soft ring-1 ring-border/20 md:h-14 md:w-14 lg:h-16 lg:w-16"
        aria-hidden="true"
      >
        <img
          src="/logo512x512.jpg"
          alt="Jonang Monastery logo"
          width="512"
          height="512"
          class="w-[80%]"
          loading="eager"
          decoding="async"
        />
      </div>
      <div
        class="font-siteTitle text-[16px] leading-5 text-ink tracking-[0.03em] sm:text-[18px] sm:leading-6 lg:text-[22px] lg:leading-7"
        aria-hidden="true"
      >
        Jonang Takten<br />Phuntsok Choeling
      </div>
    </a>

    <nav
      class="hidden items-center gap-3 lg:flex"
      aria-label="Primary"
    >
      <ul class="nav-surface flex list-none items-center gap-1 m-0">
        {PRIMARY_NAVIGATION.map((item) => (
          <li class="group relative list-none m-0">
            {item.href ? (
              <a
                href={item.href}
                class:list={[
                  "nav-link flex items-center gap-2",
                  isActiveItem(item) && "nav-link-active",
                ]}
                aria-current={isActivePath(item.href) ? "page" : undefined}
              >
                {item.shortLabel ?? item.label}
                {hasSublinks(item) && (
                  <svg
                    class="h-3 w-3 text-ink/60 transition-transform duration-300 group-hover:rotate-180"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      d="M5.5 7.5L10 12l4.5-4.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </a>
            ) : (
              <button
                type="button"
                class="nav-link flex items-center gap-2"
                aria-label={item.label}
              >
                {item.shortLabel ?? item.label}
                {hasSublinks(item) && (
                  <svg
                    class="h-3 w-3 text-ink/60 transition-transform duration-300 group-hover:rotate-180"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      d="M5.5 7.5L10 12l4.5-4.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </button>
            )}
            {hasSublinks(item) && (
              <div
                class="absolute left-1/2 top-full z-[1000] w-[min(22rem,90vw)] -translate-x-1/2 translate-y-2 opacity-0 pointer-events-none pt-4 transition-all duration-200 ease-out group-hover:translate-y-0 group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:opacity-100 group-focus-within:pointer-events-auto"
              >
                <div class="surface-card px-6 py-6">
                  <ul class="flex list-none flex-col gap-3 text-sm m-0">
                    {item.sublinks?.map((sublink) => (
                      <li class="list-none m-0">
                        {sublink ? (
                          <a
                            href={sublink.href}
                            class:list={[
                              "nav-link w-full justify-start text-sm",
                              isActivePath(sublink.href) && "nav-link-active",
                            ]}
                            aria-current={isActivePath(sublink.href) ? "page" : undefined}
                          >
                            {sublink.label}
                          </a>
                        ) : null}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
      <a href={STATIC_PAGE_PATHS.donate} class="primary-button ml-2 shadow-card">Donate</a>
    </nav>

    <button
      id="menuToggle"
      class="focus relative flex h-11 w-11 items-center justify-center rounded-full bg-white/72 text-ink shadow-soft ring-1 ring-border/25 lg:hidden"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobileMenuPanel"
      type="button"
    >
      <span class="sr-only">Open menu</span>
      <div class="flex h-[18px] w-[22px] flex-col justify-between">
        <span class="block h-[2px] w-full rounded-full bg-ink"></span>
        <span class="block h-[2px] w-full rounded-full bg-ink"></span>
        <span class="block h-[2px] w-full rounded-full bg-ink"></span>
      </div>
    </button>
  </div>

  <div class="lg:hidden">
    <div
      id="mobileMenuOverlay"
      data-open="false"
      class="fixed inset-0 bg-ink/35 opacity-0 pointer-events-none backdrop-blur-sm transition-opacity data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto"
    ></div>
    <div
      id="mobileMenuPanel"
      data-open="false"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Site navigation"
      class="fixed left-3 right-3 top-[4.5rem] max-h-[80vh] overflow-y-auto rounded-3xl bg-white/94 px-6 py-7 shadow-card ring-1 ring-border/20 opacity-0 pointer-events-none translate-y-3 transition-all duration-200 data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0 sm:left-6 sm:right-6"
    >
      <nav aria-label="Mobile primary" class="flex flex-col gap-6">
        <ul class="flex list-none flex-col gap-4 text-lg text-ink m-0">
          {PRIMARY_NAVIGATION.map((item) => (
            <li class="list-none m-0">
              {item.href ? (
                <a
                  href={item.href}
                  class:list={[
                    "block rounded-2xl px-4 py-3 font-semibold text-ink transition-colors hover:bg-surface-muted/80",
                    isActiveItem(item) && "bg-surface-muted/80",
                  ]}
                  aria-current={isActivePath(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <span class="block rounded-2xl px-4 py-3 font-semibold text-ink">
                  {item.label}
                </span>
              )}
              {hasSublinks(item) && (
                <ul class="mt-2 flex list-none flex-col gap-2 pl-4 text-base text-ink/70 m-0">
                  {item.sublinks?.map((sublink) => (
                    <li class="list-none m-0">
                      {sublink ? (
                        <a
                          href={sublink.href}
                          class:list={[
                            "block rounded-xl px-3 py-2 transition-colors hover:bg-surface-muted/80",
                            isActivePath(sublink.href) && "bg-surface-muted/80 text-ink",
                          ]}
                          aria-current={isActivePath(sublink.href) ? "page" : undefined}
                        >
                          {sublink.label}
                        </a>
                      ) : null}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <a href={STATIC_PAGE_PATHS.donate} class="primary-button w-full text-center">Donate</a>
      </nav>
    </div>
  </div>
</header>

<script>
  const menuButton = document.querySelector("#menuToggle");
  const menuPanel = document.querySelector("#mobileMenuPanel");
  const menuOverlay = document.querySelector("#mobileMenuOverlay");

  function setMenuOpen(isOpen: boolean) {
    if (!menuButton || !menuPanel || !menuOverlay) return;

    menuButton.setAttribute("aria-expanded", isOpen ? "true" : "false");
    menuPanel.setAttribute("data-open", isOpen ? "true" : "false");
    menuPanel.setAttribute("aria-hidden", isOpen ? "false" : "true");
    menuOverlay.setAttribute("data-open", isOpen ? "true" : "false");
    document.body.classList.toggle("stop-scrolling", isOpen);
  }

  menuButton?.addEventListener("click", () => {
    const isOpen = menuPanel?.getAttribute("data-open") === "true";
    setMenuOpen(!isOpen);
  });

  menuOverlay?.addEventListener("click", () => setMenuOpen(false));

  menuPanel?.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof HTMLElement && target.closest("a")) {
      setMenuOpen(false);
    }
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMenuOpen(false);
    }
  });
</script>
