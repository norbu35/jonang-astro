---
import SectionTitle from "./SectionTitle.astro";
---

<section class="section-padding shadow-inner relative overflow-hidden bg-white">
  <SectionTitle title="Newsletter" iconColor="saffron" titleColor="ink" />
  <p class="text-ink/80">
    Want to receive news, tidbits, philosophy & more?<br /> Sign up for our newsletter!
  </p>
  <form
    action=""
    class="mx-auto mt-10 max-w-md p-8 rounded-3xl bg-surface-muted/50 ring-1 ring-ink/5 shadow-md hover-lift text-left"
  >
    <div class="mb-4">
      <label for="name" class="block text-sm font-semibold text-muted">Name</label>
      <input
        type="text"
        name="name"
        id="name"
        class="mt-2 w-full rounded-md border border-border/30 bg-surface/80 px-3 py-2 text-ink focus:border-accent/50 focus:outline-none focus:ring-2 focus:ring-accent/20"
      />
    </div>
    <div class="mb-4">
      <label for="email" class="block text-sm font-semibold text-muted">Email</label>
      <input
        type="text"
        name="email"
        id="email"
        class="mt-2 w-full rounded-md border border-border/30 bg-surface/80 px-3 py-2 text-ink focus:border-accent/50 focus:outline-none focus:ring-2 focus:ring-accent/20"
      />
    </div>
    <button type="submit" class="primary-button mt-4 w-full">Sign Up</button>
  </form>
</section>
