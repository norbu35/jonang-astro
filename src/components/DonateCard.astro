---
import { Image } from "astro:assets";
import type { Media } from "../../payload-types";

interface Props {
  headline: string;
  goal: number;
  description: string;
  img: string | Media;
}

const { headline, goal, description, img } = Astro.props;
---

<div
  class="mx-auto flex max-w-md flex-col items-center gap-4 p-6 text-ink surface-card surface-card-hover"
>
  <h3 class="text-center font-display text-2xl font-semibold md:text-3xl">
    {headline}
  </h3>
  {
    typeof img !== "string" ? (
      <div class="w-full overflow-hidden rounded-xl aspect-[4/3] bg-surface-muted/70">
        <Image
          src={img.sizes!.thumbnail!.url!}
          alt={img!.alt!}
          class="h-full w-full object-cover"
          width={img.sizes!.thumbnail!.width!}
          height={img.sizes!.thumbnail!.height!}
        />
      </div>
    ) : (
      <div>Error fetching image</div>
    )
  }
  <p class="text-sm text-muted">{description}</p>
  <div class="text-lg font-semibold text-ink">
    Goal: <span class="text-accent">${goal}</span>
  </div>
  <button class="secondary-button mt-2">
    <a href="/donate">Donate</a>
  </button>
</div>
