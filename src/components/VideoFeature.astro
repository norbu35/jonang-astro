---
import YouTubeEmbed from "./YouTubeEmbed.astro";
import Dharmachakra from "./icons/Dharmachakra.astro";
import EndlessKnot from "./icons/EndlessKnot.astro";

export interface KeyTheme {
  num: string;
  title: string;
  desc: string;
}

interface Props {
  videoId?: string;
  title?: string;
  tibetanTitle?: string;
  subtitle?: string;
  summary?: string;
  badge?: string;
  channelName?: string;
  channelUrl?: string;
  duration?: string;
  keyThemes?: KeyTheme[];
  actionHref?: string;
  actionLabel?: string;
  class?: string;
  id?: string;
}

const {
  videoId = "PKFl2_WiUd0",
  title = "Dolpopa Biography Part 1: Early Realization & Jomonang",
  tibetanTitle = "༄༅། །ཀུན་མཁྱེན་དོལ་པོ་པ་ཤེས་རབ་རྒྱལ་མཚན་གྱི་རྣམ་ཐར། །",
  subtitle = "The Life of Kunkhyen Dölpopa & the Codification of Shentong Madhyamaka",
  summary = "A biographical documentary chronicling the life of Kunkhyen Dölpopa Sherab Gyaltsen (1292–1361). From his early training in Dölpo through scholastic mastery at Sakya to his realization at Jomonang, this documentary details his formulation of the definitive Shentong view and the construction of the Great Kumbum.",
  badge = "Biographical Documentary",
  channelName = "Jonang Dharma Volunteers",
  channelUrl = "https://www.youtube.com/@JonangDharma",
  duration = "Part 1 · Documentary",
  keyThemes,
  actionHref,
  actionLabel,
  class: className = "",
  id = "video-feature",
} = Astro.props;

const hasThemes = keyThemes && keyThemes.length > 0;
---

<section
  class={`surface-card overflow-hidden rounded-2xl md:rounded-3xl border border-border/80 p-5 sm:p-8 md:p-10 lg:p-12 shadow-card bg-surface/95 relative group space-y-8 ${className}`}
  id={id}
>
  <!-- Ambient Altar Glow & Mandala Watermark -->
  <div
    class="pointer-events-none absolute -top-32 right-1/4 w-[500px] h-[500px] bg-gold/10 blur-3xl rounded-full"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 left-1/4 w-[500px] h-[500px] bg-accent/8 blur-3xl rounded-full"
    aria-hidden="true"
  >
  </div>

  <!-- Header & Inscription Banner -->
  <div
    class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border/70 pb-6 relative z-10"
  >
    <div class="max-w-3xl">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="badge badge-crimson text-xs font-mono">
          <span class="badge-dot"></span>
          {badge}
        </span>
        {
          tibetanTitle && (
            <span class="text-xs font-tibetan text-accent font-bold pt-0.5 leading-[1.6]">{tibetanTitle}</span>
          )
        }
      </div>
      <h3
        class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight mt-0 mb-3"
      >
        {title}
      </h3>
      {
        subtitle && (
          <p class="text-xs sm:text-sm text-accent-secondary font-semibold uppercase tracking-wider m-0">
            {subtitle}
          </p>
        )
      }
    </div>

    <div class="hidden lg:flex items-center gap-2 shrink-0">
      <EndlessKnot size={36} class="text-gold/60" />
    </div>
  </div>

  <!-- Media Presentation: Either 2-Column Split OR Grand Full-Width Cinema -->
  {
    hasThemes ? (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start relative z-10">
        {/* Left Stage: The Interactive YouTube Player */}
        <div class="lg:col-span-7 space-y-3">
          <YouTubeEmbed
            videoId={videoId}
            title={title}
            badge={badge}
            channelName={channelName}
            channelUrl={channelUrl}
            duration={duration}
          />

          {/* Video Caption & Source Note */}
          <div class="flex flex-wrap items-center justify-between gap-2 px-1 text-xs text-muted">
            {channelName && (
              <span class="flex items-center gap-1.5">
                <Dharmachakra class="w-3.5 h-3.5 text-accent-secondary" />
                <span>
                  Produced by <strong>{channelName}</strong>
                </span>
              </span>
            )}
            <a
              href={`https://www.youtube.com/watch?v=${videoId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:text-accent-hover font-semibold inline-flex items-center gap-1 transition-colors"
            >
              <span>Watch on YouTube</span>
              <span class="text-caption-xs">↗</span>
            </a>
          </div>
        </div>

        {/* Right Stage: Narrative Context & Documentary Chapters */}
        <div class="lg:col-span-5 flex flex-col justify-between gap-6">
          <div class="flex flex-col gap-4">
            {summary && (
              <div class="callout bg-surface-subtle/80 p-5 sm:p-6 rounded-2xl shadow-xs flex flex-col gap-2">
                <span class="text-caption font-mono font-bold uppercase tracking-wider text-accent block">
                  Featured Documentary Overview
                </span>
                <p class="text-xs sm:text-sm text-ink/90 leading-relaxed m-0 font-sans">
                  {summary}
                </p>
              </div>
            )}

            <div class="flex flex-col gap-2.5">
              <span class="text-xs font-semibold uppercase tracking-wider text-muted block">
                Featured Chapter Themes
              </span>
              <div class="flex flex-col gap-2">
                {keyThemes.map((theme) => (
                  <div class="p-3.5 rounded-xl bg-surface-subtle border border-border/70 flex items-start gap-3 hover-lift transition-all">
                    <span class="text-xs font-mono font-bold text-accent px-2 py-0.5 rounded bg-surface border border-border/50 shrink-0">
                      {theme.num}
                    </span>
                    <div class="flex flex-col gap-1">
                      <h4 class="text-xs font-bold text-ink m-0 font-display">{theme.title}</h4>
                      <p class="text-caption text-muted leading-relaxed m-0">{theme.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {actionHref && actionLabel && (
            <div class="pt-4 border-t border-border/70 flex flex-wrap items-center gap-3">
              <a
                href={actionHref}
                class="inline-flex items-center gap-1.5 rounded-xl bg-surface-subtle hover:bg-surface border border-border px-4 py-2 text-xs font-semibold text-ink shadow-xs transition-colors"
              >
                <span>{actionLabel}</span>
                <span>↓</span>
              </a>
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="space-y-6 relative z-10">
        {/* Big Full-Width Cinema Player Stage */}
        <div class="w-full space-y-3">
          <YouTubeEmbed
            videoId={videoId}
            title={title}
            badge={badge}
            channelName={channelName}
            channelUrl={channelUrl}
            duration={duration}
            class="shadow-2xl hover:shadow-[0_25px_60px_rgba(198,127,27,0.25)]"
          />

          {/* Caption Bar */}
          <div class="flex flex-wrap items-center justify-between gap-2 px-1 text-xs text-muted">
            {channelName && (
              <span class="flex items-center gap-1.5">
                <Dharmachakra class="w-3.5 h-3.5 text-accent-secondary" />
                <span>
                  Produced by <strong>{channelName}</strong>
                </span>
              </span>
            )}
            <a
              href={`https://www.youtube.com/watch?v=${videoId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:text-accent-hover font-semibold inline-flex items-center gap-1 transition-colors"
            >
              <span>Watch on YouTube</span>
              <span class="text-caption-xs">↗</span>
            </a>
          </div>
        </div>

        {/* Cinema Synopsis & Action Footer */}
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center pt-2">
          {summary && (
            <div
              class={`callout bg-surface-subtle/80 p-5 sm:p-6 rounded-2xl shadow-xs space-y-2 ${actionHref && actionLabel ? "md:col-span-8" : "md:col-span-12"}`}
            >
              <span class="text-caption font-mono font-bold uppercase tracking-wider text-accent block">
                Ceremony & Liturgical Context
              </span>
              <p class="text-xs sm:text-sm text-ink/90 leading-relaxed m-0 font-sans">{summary}</p>
            </div>
          )}

          {actionHref && actionLabel && (
            <div
              class={`flex items-center ${summary ? "md:col-span-4 justify-start md:justify-end" : "md:col-span-12 justify-start"}`}
            >
              <a
                href={actionHref}
                class="inline-flex items-center gap-2 rounded-xl bg-accent hover:bg-accent-hover text-white px-5 py-3 text-xs sm:text-sm font-semibold shadow-md transition-all hover:scale-[1.02]"
              >
                <span>{actionLabel}</span>
                <span>↓</span>
              </a>
            </div>
          )}
        </div>
      </div>
    )
  }
</section>
