---
interface Props {
  title: string;
  tibetanTitle?: string;
  kicker?: string;
  accent?: "accent" | "gold" | "secondary" | "neutral";
  description?: string;
  class?: string;
}

const {
  title,
  tibetanTitle,
  kicker,
  accent = "accent",
  description,
  class: className = "",
} = Astro.props;

const borderAccentMap = {
  accent: "border-t-accent",
  gold: "border-t-gold",
  secondary: "border-t-accent-secondary",
  neutral: "border-t-border",
};
---

<div
  class:list={[
    "surface-card p-6 flex flex-col justify-between border-t-4 hover-lift",
    borderAccentMap[accent] ?? borderAccentMap.accent,
    className,
  ]}
>
  <div class="flex flex-col gap-2">
    {
      kicker && (
        <span class="text-xs sm:text-sm font-mono font-bold text-accent uppercase tracking-widest">
          {kicker}
        </span>
      )
    }
    <h3 class="text-lg sm:text-xl font-display font-bold text-ink leading-snug m-0">
      {title}
    </h3>
    {
      tibetanTitle && (
        <span
          lang="bo"
          class="text-sm sm:text-base font-tibetan text-accent-secondary font-bold block pt-1 leading-[1.6]"
        >
          {tibetanTitle}
        </span>
      )
    }
    {
      description && (
        <p class="text-sm text-muted leading-relaxed m-0 pt-1 font-serif">{description}</p>
      )
    }
    <slot />
  </div>
</div>
