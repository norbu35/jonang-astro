---
interface Props {
  title: string;
  tibetanTitle?: string;
  kicker?: string;
  accent?: "accent" | "gold" | "secondary" | "neutral";
  description?: string;
  class?: string;
}

const { title, tibetanTitle, kicker, description, class: className = "" } = Astro.props;
---

<div class:list={["p-6 flex flex-col justify-between border border-border bg-surface", className]}>
  <div class="flex flex-col gap-2">
    {
      kicker && (
        <span class="text-xs sm:text-sm font-mono font-bold text-muted uppercase tracking-widest">
          {kicker}
        </span>
      )
    }
    <h3 class="text-lg sm:text-xl font-display font-bold text-ink leading-snug m-0">
      {title}
    </h3>
    {
      tibetanTitle && (
        <span
          lang="bo"
          class="text-sm sm:text-base font-tibetan text-muted font-bold block pt-1 leading-[1.6]"
        >
          {tibetanTitle}
        </span>
      )
    }
    {
      description && (
        <p class="text-sm text-muted leading-relaxed m-0 pt-1 font-serif">{description}</p>
      )
    }
    <slot />
  </div>
</div>
