---
export interface PageNavItem {
  id: string;
  label: string;
  short?: string;
}

interface Props {
  items: PageNavItem[];
  ariaLabel?: string;
  class?: string;
}

const {
  items,
  ariaLabel = "Page Section Navigation & Reading Index",
  class: className = "",
} = Astro.props;
---

<!-- Sentinel to detect when the ToC reaches sticky position -->
<div
  id="sticky-nav-sentinel"
  class="w-full h-px pointer-events-none -mt-px opacity-0"
  aria-hidden="true"
>
</div>

<nav
  id="sticky-page-nav"
  class:list={["sticky top-0 z-40 w-full bg-[#3b0809] border-y border-[#fdbc2d]/30 ", className]}
  aria-label={ariaLabel}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div
      class="flex items-center gap-2 py-1.5 sm:py-2 min-w-0 w-full justify-start md:justify-center"
    >
      <!-- Section links with native horizontal scrolling -->
      <div
        id="page-nav-pill-rail"
        class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar py-0.5 min-w-0 flex-1 justify-start md:justify-center select-none"
      >
        {
          items.map((item, index) => (
            <a
              href={`#${item.id}`}
              class:list={[
                "page-nav-pill-link shrink-0 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg text-xs font-mono transition-colors duration-200 border border-transparent select-none",
                index === 0
                  ? "text-gold bg-[#500c0e] font-bold"
                  : "text-white/80 hover:text-white hover:bg-white/10",
              ]}
              data-target={item.id}
            >
              <span class="hidden sm:inline">{item.label}</span>
              <span class="sm:hidden">{item.short ?? item.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Reading progress -->
  <div class="w-full h-[2px] bg-black/40 overflow-hidden" aria-hidden="true">
    <div id="page-nav-scroll-progress" class="h-full w-full origin-left scale-x-0 bg-gold"></div>
  </div>
</nav>

<style>
  #sticky-page-nav {
    top: var(--header-h);
  }
  #page-nav-pill-rail {
    justify-content: safe center;
    scrollbar-width: none;
  }
  #page-nav-pill-rail::-webkit-scrollbar {
    display: none;
  }
</style>
<script>
  function initStickyPageNav() {
    const nav = document.getElementById("sticky-page-nav");
    if (!nav || nav.dataset.initialized) return;
    nav.dataset.initialized = "true";
    const controller = new AbortController();
    const { signal } = controller;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>(".page-nav-pill-link")];
    const progress = document.getElementById("page-nav-scroll-progress");
    const sentinel = document.getElementById("sticky-nav-sentinel");
    let start = 0,
      distance = 1,
      frame = 0;
    const measure = () => {
      start = (sentinel?.getBoundingClientRect().top || 0) + scrollY;
      distance = Math.max(1, document.documentElement.scrollHeight - innerHeight - start);
    };
    const update = () => {
      frame = 0;
      if (progress)
        progress.style.transform = `scaleX(${Math.min(1, Math.max(0, (scrollY - start) / distance))})`;
    };
    const resize = new ResizeObserver(() => {
      measure();
      update();
    });
    resize.observe(document.body);
    window.addEventListener("resize", measure, { signal, passive: true });
    window.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { signal, passive: true }
    );
    const activate = (id: string) => {
      for (const link of links) {
        const active = link.dataset.target === id;
        link.classList.toggle("text-gold", active);
        link.classList.toggle("bg-[#500c0e]", active);
        link.classList.toggle("font-bold", active);
        link.classList.toggle("text-white/80", !active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) if (entry.isIntersecting) activate(entry.target.id);
      },
      { rootMargin: "-20% 0px -65% 0px" }
    );
    links.forEach((link) => {
      const section = document.getElementById(link.dataset.target || "");
      if (section) observer.observe(section);
    });
    measure();
    update();
    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
        resize.disconnect();
        observer.disconnect();
        cancelAnimationFrame(frame);
      },
      { once: true }
    );
  }
  initStickyPageNav();
  document.addEventListener("astro:page-load", initStickyPageNav);
</script>
