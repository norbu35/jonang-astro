---
interface Props {
  dates?: string;
  nameEn: string;
  nameBo: string;
  bio: string;
  highlighted?: boolean;
  tag?: string;
  class?: string;
}

const {
  dates,
  nameEn,
  nameBo,
  bio,
  highlighted = false,
  tag,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "surface-card p-6 flex flex-col justify-between space-y-4 hover-lift",
    highlighted && "border-t-4 border-t-gold",
    className,
  ]}
>
  <div class="flex flex-col">
    {dates && (
      <span class="text-xs font-mono font-bold text-accent uppercase tracking-widest mb-1.5">
        {dates}
      </span>
    )}
    {tag && !dates && (
      <span class="text-xs font-mono font-bold text-accent uppercase tracking-widest mb-1.5">
        {tag}
      </span>
    )}
    <h3 class="text-lg font-display font-bold text-ink leading-snug m-0">
      {nameEn}
    </h3>
    <span class="text-xs font-tibetan text-accent-secondary font-bold block mt-1">
      {nameBo}
    </span>
    <p class="text-xs text-muted leading-relaxed pt-3 m-0">
      {bio}
    </p>
  </div>
</div>
