---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AboutUsContent from "../../components/pages/AboutUsContent.astro";
import StickyPageNav from "../../components/ui/StickyPageNav.astro";
import { STATIC_PAGE_PATHS } from "../../data/staticPages";

import monasteryBannerImg from "../../assets/images/housing-landscape.webp";

const monasteryNavItems = [
  { id: "monastery-overview", label: "01 · Sanctuary Seat", short: "01 · Seat" },
  { id: "monastery-documentary", label: "02 · Tārā Ceremony", short: "02 · Film" },
  { id: "dalai-lama-visits", label: "03 · Dalai Lama Visits", short: "03 · Visits" },
  { id: "abbots-lineage", label: "04 · Succession of Abbots", short: "04 · Abbots" },
  { id: "resident-sangha", label: "05 · Resident Sangha", short: "05 · Sangha" },
  { id: "weekly-schedule", label: "06 · Weekly Prayers", short: "06 · Prayers" },
  { id: "annual-monlam", label: "07 · Annual Monlam", short: "07 · Monlam" },
  { id: "study-and-support", label: "08 · Study & Support", short: "08 · Support" },
];
---

<BaseLayout
  title="The Monastery · Shimla | Jonang Monastery"
  description="Main Jonang Takten Phuntsok Choeling in Sanjauli, Shimla: seat of the Jonang lineage in exile, monastic assembly, sacred shrines, and institutional history."
  breadcrumbs={[{ name: "The Monastery", path: "/monastery" }]}
>
  <main id="main-content" class="flex-1">
    <!-- I. Museum-Grade Art-Directed Sanctuary Hero (Tibetan Monastic Crimson & Gold) -->
    <section
      class="relative w-full overflow-hidden bg-gradient-to-b from-accent-hover via-maroon-light to-maroon text-white border-b border-accent/50 pt-[calc(var(--header-h)+2rem)] sm:pt-[calc(var(--header-h)+2.5rem)] lg:pt-[calc(var(--header-h)+3.5rem)] pb-12 sm:pb-16"
    >
      <!-- Subtle ambient sangha crimson & warm gold temple glow -->
      <div
        class="pointer-events-none absolute -top-40 right-1/4 w-[600px] h-[600px] bg-gold/20 blur-[150px] mix-blend-screen rounded-full"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-40 left-1/4 w-[600px] h-[600px] bg-maroon/60 blur-[130px] rounded-full"
        aria-hidden="true"
      >
      </div>

      <!-- Hero Container -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <!-- Left Column: Editorial Lineage Presentation & Narrative -->
          <div class="lg:col-span-6 flex flex-col gap-6 sm:gap-7">
            <!-- Consecrated Tibetan Title -->
            <div
              lang="bo"
              class="font-tibetan text-2xl sm:text-3xl lg:text-4xl text-gold font-bold leading-[1.6] pt-1 drop-shadow-md"
            >
              ཇོ་ནང་རྟག་བརྟན་ཕུན་ཚོགས་ཆོས་གླིང་།
            </div>

            <!-- Monumental Heading & Prose Group with Generous Spacing -->
            <div class="flex flex-col gap-3.5 sm:gap-4.5">
              <h1
                class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium text-white tracking-tight leading-[1.15] m-0 drop-shadow-md"
              >
                Main Jonang Monastery
              </h1>

              <p class="font-serif text-base sm:text-lg text-white/90 leading-relaxed m-0">
                Perched on the tranquil pine ridge of Sanjauli in Shimla, Himachal Pradesh, <strong
                  >Main Jonang Takten Phuntsok Choeling</strong
                > serves as the primary seat of the Jonang tradition in exile. Established in 1963 and formally consecrated by His Holiness the 14th Dalai Lama, the sanctuary safeguards the living continuity of Shentong Madhyamaka scholarship, liturgical arts, and the Kalachakra Six-fold Vajrayoga.
              </p>
            </div>

            <!-- Canonical Pillars Stream Card (Monastic Sangha Maroon Style) -->
            <div
              class="p-5 sm:p-6 rounded-2xl bg-maroon/90 border border-maroon-border backdrop-blur-md shadow-inner flex flex-col gap-3"
            >
              <div class="border-b border-maroon-border/60 pb-2.5">
                <span
                  class="text-caption uppercase tracking-wider text-gold font-mono font-bold block"
                >
                  Sanctuary Foundation
                </span>
              </div>
              <ul
                class="m-0 p-0 list-none flex flex-col gap-2.5 text-sm text-white/90 font-serif leading-relaxed"
              >
                <li class="flex items-start gap-2">
                  <span class="text-gold font-bold">•</span>
                  <span
                    ><strong>Founded on Sanjauli Ridge (1963):</strong> Established by Lama Jinpa Gyatso on the tranquil pine hills overlooking Shimla.</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold font-bold">•</span>
                  <span
                    ><strong>Seat Bestowal & Consecration (1990):</strong> Formally titled <em>Main Jonang Takten Phuntsok Choeling</em> by H.H. the 14th Dalai Lama as the primary exile seat.</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold font-bold">•</span>
                  <span
                    ><strong>Living Shedra & Dark Retreat:</strong> Houses an 18-year Buddhist philosophy syllabus, annual Monlam assemblies, and continuous 3.5-year Kālacakra meditation retreats.</span
                  >
                </li>
              </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 pt-1 sm:pt-2">
              <a
                href="#monastery-overview"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gold hover:bg-accent-secondary-hover text-ink font-bold text-xs sm:text-sm uppercase tracking-wider transition-all shadow-md hover:shadow-glow hover:-translate-y-1 active:scale-[0.97]"
              >
                <span>Monastery Overview</span>
                <span>↓</span>
              </a>

              <a
                href={STATIC_PAGE_PATHS.livingTradition}
                class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-gold border border-white/25 hover:border-gold/60 font-semibold text-xs sm:text-sm uppercase tracking-wider transition-all backdrop-blur-md active:scale-[0.97]"
              >
                <span>Living Tradition</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Vivid, Radiant Monastery Showcase in Sangha Maroon Frame -->
          <div class="lg:col-span-6 flex flex-col items-center">
            <div class="relative w-full max-w-lg lg:max-w-none group/monastery">
              <!-- Buddhist Monastic Maroon & Gold Filigree Frame -->
              <div
                class="relative rounded-2xl sm:rounded-3xl p-2.5 sm:p-3.5 bg-gradient-to-b from-maroon-light via-maroon-surface to-maroon-dark border border-gold/40 shadow-2xl backdrop-blur-md"
              >
                <div
                  class="relative aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-maroon-dark shadow-inner"
                >
                  <Image
                    src={monasteryBannerImg}
                    alt="Main Jonang Takten Phuntsok Choeling situated atop the pine ridge in Sanjauli, Shimla"
                    width={768}
                    height={1024}
                    class="w-full h-full object-cover object-center transition-transform duration-1000 ease-out group-hover/monastery:scale-105"
                    loading="eager"
                    fetchpriority="high"
                  />

                  <!-- Elegant subtle bottom caption scrim -->
                  <div
                    class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent pointer-events-none"
                  >
                  </div>

                  <div class="absolute bottom-4 left-4 right-4 text-white space-y-1">
                    <span
                      class="text-caption uppercase tracking-wider text-gold font-mono font-bold block"
                    >
                      Sanjauli Ridge · Shimla, Himachal Pradesh
                    </span>
                    <span class="text-xs text-white/90 leading-snug block">
                      Main Jonang Takten Phuntsok Choeling · Primary Seat of Jonang in Exile
                    </span>
                  </div>
                </div>
              </div>

              <!-- Caption Metadata Footer -->
              <div class="flex items-center justify-between text-caption text-white/80 pt-3 px-2">
                <span>Himalayan Ridge Elevation: ~2,200m</span>
                <span class="font-mono text-gold">Est. 1963 · Consecrated 1990</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky Section Navigation Rail -->
    <StickyPageNav items={monasteryNavItems} ariaLabel="Monastery Navigation & Reading Index" />

    <!-- Content Sections -->
    <AboutUsContent />
  </main>
</BaseLayout>
