---
import PageLayout from "../../layouts/PageLayout.astro";
import SectionDivider from "../../components/SectionDivider.astro";
import TitleBanner from "../../components/TitleBanner.astro";

import "../../../base.css";
---

<PageLayout title={"Donate"}>
  <TitleBanner title="Support the Jonang Lineage" />

  <section class="section-padding bg-surface">
    <div class="mx-auto max-w-4xl relative">
      
      {/* Emotional Opening */}
      <div class="text-center mb-16 md:mb-24">
        <h2 class="text-3xl font-display font-medium text-ink md:text-4xl mb-8">
          The Heart of Our Community
        </h2>
        <div class="font-quote text-2xl md:text-3xl leading-[1.6] text-ink/85 italic max-w-3xl mx-auto space-y-6">
          <p>
            The Jonang Takten Phuntsok Choeling Monastery is a very small, modest monastery of more than one hundred monks. 
          </p>
          <p class="text-xl md:text-2xl text-muted">
            The majority of the monks are refugees from Tibet, India, and Mongolia. 
            Coming from impoverished families, they are unable to pay for their food, 
            shelter, or study, and rely entirely upon charitable donations to sustain 
            their lifelong dedication to meditation and spiritual training.
          </p>
        </div>
      </div>

      <SectionDivider class="section-divider--muted max-w-[200px] mx-auto mb-16 md:mb-24" />

      {/* Ways to Donate - Split Cards */}
      <div class="mb-12 text-center">
        <h3 class="text-2xl font-display font-medium text-ink md:text-3xl mb-4">
          Ways to Donate
        </h3>
        <p class="text-lg text-muted max-w-2xl mx-auto">
          We deeply appreciate any contribution towards the upkeep of the monastery, the daily provision of an adequate diet, and essential medical care. 
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 md:gap-12 mb-16">
        
        {/* Bank Transfer Card */}
        <div class="editorial-card hover-lift flex flex-col items-center text-center">
          <div class="h-12 w-12 rounded-full bg-surface-muted ring-1 ring-border/50 flex items-center justify-center mb-6 text-accent">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
            </svg>
          </div>
          <h4 class="text-xl font-medium text-ink md:text-2xl mb-3">Bank Transfer</h4>
          <p class="text-muted text-sm mb-6 flex-1">
            Wire your donation directly to our bank account in India. Standard international bank charges may apply.
          </p>
          
          <div class="w-full bg-surface/50 rounded-xl p-5 text-sm text-ink/80 text-left space-y-2 ring-1 ring-border/20 shadow-inner">
            <div class="flex justify-between border-b border-border/40 pb-2"><span class="font-semibold text-ink">Name:</span> <span class="text-right ml-4">Jonang Takten Phuntsok Chosling</span></div>
            <div class="flex justify-between border-b border-border/40 py-2"><span class="font-semibold text-ink">Bank:</span> <span class="text-right ml-4">State Bank of India</span></div>
            <div class="flex justify-between border-b border-border/40 py-2"><span class="font-semibold text-ink">Account No:</span> <span class="text-right ml-4 font-mono">4008 4616 933</span></div>
            <div class="flex justify-between border-b border-border/40 py-2"><span class="font-semibold text-ink">SWIFT code:</span> <span class="text-right ml-4 font-mono">SBININBB104</span></div>
            <div class="flex justify-between border-b border-border/40 py-2"><span class="font-semibold text-ink">IFSC code:</span> <span class="text-right ml-4 font-mono">SBIN 0000 691</span></div>
            <div class="flex justify-between pt-2"><span class="font-semibold text-ink">Branch code:</span> <span class="text-right ml-4 font-mono">00691</span></div>
          </div>
        </div>

        {/* Cheque Card */}
        <div class="editorial-card hover-lift flex flex-col items-center text-center">
          <div class="h-12 w-12 rounded-full bg-surface-muted ring-1 ring-border/50 flex items-center justify-center mb-6 text-accent">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h4 class="text-xl font-medium text-ink md:text-2xl mb-3">Send a Cheque</h4>
          <p class="text-muted text-sm mb-6 flex-1">
            If you wish to post a physical donation to the monastery, please make cheques payable to our cultural society.
          </p>
          
          <div class="w-full bg-surface/50 rounded-xl p-5 text-sm text-ink/80 text-left space-y-3 ring-1 ring-border/20 shadow-inner">
            <div>
              <span class="block font-semibold text-ink mb-1">Payable to:</span>
              Jonang Takten Phuntsok Choeling Cultural Society
            </div>
            <div class="pt-2 border-t border-border/40">
              <span class="block font-semibold text-ink mb-1">Postal Address:</span>
              Jonang Takten Phuntsok Choeling Tibetan Buddhist Monastery,<br/>
              Sanjauli, Shimla, Himachal Pradesh,<br/>
              171006, India
            </div>
          </div>
        </div>

      </div>

      <div class="text-center bg-surface-muted ring-1 ring-border/30 rounded-2xl p-8 md:p-12 mb-8">
        <h4 class="text-xl font-medium text-ink md:text-2xl mb-4">
          Contact Us Regarding Your Gift
        </h4>
        <p class="mb-8 leading-relaxed text-muted max-w-2xl mx-auto">
          If you wish to specify how you would like your donation to be used, please contact us. Also, when making a donation via bank transfer, we recommend alerting the monastery via e-mail so that we may confirm receipt.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-ink/90 font-medium">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            +91 117 2841410
          </div>
          <a href="mailto:office@jonangmonastery.com" class="flex items-center gap-2 text-accent hover:text-accent-soft transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            office@jonangmonastery.com
          </a>
        </div>
      </div>

    </div>
  </section>
</PageLayout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
