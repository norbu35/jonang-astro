---
import PageLayout from "../../layouts/PageLayout.astro";
import Dharmachakra from "../../components/icons/Dharmachakra.astro";
import EndlessKnot from "../../components/icons/EndlessKnot.astro";
import sitemapBannerImg from "../../assets/images/kalachakra-banner.webp";
import { STATIC_PAGE_PATHS } from "../../data/staticPages";

const sitemapSections = [
  {
    category: "The Monastic Seat & Lineage",
    tibetan: "དགོན་པ་དང་བརྒྱུད་པ།",
    badge: "Sanctuary & History",
    gridClass: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
    links: [
      {
        title: "Sanctuary Home",
        href: "/",
        tibetan: "གཙོ་ངོས།",
        desc: "Overview of Main Jonang Takten Phuntsok Choeling, historical timeline, lineage head, and introductory gateways.",
      },
      {
        title: "The Monastery",
        href: STATIC_PAGE_PATHS.monastery,
        tibetan: "ཇོ་ནང་རྟག་བརྟན་ཕུན་ཚོགས་ཆོས་གླིང་།",
        desc: "Sanjauli Shimla complex, Dalai Lama visits, succession of lineage abbots, demographics, and liturgical calendar.",
      },
      {
        title: "Living Tradition & Daily Life",
        href: STATIC_PAGE_PATHS.livingTradition,
        tibetan: "ཉིན་རེའི་འཚོ་བ་དང་སྲོལ་རྒྱུན།",
        desc: "The monastic rhythm, dawn slit-gong, dialectical debate kinetics, kitchen culture, Dzamthang sacred crafts, and Himalayan ecology.",
      },
      {
        title: "Holders of the Lineage",
        href: STATIC_PAGE_PATHS.teachers,
        tibetan: "བཀའ་བབས་བརྒྱུད་པའི་བླ་མ།",
        desc: "Biographies of the Supreme Lineage Heads, Dorje Lopöns, and resident monastic teachers in exile.",
      },
    ],
  },
  {
    category: "Sacred Doctrine & Practice",
    tibetan: "ལྟ་གྲུབ་དང་ཉམས་ལེན།",
    badge: "Philosophy & Tantra",
    gridClass: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
    links: [
      {
        title: "Beginner's Introduction",
        href: STATIC_PAGE_PATHS.introduction,
        tibetan: "ཇོ་ནང་ཆོས་བརྒྱུད་ངོ་སྤྲོད།",
        desc: "Accessible on-ramp covering Buddhist fundamentals, the five Tibetan lineages, Shentong vs Rangtong, and the Six Yogas.",
      },
      {
        title: "The Jonang Doctrine",
        href: STATIC_PAGE_PATHS.doctrine,
        tibetan: "ཇོ་ནང་ལྟ་གྲུབ།",
        desc: "Definitive Shentong Great Madhyamaka, the Three Turnings, and curated scholarly bibliography.",
      },
      {
        title: "Kālacakra Practice",
        href: STATIC_PAGE_PATHS.kalachakra,
        tibetan: "དཔལ་དུས་ཀྱི་འཁོར་ལོ།",
        desc: "The Six-fold Vajrayoga (Ṣaḍaṅgayoga), generation stage, dark retreat, and 3.5-year contemplative retreat syllabus.",
      },
      {
        title: "18-Year Curriculum",
        href: STATIC_PAGE_PATHS.curriculum,
        tibetan: "ལོ་བཅོ་བརྒྱད་ཀྱི་སློབ་ཚན།",
        desc: "Comprehensive shedra syllabus spanning classical Tibetan grammar, Pramāṇa epistemology, and the Five Great Treatises.",
      },
    ],
  },
  {
    category: "Community, Lexicon & Sponsorship",
    tibetan: "དགེ་འདུན་དང་ཚིག་མཛོད་ཞབས་འདེགས།",
    badge: "Sangha & Support",
    gridClass: "grid-cols-1 md:grid-cols-3",
    links: [
      {
        title: "Photo Gallery",
        href: STATIC_PAGE_PATHS.gallery,
        tibetan: "དགོན་པའི་སྐུ་པར།",
        desc: "Visual archive of daily life, liturgical ceremonies, scholastic study, and Himalayan community arboriculture.",
      },
      {
        title: "Scholarly Glossary",
        href: STATIC_PAGE_PATHS.glossary,
        tibetan: "གཞུང་ལུགས་ཚིག་མཛོད།",
        desc: "Canonical bilingual glossary of Tibetan, Sanskrit, and English terminology for Shentong Madhyamaka, Kālacakra, and monastic life.",
      },
      {
        title: "Support the Monastery",
        href: STATIC_PAGE_PATHS.donate,
        tibetan: "དགོན་པར་ཞབས་འདེགས།",
        desc: "Direct support for monk sustenance, healthcare, winter heating, and registered bank wire transfer instructions.",
      },
    ],
  },
];
---

<PageLayout
  title="Monastic Site Directory & Index | Jonang Monastery"
  tibetanTitle="དྲ་ཚིགས་ས་ཁྲ།"
  description="Complete index and sitemap of Main Jonang Takten Phuntsok Choeling monastery: pages on Shentong philosophy, Kalachakra Tantra, shedra curriculum, and teachers."
  image={sitemapBannerImg}
  imageAlt="Panoramic Kalachakra mural painting from Dzamthang Monastery"
  breadcrumbs={[{ name: "Sitemap", path: STATIC_PAGE_PATHS.sitemap }]}
>
  <div class="space-y-12">
    <!-- Intro Callout -->
    <div class="surface-card p-6 sm:p-8 md:p-10 space-y-6">
      <h2
        class="text-2xl sm:text-3xl md:text-4xl font-display text-ink font-normal leading-tight m-0"
      >
        Complete Directory of Main Jonang Takten Phuntsok Choeling
      </h2>

      <p class="lead text-base sm:text-lg text-muted font-serif leading-relaxed m-0">
        Use this sitemap to explore all philosophical treatises, meditation curricula, teacher
        biographies, liturgical schedules, and support facilities across the official monastery web
        resource.
      </p>
    </div>

    <!-- Hierarchical Sitemap Sections -->
    <div class="space-y-10">
      {
        sitemapSections.map((section) => (
          <div class="space-y-6">
            <div class="flex items-center justify-between border-b border-border/80 pb-3">
              <div class="flex items-center gap-3">
                <Dharmachakra class="w-6 h-6 text-accent-secondary" />
                <div>
                  <h3 class="text-xl sm:text-2xl font-display text-ink font-bold m-0">
                    {section.category}
                  </h3>
                  <span
                    lang="bo"
                    class="text-sm sm:text-base font-tibetan text-accent font-bold block mt-1 pt-0.5 leading-[1.6]"
                  >
                    {section.tibetan}
                  </span>
                </div>
              </div>
              <span class="badge badge-neutral text-caption-xs hidden sm:inline-block">
                {section.badge}
              </span>
            </div>

            <div class={`grid gap-6 items-stretch ${section.gridClass}`}>
              {section.links.map((link) => (
                <a
                  href={link.href}
                  class="surface-card p-6 flex flex-col justify-between gap-4 hover-lift group border border-border hover:border-accent transition-all h-full rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
                >
                  <div class="flex flex-col gap-2">
                    <div class="flex justify-between items-start">
                      <span
                        lang="bo"
                        class="text-sm sm:text-base font-tibetan text-accent-secondary font-bold pt-0.5 leading-[1.6]"
                      >
                        {link.tibetan}
                      </span>
                      <EndlessKnot
                        size={20}
                        class="text-gold/50 group-hover:text-gold transition-colors"
                      />
                    </div>
                    <h4 class="text-lg sm:text-xl font-display font-bold text-ink group-hover:text-accent transition-colors m-0">
                      {link.title} →
                    </h4>
                    <p class="text-sm text-muted leading-relaxed m-0 font-serif">{link.desc}</p>
                  </div>

                  <span class="text-xs sm:text-sm font-semibold text-accent flex items-center gap-1 group-hover:translate-x-1 transition-transform pt-2 border-t border-border/40">
                    Visit Page <span>→</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</PageLayout>
