---
import PageLayout from "../../layouts/PageLayout.astro";
import RichTextSection from "../../components/RichTextSection.astro";
import { FOOTER_NAVIGATION } from "../../data/navigation";
---

<PageLayout title="Sitemap">
  <RichTextSection>
    <nav aria-label="Sitemap">
      <p>
        Use this sitemap to quickly find key pages across the Jonang Monastery
        website.
      </p>
      <div class="grid gap-10 md:grid-cols-2">
        {FOOTER_NAVIGATION.map((section) => (
          <div>
            <h2>{section.heading}</h2>
            <ul>
              {section.links.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>
  </RichTextSection>
</PageLayout>
