---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../layouts/HeroSection.astro";
import ChapterHeader from "../components/ui/ChapterHeader.astro";
import { SITE_METADATA } from "../data/site";
import studentsImage from "../assets/images/young-students.webp";
import "../styles/homepage.css";

const routes = [
  {
    href: "/introduction",
    title: "New to Jonang?",
    body: "Begin with a guide to the tradition, its teachings and the words you’ll encounter.",
    label: "Read the introduction",
  },
  {
    href: "/doctrine",
    title: "View & philosophy",
    body: "Explore Shentong, or ‘other-emptiness’: the Jonang understanding of Buddha-nature as free of passing obscurations.",
    label: "Explore Shentong",
  },
  {
    href: "/kalachakra",
    title: "Meditation & practice",
    body: "Learn about Kālacakra and its completion-stage yoga, a guided path of meditation within the Jonang tradition.",
    label: "Learn about Kālacakra",
  },
];
const milestones = [
  {
    date: "13th century",
    title: "A home at Jonang",
    body: "Kunpang Thukje Tsöndrü established a teaching and practice community at Jonang in Tibet.",
    source: "https://jonangfoundation.org/jonang_master/kunpang-thukje-tsondru/",
    label: "Kunpang’s biography",
  },
  {
    date: "14th century",
    title: "Dölpopa’s contribution",
    body: "Dölpopa Sherab Gyaltsen articulated the Shentong view and built the great stupa at Jonang.",
    source: "https://jonangfoundation.org/jonang_master/dolpopa-sherab-gyaltsen/",
    label: "Dölpopa’s biography",
  },
  {
    date: "17th century",
    title: "Tāranātha’s legacy",
    body: "The scholar and teacher Tāranātha established Takten Damchö Ling, an important centre of the Jonang tradition.",
    source: "https://jonangfoundation.org/jonang_master/taranatha/",
    label: "Tāranātha’s biography",
  },
];
---

<BaseLayout
  title="Main Jonang Takten Phuntsok Choeling | Tibetan Buddhist Monastery"
  description="Discover the Jonang Tibetan Buddhist monastery in Sanjauli, Shimla, India. Begin with the tradition, explore monastic life, and contact the monastery."
>
  <main id="main-content" tabindex="-1" class="homepage focus:outline-none">
    <HeroSection />

    <section class="home-section home-community" aria-labelledby="community-heading" id="community">
      <div class="home-container home-split">
        <figure class="home-photo">
          <Image
            src={studentsImage}
            alt="Young monks studying together at a table"
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 45vw, 100vw"
            loading="lazy"
          />
          <figcaption>Faces of the monastic community</figcaption>
        </figure>
        <div class="home-copy">
          <ChapterHeader
            chapter="The living monastery"
            title="A place to study, practise and belong"
            id="community-heading"
          />
          <p>
            Welcome to Main Jonang Takten Phuntsok Choeling, a Tibetan Buddhist monastery in
            Sanjauli, Shimla. Here, monastic life brings together learning, prayer and meditation in
            the Jonang tradition.
          </p>
          <p>
            Meet the community, explore the monastery’s story, or take a closer look at daily life.
          </p>
          <div class="home-links">
            <a href="/monastery">Meet the monastery <span aria-hidden="true">↗</span></a><a
              href="/living-tradition">Discover daily life <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
      </div>
    </section>

    <section class="home-section home-learning" aria-labelledby="learning-heading">
      <div class="home-container home-stack">
        <ChapterHeader
          chapter="Explore the tradition"
          title="Start with curiosity"
          lede="An introduction is all you need to begin. Follow the path that interests you."
          id="learning-heading"
        />
        <div class="home-routes">
          {
            routes.map((route) => (
              <a href={route.href} class="home-route">
                <>
                  <h3>{route.title}</h3>
                  <p>{route.body}</p>
                  <span class="home-route-link">
                    {route.label} <span aria-hidden="true">→</span>
                  </span>
                </>
              </a>
            ))
          }
        </div>
        <div class="home-links">
          <a href="/curriculum">Explore monastic education <span aria-hidden="true">↗</span></a><a
            href="/glossary">Browse the glossary <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="history-heading">
      <div class="home-container home-stack">
        <ChapterHeader
          chapter="Roots & lineage"
          title="A tradition handed from teacher to student"
          id="history-heading"
        />
        <ol class="home-history">
          {
            milestones.map((milestone) => (
              <li>
                <>
                  <span class="home-date">{milestone.date}</span>
                  <h3>{milestone.title}</h3>
                  <p>{milestone.body}</p>
                  <a href={milestone.source}>
                    {milestone.label} <span aria-hidden="true">↗</span>
                  </a>
                </>
              </li>
            ))
          }
        </ol>
        <div class="home-links">
          <a href="/teachers">Meet the teachers <span aria-hidden="true">↗</span></a><a
            href="/monastery">Read the monastery’s history <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="home-section home-contact" id="contact" aria-labelledby="contact-heading">
      <div class="home-container home-split">
        <div class="home-copy">
          <ChapterHeader
            chapter="Sanjauli, Shimla · India"
            title="Get in touch"
            id="contact-heading"
          />
          <p>
            For questions about the monastery or visiting, contact the office before making plans.
          </p>
          <a class="home-button" href={`mailto:${SITE_METADATA.contact.email}`}
            >Email the monastery <span aria-hidden="true">↗</span></a
          >
        </div>
        <address class="home-address">
          <span class="home-date">Monastery office</span>
          {SITE_METADATA.contact.addressLines.map((line) => <span>{line}</span>)}
          <a href={`mailto:${SITE_METADATA.contact.email}`}>{SITE_METADATA.contact.email}</a>
          <a href={`tel:${SITE_METADATA.contact.phone.replace(/\s+/g, "")}`}
            >{SITE_METADATA.contact.phone}</a
          >
        </address>
      </div>
    </section>

    <section class="home-section home-support" aria-labelledby="support-heading">
      <div class="home-container home-support-inner">
        <div class="home-copy">
          <ChapterHeader
            chapter="Support"
            title="Help sustain monastic life"
            id="support-heading"
          />
          <p>
            Your generosity supports the monastery and its community. Our giving page explains how
            to offer general support and contact the office with donation questions.
          </p>
        </div>
        <a class="home-button" href="/donate"
          >Support the monastery <span aria-hidden="true">→</span></a
        >
      </div>
    </section>
  </main>
</BaseLayout>
