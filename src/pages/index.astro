---
import { Image } from "astro:assets";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnimatedDivider from "../components/AnimatedDivider.astro";
import ThangkaCollageSection from "../components/ThangkaCollageSection.astro";
import FrescoMuralSection from "../components/FrescoMuralSection.astro";
import SacredCenterpiece from "../components/SacredCenterpiece.astro";
import HeroSection from "../layouts/HeroSection.astro";
import ProminenceSection from "../layouts/ProminenceSection.astro";
import DonateSection from "../layouts/DonateSection.astro";
import { STATIC_PAGE_PATHS } from "../data/staticPages";

import teachingImage from "../assets/images/lecture.webp";
import studentsImage from "../assets/images/young-students.webp";
import landscapeImage from "../assets/images/housing-landscape.webp";
import libraryImage from "../assets/images/teacher-library.webp";
import riteSutraImage from "../assets/images/rite-sutra.webp";

import "../../base.css";

const pillars = [
  {
    title: "Kalachakra lineage",
    body:
      "Jonang became the principal institutional home of the Dro lineage of the Kalachakra Tantra and its completion-stage yogas.",
  },
  {
    title: "Zhentong philosophy",
    body:
      "The tradition is known for its Great Madhyamaka articulation of other-emptiness, presenting Buddha-nature as luminous, present, and empty of adventitious obscurations.",
  },
  {
    title: "Survival and resurgence",
    body:
      "Though suppressed in Central Tibet during the seventeenth century, Jonang survived in eastern Tibetan regions and now re-emerges globally through study, retreat, and teaching.",
  },
];

const pathways = [
  {
    href: STATIC_PAGE_PATHS.aboutUs,
    label: "The Monastery",
    body:
      "Read the story of Main Jonang Takten Phuntsok Choeling in Shimla and its role as a living center in exile.",
  },
  {
    href: STATIC_PAGE_PATHS.jonangDoctrine,
    label: "The Jonang Tradition",
    body:
      "Explore the historical roots, philosophical identity, and modern resurgence of the Jonang school.",
  },
  {
    href: STATIC_PAGE_PATHS.kalachakra,
    label: "Kalachakra Practice",
    body:
      "Follow the distinctive place of Kalachakra in Jonang training, meditation, and subtle-body yogic practice.",
  },
  {
    href: STATIC_PAGE_PATHS.curriculum,
    label: "Curriculum",
    body:
      "See how scholastic study, ritual training, retreat, and modern education are held together in one path of formation.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Discover the Jonang tradition through its philosophy, Kalachakra lineage, living monastery in Shimla, and modern resurgence across Tibet, India, Mongolia, and the wider world."
    />
    <meta
      name="keywords"
      content="Jonang, Tibetan Buddhism, Kalachakra, Zhentong, Shimla monastery"
    />
    <title>Jonang Monastery</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      property="og:title"
      content="Main Jonang Takten Phuntsok Choeling"
    />
    <meta property="og:site_name" content="Jonang Monastery" />
    <meta property="og:url" content="https://jonang.in" />
    <meta
      property="og:description"
      content="A curated introduction to the Jonang tradition, its Kalachakra transmissions, philosophical heritage, and living monastic culture in Shimla."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://jonang.in/logo512x512.jpg"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jonang" />
    <meta
      name="twitter:title"
      content="Main Jonang Takten Phuntsok Choeling"
    />
    <meta
      name="twitter:description"
      content="A living refuge for the Jonang tradition, bringing together history, doctrine, Kalachakra practice, and contemporary monastic study."
    />
    <meta
      name="twitter:image"
      content="https://jonang.in/logo512x512.jpg"
    />
  </head>
  <body>
    <Header />
    <HeroSection />
    <main>
      <ProminenceSection />
      <AnimatedDivider type="knot" />
      <section class="section-padding reveal-on-scroll">
        <div class="page-stack">
          <div class="editorial-intro">
            <div>
              <h2>A lineage nearly lost, still teaching in full voice</h2>
              <p class="editorial-lede artisan-dropcap">
                The Jonang tradition preserves one of Tibetan Buddhism's most
                distinctive unions of philosophy and tantric practice: the
                Zhentong view of luminous Buddha-nature and the complete Dro
                lineage of the Kalachakra system.
              </p>
              <p>
                For centuries many believed the school had disappeared after the
                upheavals of the seventeenth century. It survived instead in the
                mountain regions of eastern Tibet, re-emerged in India and
                Mongolia, and today continues through monasteries, retreat
                centers, scholars, and teachers serving a global community.
              </p>
            </div>
            <aside class="editorial-panel">
              <h3 class="mt-0">Why Jonang matters now</h3>
              <ul class="editorial-checklist">
                <li>Home of the complete Kalachakra completion-stage lineage</li>
                <li>Known for a rigorous articulation of other-emptiness</li>
                <li>Historically suppressed, now publicly resurgent</li>
                <li>Alive today in Shimla, eastern Tibet, Mongolia, and beyond</li>
              </ul>
            </aside>
          </div>

          <div class="editorial-grid">
            {pillars.map((pillar) => (
              <article class="editorial-card artisan-card">
                <h3>{pillar.title}</h3>
                <p>{pillar.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <AnimatedDivider type="lotus" />

      <section class="section-padding reveal-on-scroll">
        <FrescoMuralSection
          title="From Shambhala legend to modern recognition"
          body="Jonang memory is carried through sacred narrative, historical transmission, and monastic continuity. The result is a tradition that links Indian tantric roots, Tibetan philosophical creativity, periods of persecution, and a modern global renaissance."
          imageSrc={riteSutraImage} 
        />
      </section>

      <AnimatedDivider type="lotus" />

      <section class="section-padding reveal-on-scroll">
        <ThangkaCollageSection
          title="Kalachakra as cosmology, contemplation, and lived path"
          body="The Kalachakra cycle is not simply one subject among many. In Jonang it provides the ritual, meditative, and subtle-body framework through which the school understands the relationship between cosmos, body, awareness, and awakening."
          imageSrc={teachingImage}
          imageAlt="A monk teaching in a monastery setting"
        />
      </section>

      <section class="section-padding bg-surface-muted/70 textured-panel reveal-on-scroll">
        <div class="page-stack">
          <div class="editorial-grid--two items-center">
            <div>
              <h2>Sacred sites, exile institutions, and global renewal</h2>
              <p>
                The tradition's story now stretches from the historical valleys
                of Central Tibet to the sanctuary networks of Amdo and Kham, the
                monastery in Shimla, and a renewed presence in Mongolia and the
                West.
              </p>
              <div class="editorial-grid md:grid-cols-2">
                <article class="editorial-card artisan-card">
                  <h3>Dzamthang</h3>
                  <p>
                    A major stronghold in eastern Tibet where monasteries,
                    retreat communities, and Kalachakra festivals preserved the
                    lineage after suppression.
                  </p>
                </article>
                <article class="editorial-card artisan-card">
                  <h3>Shimla</h3>
                  <p>
                    Main Jonang Takten Phuntsok Choeling now serves as a living
                    center of study, ritual training, and monastic education in
                    exile.
                  </p>
                </article>
                <article class="editorial-card artisan-card">
                  <h3>Mongolia</h3>
                  <p>
                    Through the legacy of Zanabazar and the Jebtsundampa line,
                    Jonang memory intersects with the broader cultural history
                    of the Mongolian Buddhist world.
                  </p>
                </article>
                <article class="editorial-card artisan-card">
                  <h3>International study</h3>
                  <p>
                    New programs and translations now make teachings once hidden
                    in isolated regions available to students across the world.
                  </p>
                </article>
              </div>
            </div>
            <div class="grid gap-5">
              <div class="editorial-figure">
                <Image
                  src={landscapeImage}
                  alt="Monastic buildings set in the Himalayan landscape"
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                />
              </div>
              <div class="editorial-figure">
                <Image
                  src={studentsImage}
                  alt="Young monastic students gathered together"
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section-padding reveal-on-scroll">
        <div class="page-stack">
          <div class="editorial-quote">
            <h2 class="mt-0 text-white">Reading the tradition</h2>
            <p>
              Jonang is best approached as a living union of history,
              contemplative training, and philosophical daring, not as an
              isolated doctrinal curiosity.
            </p>
          </div>

          <div>
            <h2>Four ways into the site</h2>
            <div class="editorial-link-grid">
              {pathways.map((item) => (
                <article class="editorial-link-card artisan-card">
                  <a href={item.href}>
                    <h3>{item.label}</h3>
                    <p>{item.body}</p>
                  </a>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <AnimatedDivider type="lotus" />

      <section class="section-padding reveal-on-scroll">
        <SacredCenterpiece
          title="Texts, teachers, and training still held in full"
          body="What distinguishes the site today is not only memory of a lost school, but the continuity of living teachers, long-term curriculum, ritual practice, retreat, and translation work."
          imageSrc={libraryImage}
          imageAlt="Bookshelves and sacred texts in the monastery library"
        />
      </section>

      <AnimatedDivider type="knot" />
      <DonateSection />
    </main>
    <Footer />
    <script>
      import { initScrollReveal } from "../scripts/scrollReveal.js";
      document.addEventListener("DOMContentLoaded", initScrollReveal);
    </script>
  </body>
</html>
