---
import { Image } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import { GALLERY_ITEMS } from "../../data/gallery";
import { STATIC_PAGE_PATHS } from "../../data/staticPages";

const categories = [
  { id: "all", label: "All Works", labelBo: "ཚང་མ།", count: GALLERY_ITEMS.length },
  {
    id: "Sanctuary",
    label: "Sanctuary",
    labelBo: "ལྷ་ཁང་།",
    count: GALLERY_ITEMS.filter((i) => i.category === "Sanctuary").length,
  },
  {
    id: "Ritual",
    label: "Ritual Liturgy",
    labelBo: "ཆོ་ག",
    count: GALLERY_ITEMS.filter((i) => i.category === "Ritual").length,
  },
  {
    id: "Study",
    label: "Scholastic Study",
    labelBo: "བཤད་གྲྭ།",
    count: GALLERY_ITEMS.filter((i) => i.category === "Study").length,
  },
  {
    id: "Community",
    label: "Sangha Community",
    labelBo: "དགེ་འདུན།",
    count: GALLERY_ITEMS.filter((i) => i.category === "Community").length,
  },
];
---

<PageLayout
  title="Photo Gallery · Monastic Sacred Art | Jonang Monastery"
  tibetanTitle="དགོན་པའི་སྐུ་པར།"
  description="Visual chronicle of Main Jonang Takten Phuntsok Choeling: sacred thangkas, sand mandalas, shedra debate kinetics, butter sculpture, and monastery landscape."
  breadcrumbs={[{ name: "Photo Gallery", path: STATIC_PAGE_PATHS.gallery }]}
>
  <div class="space-y-8">
    <!-- Editorial Intro Callout -->
    <div
      class="surface-card p-6 sm:p-8 rounded-2xl border border-border/80 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-6"
    >
      <div class="space-y-2 max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-display text-ink m-0">
          Life at Main Jonang Takten Phuntsok Choeling
        </h2>
        <p class="text-sm sm:text-base text-muted leading-relaxed m-0 font-serif">
          A visual chronicle of daily life, liturgical ritual, shedra debate, and scholastic study
          in the Himalayan heights of Sanjauli, Shimla.
        </p>
      </div>

      <!-- Filter Chips -->
      <div class="flex flex-wrap items-center gap-2" id="gallery-filters">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              data-filter={cat.id}
              class:list={[
                "gallery-filter-btn px-3.5 py-1.5 min-h-[38px] rounded-full text-xs font-semibold tracking-wide transition-all border cursor-pointer flex items-center gap-1.5",
                idx === 0
                  ? "bg-accent text-white border-accent shadow-xs"
                  : "bg-surface-subtle text-muted hover:text-ink hover:bg-surface border-border",
              ]}
            >
              <span>{cat.label}</span>
              <span lang="bo" class="font-tibetan text-xs opacity-85 ml-0.5 pt-0.5 leading-[1.6]">
                {cat.labelBo}
              </span>
              <span class="text-caption-xs font-mono opacity-80">({cat.count})</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Gallery Grid -->
    <div
      id="gallery-grid"
      class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3"
    >
      {
        GALLERY_ITEMS.map((item, index) => (
          <button
            type="button"
            class="gallery-card group overflow-hidden rounded-2xl border border-border/80 bg-surface shadow-card hover-lift text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold cursor-pointer flex flex-col justify-between"
            data-index={index}
            data-title={item.title}
            data-title-bo={item.titleBo || ""}
            data-category={item.category}
            data-alt={item.alt}
            data-src={item.image.src}
          >
            <div class="aspect-[4/3] w-full overflow-hidden relative bg-surface-subtle">
              <Image
                src={item.image}
                alt={item.alt}
                width={640}
                height={480}
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading={index < 6 ? "eager" : "lazy"}
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none flex items-end p-4">
                <span class="text-white text-xs font-semibold tracking-wider uppercase drop-shadow-sm flex items-center gap-1">
                  <span>View</span>
                  <span>✦</span>
                </span>
              </div>
            </div>
            <div class="p-4 bg-surface flex items-center justify-between border-t border-border/50 w-full">
              <div>
                <h3 class="text-sm font-display font-semibold text-ink m-0 group-hover:text-accent transition-colors">
                  {item.title}
                </h3>
                {item.titleBo && (
                  <p lang="bo" class="font-tibetan text-xs text-muted/90 pt-0.5 leading-[1.6] m-0">
                    {item.titleBo}
                  </p>
                )}
                <span class="text-caption text-muted uppercase tracking-wider font-mono mt-0.5 block">
                  {item.category}
                </span>
              </div>
              <span class="text-gold text-sm opacity-60 group-hover:opacity-100 transition-opacity">
                ༄
              </span>
            </div>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Accessible Native HTML5 Modal Dialog Lightbox -->
  <dialog
    id="gallery-modal"
    class="fixed inset-0 m-auto max-w-5xl w-[92vw] max-h-[90vh] bg-maroon-dark/95 text-white border border-gold/30 rounded-2xl p-4 sm:p-6 shadow-2xl backdrop:bg-black/80 backdrop:backdrop-blur-md closedby-any outline-none"
  >
    <div class="flex flex-col h-full justify-between gap-4">
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <div>
          <span
            id="modal-category"
            class="badge badge-saffron text-caption uppercase tracking-wider mb-1 inline-block"
            >Category</span
          >
          <h2 class="text-2xl font-display text-white font-normal mb-1" id="modal-title">
            Image Title
          </h2>
          <p
            id="modal-title-bo"
            lang="bo"
            class="font-tibetan text-base text-gold/90 pt-0.5 leading-[1.6] m-0 empty:hidden"
          >
          </p>
        </div>
        <form method="dialog">
          <button
            value="close"
            class="h-11 w-11 min-h-[44px] min-w-[44px] rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors focus-visible:ring-2 focus-visible:ring-gold cursor-pointer text-base"
            aria-label="Close photo viewer"
          >
            ✕
          </button>
        </form>
      </div>

      <div
        class="relative flex-1 min-h-[300px] sm:min-h-[460px] flex items-center justify-center overflow-hidden rounded-xl bg-black/40"
      >
        <img
          id="modal-image"
          src=""
          alt=""
          class="max-h-[65vh] w-auto max-w-full object-contain rounded-lg shadow-lg transition-opacity duration-300"
        />

        <!-- Navigation Buttons -->
        <button
          type="button"
          id="prev-btn"
          class="absolute left-3 top-1/2 -translate-y-1/2 h-11 w-11 rounded-full bg-black/60 hover:bg-black/90 text-gold border border-gold/40 flex items-center justify-center transition-all hover:scale-105 focus-visible:ring-2 focus-visible:ring-gold text-lg"
          aria-label="Previous image"
        >
          ←
        </button>
        <button
          type="button"
          id="next-btn"
          class="absolute right-3 top-1/2 -translate-y-1/2 h-11 w-11 rounded-full bg-black/60 hover:bg-black/90 text-gold border border-gold/40 flex items-center justify-center transition-all hover:scale-105 focus-visible:ring-2 focus-visible:ring-gold text-lg"
          aria-label="Next image"
        >
          →
        </button>
      </div>

      <div
        class="flex items-center justify-between text-xs text-white/70 pt-2 border-t border-white/10"
      >
        <span id="modal-counter">1 of 15</span>
        <span class="font-mono">← → Navigate · Esc Close</span>
      </div>
    </div>
  </dialog>

  <script>
    function initGalleryModal() {
      const modal = document.getElementById("gallery-modal") as HTMLDialogElement | null;
      const modalImg = document.getElementById("modal-image") as HTMLImageElement | null;
      const modalTitle = document.getElementById("modal-title");
      const modalTitleBo = document.getElementById("modal-title-bo");
      const modalCategory = document.getElementById("modal-category");
      const modalCounter = document.getElementById("modal-counter");
      const prevBtn = document.getElementById("prev-btn");
      const nextBtn = document.getElementById("next-btn");
      const allCards = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-card"));
      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".gallery-filter-btn");

      if (!modal || !modalImg || allCards.length === 0) return;

      let visibleCards = [...allCards];
      let currentIndex = 0;

      // Filter handling
      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filter = btn.dataset.filter || "all";

          filterBtns.forEach((b) => {
            b.classList.remove("bg-accent", "text-white", "border-accent", "shadow-xs");
            b.classList.add("bg-surface-subtle", "text-muted", "border-border");
          });
          btn.classList.remove("bg-surface-subtle", "text-muted", "border-border");
          btn.classList.add("bg-accent", "text-white", "border-accent", "shadow-xs");

          visibleCards = [];
          allCards.forEach((card) => {
            const cardCat = card.dataset.category || "";
            if (filter === "all" || cardCat === filter) {
              card.classList.remove("hidden");
              visibleCards.push(card);
            } else {
              card.classList.add("hidden");
            }
          });
        });
      });

      function showImage(index: number) {
        if (visibleCards.length === 0) return;
        if (index < 0) index = visibleCards.length - 1;
        if (index >= visibleCards.length) index = 0;
        currentIndex = index;

        const card = visibleCards[currentIndex];
        const src = card.dataset.src || "";
        const alt = card.dataset.alt || "";
        const title = card.dataset.title || "";
        const titleBo = card.dataset.titleBo || "";
        const category = card.dataset.category || "";

        modalImg!.src = src;
        modalImg!.alt = alt;
        if (modalTitle) modalTitle.textContent = title;
        if (modalTitleBo) modalTitleBo.textContent = titleBo;
        if (modalCategory) modalCategory.textContent = category;
        if (modalCounter)
          modalCounter.textContent = `${currentIndex + 1} of ${visibleCards.length}`;
      }

      allCards.forEach((card) => {
        card.addEventListener("click", () => {
          const vIndex = visibleCards.indexOf(card);
          showImage(vIndex !== -1 ? vIndex : 0);
          modal.showModal();
          document.body.classList.add("stop-scrolling");
        });
      });

      prevBtn?.addEventListener("click", () => showImage(currentIndex - 1));
      nextBtn?.addEventListener("click", () => showImage(currentIndex + 1));

      modal.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          showImage(currentIndex - 1);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          showImage(currentIndex + 1);
        }
      });

      // Close when clicking on backdrop
      modal.addEventListener("click", (e) => {
        const rect = modal.getBoundingClientRect();
        const isInDialog =
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width;
        if (!isInDialog) {
          modal.close();
        }
      });

      modal.addEventListener("close", () => {
        document.body.classList.remove("stop-scrolling");
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initGalleryModal);
    } else {
      initGalleryModal();
    }
    document.addEventListener("astro:page-load", initGalleryModal);
  </script>
</PageLayout>
