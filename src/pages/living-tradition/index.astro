---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LivingTraditionHero from "../../components/pages/LivingTraditionHero.astro";
import LivingTraditionToC from "../../components/pages/LivingTraditionToC.astro";
import LivingTraditionContent from "../../components/pages/LivingTraditionContent.astro";
import { STATIC_PAGE_PATHS } from "../../data/staticPages";
---

<BaseLayout
  title="Living Tradition & Daily Life | Jonang Monastery"
  description="Experience daily life at Main Jonang Monastery: pre-dawn puja, dialectical debate in the courtyard, sacred butter sculpture arts, and Himalayan sangha community."
  breadcrumbs={[{ name: "Living Tradition", path: STATIC_PAGE_PATHS.livingTradition }]}
>
  <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
    <!-- 1. Full-Width Viewport Hero -->
    <LivingTraditionHero />

    <!-- 2. Sticky Glass Meridian Bar (Table of Contents) -->
    <LivingTraditionToC />

    <!-- 3. Rich Lived Tradition Content -->
    <LivingTraditionContent />
  </main>
</BaseLayout>
