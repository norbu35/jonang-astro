const fontAudit = {
  total: 234,
  ok: 140,
  degraded: 94,
  okPct: "59.8%",
  degradedPct: "40.2%",
  items: [
    {
      name: "Jomolhari",
      role: "Classical Scripture & Pecha Citations",
      loaded: 73,
      fallback: 161,
      rate: "31.2%",
      fileSize: "~1.1 MB",
    },
    {
      name: "Noto Serif Tibetan",
      role: "Default UI Labels, Master Names & Cards",
      loaded: 37,
      fallback: 197,
      rate: "15.8%",
