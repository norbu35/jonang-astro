---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import KalachakraCurriculumContent from "../../components/pages/KalachakraCurriculumContent.astro";
import StickyPageNav from "../../components/ui/StickyPageNav.astro";
import GlossaryTerm from "../../components/ui/GlossaryTerm.astro";
import { STATIC_PAGE_PATHS } from "../../data/staticPages";

import kalachakraEmblem from "../../assets/images/kalachakra-emblem.webp";

const kalachakraNavItems = [
  { id: "three-kalacakras", label: "01 · Three Kālacakras", short: "01 · Matrix" },
  {
    id: "foundational-accumulations",
    label: "02 · Preliminaries (Ngöndro)",
    short: "02 · Ngöndro",
  },
  { id: "three-isolations", label: "03 · Dark Retreat", short: "03 · Retreat" },
  { id: "visionary-signs", label: "04 · Ten Signs", short: "04 · Signs" },
  { id: "six-yogas", label: "05 · Six-fold Vajrayoga", short: "05 · 6 Yogas" },
  { id: "sahajakaya", label: "06 · Sahajakāya Fruition", short: "06 · Fruition" },
  { id: "retreat-curriculum", label: "07 · 3-Year Retreat", short: "07 · Retreat" },
];
---

<BaseLayout
  title="Kalachakra Practice & Six Yogas | Jonang Monastery"
  description="The unbroken Dro lineage of Kalachakra Tantra preserved at Jonang Monastery: dark retreat three isolations (mun khang) and completion-stage Six-fold Vajrayoga (Sbyor drug)."
  breadcrumbs={[{ name: "Kalachakra Practice", path: STATIC_PAGE_PATHS.kalachakra }]}
>
  <main id="main-content" class="flex-1">
    <!-- I. Museum-Grade Art-Directed Sanctuary Hero (Sangha Red matching Footer & Gold) -->
    <section
      class="relative w-full overflow-hidden bg-gradient-to-b from-maroon-light via-maroon to-maroon-dark text-white border-b border-accent/50 pt-[calc(var(--header-h)+2rem)] sm:pt-[calc(var(--header-h)+2.5rem)] lg:pt-[calc(var(--header-h)+3.5rem)] pb-12 sm:pb-16"
    >
      <!-- Subtle ambient warmth & altar glow -->
      <div
        class="pointer-events-none absolute -top-40 right-1/4 w-[600px] h-[600px] bg-gold/15 blur-[140px] rounded-full"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-40 left-1/4 w-[600px] h-[600px] bg-accent/25 blur-[140px] rounded-full"
        aria-hidden="true"
      >
      </div>

      <!-- Hero Container -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <!-- Left Column: Editorial Lineage Presentation & Narrative -->
          <div class="lg:col-span-6 flex flex-col gap-6 sm:gap-7">
            <!-- Consecrated Tibetan Title -->
            <div
              lang="bo"
              class="font-tibetan text-2xl sm:text-3xl lg:text-4xl text-gold font-bold pt-1 leading-[1.6] drop-shadow-md"
            >
              དཔལ་དུས་ཀྱི་འཁོར་ལོའི་ཟབ་ལམ་སྦྱོར་བ་ཡན་ལག་དྲུག
            </div>

            <!-- Monumental Heading & Prose Group with Generous Spacing -->
            <div class="flex flex-col gap-3.5 sm:gap-4.5">
              <h1
                class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium text-white tracking-tight leading-[1.15] m-0"
              >
                The Kālacakra Six-fold Vajrayoga
              </h1>

              <p class="font-serif text-base sm:text-lg text-white/90 leading-relaxed m-0">
                The Jonang transmission preserves the unbroken contemplative continuum of the <strong
                  ><GlossaryTerm id="six-branch-yoga" class="text-white hover:text-gold border-gold/60">Six-fold Vajrayoga</GlossaryTerm> (<em>Ṣaḍaṅgayoga / Sbyor drug</em>)</strong
                >—the definitive completion-stage practice of the <GlossaryTerm id="kalachakra" class="text-white hover:text-gold border-gold/60">Kālacakra Tantra</GlossaryTerm>, uniting
                <GlossaryTerm id="mahasukha" class="text-white hover:text-gold border-gold/60">immutable great bliss</GlossaryTerm> (<em>mahāsukha</em>) with all-pervasive <GlossaryTerm id="stong-gzugs" class="text-white hover:text-gold border-gold/60">empty form</GlossaryTerm> (<GlossaryTerm id="sunyata" class="text-white hover:text-gold border-gold/60"><em>śūnyatā</em></GlossaryTerm>). While Tibetan history saw dual transmissions through the ritual-focused <GlossaryTerm id="ra-lineage" class="text-white hover:text-gold border-gold/60">Ra Lineage (<em>rwa lugs</em>)</GlossaryTerm> and the meditative <GlossaryTerm id="dro-lineage" class="text-white hover:text-gold border-gold/60">Dro Lineage (<em>'bro lugs</em>)</GlossaryTerm>, the Jonang tradition became the paramount guardian of the Dro contemplative perfection stage.
              </p>
            </div>

            <!-- Canonical Pillars Stream Card in Sangha Crimson & Gold -->
            <div
              class="p-5 sm:p-6 rounded-2xl bg-maroon/90 border border-maroon-border backdrop-blur-md shadow-inner flex flex-col gap-3"
            >
              <div class="border-b border-maroon-border pb-2.5">
                <span
                  class="text-caption uppercase tracking-wider text-gold font-mono font-bold block"
                >
                  The Contemplative Path Structure
                </span>
              </div>
              <ul
                class="m-0 p-0 list-none flex flex-col gap-2.5 text-sm text-white/90 font-serif leading-relaxed"
              >
                <li class="flex items-start gap-2">
                  <span class="text-gold font-bold">•</span>
                  <span
                    ><strong>The Foundational Accumulations:</strong> 500,000 preliminary practices (<GlossaryTerm id="ngondro" class="text-white hover:text-gold border-gold/60"><em>ngöndro</em></GlossaryTerm>) purifying body, speech, and mind.</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold font-bold">•</span>
                  <span
                    ><strong>Dark Retreat & Sensory Deprivation:</strong> 50–100 days in dark cells (<GlossaryTerm id="mun-khang" class="text-white hover:text-gold border-gold/60"><em>mun khang</em></GlossaryTerm>) giving rise to the ten visionary signs of empty form.</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold font-bold">•</span>
                  <span
                    ><strong>The Six Branches of Completion:</strong> Pratyāhāra through Samādhi, transmuting
                    coarse energies into the <GlossaryTerm id="sahajakaya" class="text-white hover:text-gold border-gold/60">Sahaja</GlossaryTerm> rainbow body.</span
                  >
                </li>
              </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 pt-1 sm:pt-2">
              <a
                href="#curriculum-content"
                class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] rounded-full bg-gold hover:bg-accent-secondary-hover text-ink font-bold text-xs sm:text-sm uppercase tracking-wider transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5"
              >
                <span>Read Contemplative Treatise</span>
                <span>↓</span>
              </a>

              <a
                href={STATIC_PAGE_PATHS.curriculum}
                class="inline-flex items-center gap-2 px-5 py-3 min-h-[44px] rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-white border border-white/25 hover:border-gold/60 font-semibold text-xs sm:text-sm uppercase tracking-wider transition-all backdrop-blur-md"
              >
                <span>View 18-Year Shedra Syllabus</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Consecrated Thangka Showcase in Sangha Red & Gold Archival Frame -->
          <div class="lg:col-span-6 flex flex-col items-center">
            <div class="relative w-full max-w-lg lg:max-w-none group/thangka">
              <!-- Buddhist Sangha Crimson & Gold Filigree Frame -->
              <div
                class="relative rounded-2xl sm:rounded-3xl p-2.5 sm:p-3.5 bg-gradient-to-b from-maroon-light via-maroon to-maroon-dark border border-gold/40 shadow-2xl backdrop-blur-md"
              >
                <div
                  class="relative aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-maroon-dark shadow-inner"
                >
                  <Image
                    src={kalachakraEmblem}
                    alt="The All-Powerful Ten-Fold Syllable Monogram of Kalachakra (Rnam bcu dbang ldan)"
                    class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover/thangka:scale-105 pointer-events-none"
                    loading="eager"
                    fetchpriority="high"
                  />

                  <!-- Subtle bottom caption scrim -->
                  <div
                    class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"
                  >
                  </div>

                  <div
                    class="absolute bottom-3 left-4 right-4 text-white space-y-0.5 pointer-events-none"
                  >
                    <span
                      class="text-caption-xs uppercase tracking-wider text-gold font-mono font-bold block"
                    >
                      Jonang Dzamthang Tradition
                    </span>
                    <span class="text-[11px] text-white/90 leading-tight block">
                      The Ten-Fold Powerful Monogram of Kālacakra
                    </span>
                  </div>
                </div>
              </div>

              <!-- Caption Metadata Footer -->
              <div class="flex items-center justify-between text-caption text-white/80 pt-3 px-2">
                <span>Jonang Takten Phuntsok Choeling Archival Collection</span>
                <span class="font-mono text-gold">Sanjauli, Shimla</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky Section Navigation Rail -->
    <StickyPageNav items={kalachakraNavItems} ariaLabel="Kalachakra Navigation & Reading Index" />

    <!-- II. Scholastic Contemplative Treatise Container -->
    <div
      id="curriculum-content"
      class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 py-14 sm:py-20"
    >
      <KalachakraCurriculumContent />
    </div>
  </main>
</BaseLayout>
