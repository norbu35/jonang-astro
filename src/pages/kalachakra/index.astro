---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import KalachakraCurriculumContent from "../../components/pages/KalachakraCurriculumContent.astro";

import kalachakraEmblem from "../../assets/images/kalachakra-emblem.webp";
---

<BaseLayout
  title="Kalachakra Practice & Six-fold Vajrayoga"
  description="The Jonang Kalachakra contemplative path: foundational accumulations (ngöndro), dark retreat sensory isolation, and the completion-stage Six-fold Vajrayoga (Sbyor drug) preserved in exile at Sanjauli, Shimla."
>
  <main id="main-content" class="flex-1">
    <!-- I. Museum-Grade Art-Directed Sanctuary Hero (Sangha Red matching Footer & Gold) -->
    <section class="relative w-full overflow-hidden bg-gradient-to-b from-[#8f1e21] via-[#7b171a] to-[#661214] text-white border-b border-[#992224]/50 pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24">
      
      <!-- Subtle ambient warmth & altar glow -->
      <div class="pointer-events-none absolute -top-40 right-1/4 w-[600px] h-[600px] bg-[#fcd34d]/15 blur-[140px] rounded-full" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-40 left-1/4 w-[600px] h-[600px] bg-[#992224]/25 blur-[140px] rounded-full" aria-hidden="true"></div>

      <!-- Hero Container -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 relative z-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          
          <!-- Left Column: Editorial Lineage Presentation & Narrative -->
          <div class="lg:col-span-6 flex flex-col gap-6 sm:gap-7">

            <!-- Consecrated Tibetan Title -->
            <div
              lang="bo"
              class="font-tibetan text-2xl sm:text-3xl lg:text-4xl text-[#fdbc2d] font-bold leading-relaxed drop-shadow-md"
            >
              དཔལ་དུས་ཀྱི་འཁོར་ལོའི་ཟབ་ལམ་སྦྱོར་བ་ཡན་ལག་དྲུག
            </div>

            <!-- Monumental Heading & Prose Group with Generous Spacing -->
            <div class="flex flex-col gap-3.5 sm:gap-4.5">
              <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium text-white tracking-tight leading-[1.15] m-0">
                The Kālacakra Six-fold Vajrayoga
              </h1>

              <p class="font-serif text-base sm:text-lg text-white/90 leading-relaxed m-0">
                The Jonang transmission preserves the unbroken contemplative continuum of the <strong>Six-fold Vajrayoga (<em>Ṣaḍaṅgayoga / Sbyor drug</em>)</strong>—the definitive completion-stage practice of the Kālacakra Tantra, uniting immutable great bliss (<em>mahāsukha</em>) with all-pervasive empty form (<em>śūnyatā</em>).
              </p>
            </div>

            <!-- Canonical Pillars Stream Card in Sangha Crimson & Gold -->
            <div class="p-5 sm:p-6 rounded-2xl bg-[#500c0e]/90 border border-[#85181b] backdrop-blur-md shadow-inner flex flex-col gap-3">
              <div class="flex items-center justify-between border-b border-[#85181b] pb-2.5">
                <span class="text-caption uppercase tracking-wider text-[#fdbc2d] font-mono font-bold">
                  The Contemplative Path Structure:
                </span>
                <span class="text-sm sm:text-base font-tibetan text-[#fdbc2d] font-bold">ལམ་གྱི་རིམ་པ།</span>
              </div>
              <ul class="m-0 p-0 list-none flex flex-col gap-2.5 text-sm text-white/90 font-serif leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-[#fdbc2d] font-bold">•</span>
                  <span><strong>The Foundational Accumulations:</strong> 500,000 preliminary practices (<em>ngöndro</em>) purifying body, speech, and mind.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-[#fdbc2d] font-bold">•</span>
                  <span><strong>Dark Retreat & Sensory Deprivation:</strong> 50–100 days in dark cells (<em>mun khang</em>) giving rise to the ten visionary signs of empty form.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-[#fdbc2d] font-bold">•</span>
                  <span><strong>The Six Branches of Completion:</strong> Pratyāhāra through Samādhi, transmuting coarse energies into the Sahaja rainbow body.</span>
                </li>
              </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 pt-1 sm:pt-2">
              <a
                href="#curriculum-content"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#fdbc2d] hover:bg-[#fed36c] text-[#1c1210] font-bold text-xs sm:text-sm uppercase tracking-wider transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5"
              >
                <span>Read Contemplative Treatise</span>
                <span>↓</span>
              </a>
              
              <a
                href="/curriculum"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-white border border-white/25 hover:border-[#fdbc2d]/60 font-semibold text-xs sm:text-sm uppercase tracking-wider transition-all backdrop-blur-md"
              >
                <span>View 18-Year Shedra Syllabus</span>
                <span>→</span>
              </a>
            </div>

          </div>

          <!-- Right Column: Consecrated Thangka Showcase in Sangha Red & Gold Archival Frame -->
          <div class="lg:col-span-6 flex flex-col items-center">
            
            <div class="relative w-full max-w-lg lg:max-w-none group/thangka">
              
              <!-- Buddhist Sangha Crimson & Gold Filigree Frame -->
              <div class="relative rounded-2xl sm:rounded-3xl p-2.5 sm:p-3.5 bg-gradient-to-b from-[#7b171a] via-[#5c1012] to-[#450b0c] border border-[#fdbc2d]/40 shadow-2xl backdrop-blur-md">
                
                <div class="relative aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-[#3b0809] shadow-inner">
                  <Image
                    src={kalachakraEmblem}
                    alt="The All-Powerful Ten-Fold Syllable Monogram of Kalachakra (Rnam bcu dbang ldan)"
                    class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover/thangka:scale-105 pointer-events-none"
                    loading="eager"
                    fetchpriority="high"
                  />

                  <!-- Subtle bottom caption scrim -->
                  <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"></div>

                  <div class="absolute bottom-3 left-4 right-4 text-white space-y-0.5 pointer-events-none">
                    <span class="text-caption-xs uppercase tracking-wider text-[#fdbc2d] font-mono font-bold block">
                      Jonang Dzamthang Tradition · རྣམ་བཅུ་དབང་ལྡན།
                    </span>
                    <span class="text-[11px] text-white/90 leading-tight block">
                      The Ten-Fold Powerful Monogram of Kālacakra
                    </span>
                  </div>
                </div>

              </div>

              <!-- Caption Metadata Footer -->
              <div class="flex items-center justify-between text-caption text-white/80 pt-3 px-2">
                <span>Jonang Takten Phuntsok Choeling Archival Collection</span>
                <span class="font-mono text-[#fdbc2d]">Sanjauli, Shimla</span>
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- II. Scholastic Contemplative Treatise Container -->
    <div id="curriculum-content" class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 py-14 sm:py-20">
      <KalachakraCurriculumContent />
    </div>
  </main>
</BaseLayout>
