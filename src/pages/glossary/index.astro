---
import PageLayout from "../../layouts/PageLayout.astro";
import { getAllGlossaryEntries, GLOSSARY_CATEGORIES } from "../../data/glossary";
import ChapterHeader from "../../components/ui/ChapterHeader.astro";
import Dharmachakra from "../../components/icons/Dharmachakra.astro";

const terms = getAllGlossaryEntries();

// Extract unique first letters for the alphabetical jump bar
const alphabet = Array.from(new Set(terms.map((t) => t.termEn[0].toUpperCase()))).sort();
---

<PageLayout
  title="Glossary"
  tibetanTitle="ཚིག་མཛོད།"
  description="Comprehensive lexicon and glossary of Jonang philosophy, Shentong view, Kalachakra completion stage, and monastic vocabulary."
>
  <div class="space-y-10 py-6 sm:py-8">
    <!-- Chapter Header -->
    <ChapterHeader
      chapter="Lexicon"
      title="The Living Vocabulary of Jonang"
      tibetanTitle="ཇོ་ནང་བཀའ་བབས་ཀྱི་ཐ་སྙད་ཚིག་མཛོད།"
      lede="A scholarly index of Tibetan, Sanskrit, and English philosophical, tantric, and monastic terminology. Each term is cataloged with its canonical Tibetan Uchen script, Wylie transliteration, and doctrinal context."
    />

    <!-- Interactive Search & Filter Controls -->
    <div class="surface-card p-5 sm:p-7 rounded-2xl border border-border shadow-xs space-y-5 bg-surface">
      <!-- Search Input -->
      <div class="relative">
        <label for="glossary-search" class="sr-only">Search glossary terms</label>
        <div class="relative flex items-center">
          <svg
            class="w-5 h-5 absolute left-4 text-muted pointer-events-none"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <input
            type="search"
            id="glossary-search"
            placeholder="Search by English, Tibetan, Wylie, or Sanskrit..."
            class="w-full pl-11 pr-24 py-3 bg-surface-subtle border border-border rounded-xl text-ink placeholder:text-muted/70 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent text-sm sm:text-base font-body transition-all"
          />
          <button
            type="button"
            id="glossary-clear"
            class="absolute right-3 px-2 py-1 text-xs font-mono uppercase text-muted hover:text-ink hidden transition-colors"
          >
            Clear
          </button>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-1" id="category-filters">
        {
          GLOSSARY_CATEGORIES.map((cat) => (
            <button
              type="button"
              data-cat-filter={cat.id}
              class={`px-3 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider font-semibold border transition-all cursor-pointer ${
                cat.id === "all"
                  ? "bg-accent text-white border-accent shadow-xs"
                  : "bg-surface-subtle text-muted hover:text-ink border-border hover:border-accent/40"
              }`}
            >
              <span>{cat.labelEn}</span>
              <span class="font-tibetan ml-1 text-sm font-normal opacity-85">({cat.labelBo})</span>
            </button>
          ))
        }
      </div>

      <!-- Alphabetical Jump Bar & Result Count -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-border/80 text-xs font-mono">
        <div class="flex flex-wrap items-center gap-1.5" id="alphabet-bar">
          <span class="text-muted font-bold mr-1 uppercase">Jump:</span>
          {
            alphabet.map((letter) => (
              <a
                href={`#letter-${letter}`}
                class="px-2 py-0.5 rounded hover:bg-accent/10 hover:text-accent text-muted transition-colors"
              >
                {letter}
              </a>
            ))
          }
        </div>
        <div id="result-count" class="text-muted font-semibold">
          Showing <span id="visible-count">{terms.length}</span> of {terms.length} terms
        </div>
      </div>
    </div>

    <!-- Empty Results Banner -->
    <div
      id="no-results-banner"
      class="hidden surface-card p-10 rounded-2xl border border-dashed border-border text-center space-y-3"
    >
      <Dharmachakra class="w-8 h-8 text-muted mx-auto" />
      <h3 class="font-display text-xl text-ink m-0">No matching terminology found</h3>
      <p class="text-sm text-muted font-serif max-w-md mx-auto m-0">
        We could not find any terms matching your current search or category filter.
      </p>
      <button
        type="button"
        id="reset-search-btn"
        class="mt-2 px-4 py-2 rounded-xl bg-accent text-white text-xs font-mono uppercase tracking-wider font-bold hover:bg-accent-secondary hover:text-ink transition-colors"
      >
        Reset Filters
      </button>
    </div>

    <!-- Terminology Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch" id="glossary-grid">
      {
        terms.map((term) => {
          const firstLetter = term.termEn[0].toUpperCase();
          return (
            <article
              id={term.id}
              data-term-id={term.id}
              data-category={term.category}
              data-first-letter={firstLetter}
              data-search-corpus={`${term.termEn} ${term.termBo} ${term.wylie} ${term.termSkt || ""} ${term.aliases?.join(" ") || ""} ${term.shortDef} ${term.fullDef}`.toLowerCase()}
              class="glossary-card surface-card p-6 sm:p-7 rounded-2xl border border-border border-t-4 border-t-accent hover-lift flex flex-col justify-between h-full bg-surface shadow-xs scroll-mt-28 transition-all duration-300"
            >
              <div class="space-y-3">
                <!-- Card Header -->
                <div class="flex items-baseline justify-between gap-2 border-b border-border/80 pb-3">
                  <span class="px-2.5 py-0.5 rounded bg-accent/10 text-accent font-mono text-xs font-bold uppercase tracking-wider">
                    {term.category}
                  </span>
                  <a
                    href={`#${term.id}`}
                    class="text-xs text-muted hover:text-accent font-mono flex items-center gap-1 transition-colors"
                    title="Permanent link to term"
                    aria-label={`Link to ${term.termEn}`}
                  >
                    <span>#{term.id}</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                    </svg>
                  </a>
                </div>

                <!-- Titles & Tibetan Script -->
                <div class="space-y-1">
                  <span class="text-lg sm:text-xl text-accent font-tibetan font-bold block pt-1 leading-[1.6]">
                    {term.termBo}
                  </span>
                  <h3 class="font-display text-2xl sm:text-3xl font-bold text-ink leading-tight m-0">
                    {term.termEn}
                  </h3>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs sm:text-sm font-mono text-muted pt-1">
                    <span>
                      Wylie: <strong class="text-ink/80 font-normal">{term.wylie}</strong>
                    </span>
                    {term.termSkt && (
                      <span class="border-l border-border pl-3 italic font-sans text-ink/75">
                        Skt: {term.termSkt}
                      </span>
                    )}
                  </div>
                </div>

                <!-- Comprehensive Doctrinal Definition -->
                <p class="text-base text-ink/85 leading-relaxed font-serif m-0 pt-2">
                  {term.fullDef}
                </p>
              </div>

              <!-- Related Terminology Cross-Links -->
              {term.relatedIds && term.relatedIds.length > 0 && (
                <div class="pt-4 mt-6 border-t border-border/80 flex flex-wrap items-center gap-2">
                  <span class="text-xs font-mono uppercase text-muted font-semibold mr-1">
                    Related:
                  </span>
                  {term.relatedIds.map((rId) => (
                    <a
                      href={`#${rId}`}
                      class="px-2 py-0.5 rounded bg-surface-subtle border border-border/80 hover:border-accent hover:text-accent text-xs font-mono text-ink/80 transition-colors"
                    >
                      {rId}
                    </a>
                  ))}
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</PageLayout>

<script>
  function setupGlossaryFilters() {
    const searchInput = document.getElementById("glossary-search") as HTMLInputElement | null;
    const clearBtn = document.getElementById("glossary-clear");
    const resetBtn = document.getElementById("reset-search-btn");
    const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-cat-filter]");
    const cards = document.querySelectorAll<HTMLElement>(".glossary-card");
    const visibleCountEl = document.getElementById("visible-count");
    const noResultsBanner = document.getElementById("no-results-banner");
    const grid = document.getElementById("glossary-grid");

    let currentCategory = "all";
    let searchQuery = "";

    function filterCards() {
      let visibleCount = 0;
      const q = searchQuery.toLowerCase().trim();

      cards.forEach((card) => {
        const cat = card.getAttribute("data-category");
        const corpus = card.getAttribute("data-search-corpus") || "";

        const matchesCat = currentCategory === "all" || cat === currentCategory;
        const matchesQuery = !q || corpus.includes(q);

        if (matchesCat && matchesQuery) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (visibleCountEl) {
        visibleCountEl.textContent = visibleCount.toString();
      }

      if (noResultsBanner && grid) {
        if (visibleCount === 0) {
          noResultsBanner.classList.remove("hidden");
          grid.classList.add("hidden");
        } else {
          noResultsBanner.classList.add("hidden");
          grid.classList.remove("hidden");
        }
      }

      if (clearBtn) {
        if (q.length > 0) {
          clearBtn.classList.remove("hidden");
        } else {
          clearBtn.classList.add("hidden");
        }
      }
    }

    // Search input listener
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        filterCards();
      });
    }

    // Clear search
    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchQuery = "";
          searchInput.focus();
          filterCards();
        }
      });
    }

    // Reset filters button
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        currentCategory = "all";
        updateCategoryButtons();
        filterCards();
      });
    }

    function updateCategoryButtons() {
      filterButtons.forEach((btn) => {
        const cat = btn.getAttribute("data-cat-filter");
        if (cat === currentCategory) {
          btn.className =
            "px-3 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider font-semibold border transition-all cursor-pointer bg-accent text-white border-accent shadow-xs";
        } else {
          btn.className =
            "px-3 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider font-semibold border transition-all cursor-pointer bg-surface-subtle text-muted hover:text-ink border-border hover:border-accent/40";
        }
      });
    }

    // Category button listener
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-cat-filter") || "all";
        currentCategory = cat;
        updateCategoryButtons();
        filterCards();
      });
    });

    // Handle hash anchoring with highlight flash
    function handleAnchorHighlight() {
      const hash = window.location.hash.slice(1);
      if (!hash) return;
      const targetCard = document.getElementById(hash);
      if (targetCard) {
        // If hidden by category filter, reset to "all" to reveal
        if (targetCard.classList.contains("hidden")) {
          currentCategory = "all";
          updateCategoryButtons();
          filterCards();
        }

        setTimeout(() => {
          targetCard.scrollIntoView({ behavior: "smooth", block: "center" });
          targetCard.classList.add("ring-2", "ring-accent", "ring-offset-4", "ring-offset-bg");
          setTimeout(() => {
            targetCard.classList.remove("ring-2", "ring-accent", "ring-offset-4", "ring-offset-bg");
          }, 2500);
        }, 100);
      }
    }

    window.addEventListener("hashchange", handleAnchorHighlight);
    handleAnchorHighlight();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupGlossaryFilters);
  } else {
    setupGlossaryFilters();
  }

  document.addEventListener("astro:page-load", setupGlossaryFilters);
</script>
