---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BioCard from "../../components/BioCard.astro";
import { TEACHERS } from "../../data/teachers";
import GlossaryTerm from "../../components/ui/GlossaryTerm.astro";

import refugeTreeImage from "../../assets/images/jonang-refuge-tree.webp";
---

<BaseLayout title="Holders of the Lineage">
  <main id="main-content" class="flex-1">
    <!-- I. Museum-Grade Art-Directed Sanctuary Hero (Sangha Red matching Footer & Gold) -->
    <section
      class="relative w-full overflow-hidden bg-gradient-to-b from-[#8f1e21] via-[#7b171a] to-[#661214] text-white border-b border-[#992224]/50 pt-[calc(var(--header-h)+2rem)] sm:pt-[calc(var(--header-h)+2.5rem)] lg:pt-[calc(var(--header-h)+3.5rem)] pb-12 sm:pb-16"
    >
      <!-- Subtle ambient warmth & temple glow -->
      <div
        class="pointer-events-none absolute -top-40 right-1/4 w-[600px] h-[600px] bg-[#fcd34d]/20 blur-[150px] mix-blend-screen rounded-full"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-40 left-1/4 w-[600px] h-[600px] bg-[#992224]/25 blur-[130px] rounded-full"
        aria-hidden="true"
      >
      </div>

      <!-- Hero Container -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <!-- Left Column: Editorial Lineage Presentation & Narrative -->
          <div class="lg:col-span-6 flex flex-col gap-6 sm:gap-7">
            <!-- Consecrated Tibetan Title -->
            <div
              lang="bo"
              class="font-tibetan text-2xl sm:text-3xl lg:text-4xl text-[#fdbc2d] font-bold leading-relaxed drop-shadow-md"
            >
              ཇོ་ནང་བཀའ་བབས་བརྒྱུད་པའི་བླ་མ་རྣམས་ཀྱི་རྣམ་ཐར།
            </div>

            <!-- Monumental Heading & Prose Group with Generous Spacing -->
            <div class="flex flex-col gap-3.5 sm:gap-4.5">
              <h1
                class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium text-white tracking-tight leading-[1.15] m-0"
              >
                Holders of the Lineage
              </h1>

              <p class="font-serif text-base sm:text-lg text-white/90 leading-relaxed m-0">
                An unbroken spiritual transmission descending from the Indian Mahasiddhas and the
                <GlossaryTerm id="dro-lineage" class="text-white hover:text-gold border-gold/60">Dro Kālacakra masters</GlossaryTerm>, preserved today by the resident abbots and teachers of Main
                Jonang Takten Phuntsok Choeling in Sanjauli, Shimla.
              </p>
            </div>

            <!-- Lineage Transmission Stream Card in Sangha Crimson & Gold -->
            <div
              class="p-5 sm:p-6 rounded-2xl bg-[#500c0e]/90 border border-[#85181b] backdrop-blur-md shadow-inner flex flex-col gap-3"
            >
              <div class="border-b border-[#85181b] pb-2.5">
                <span
                  class="text-caption uppercase tracking-wider text-[#fdbc2d] font-mono font-bold block"
                >
                  The Three Lineage Streams
                </span>
              </div>
              <ul
                class="m-0 p-0 list-none flex flex-col gap-2.5 text-sm text-white/90 font-serif leading-relaxed"
              >
                <li class="flex items-start gap-2">
                  <span class="text-[#fdbc2d] font-bold">•</span>
                  <span
                    ><strong>Indian Mahasiddhas:</strong> Shākyamuni Buddha, <GlossaryTerm id="shambhala" class="text-white hover:text-gold border-gold/60">Shambhala Kings</GlossaryTerm> (<GlossaryTerm id="kalki" class="text-white hover:text-gold border-gold/60">Kalkī / Rigden</GlossaryTerm>) & Nāgārjuna.</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-[#fdbc2d] font-bold">•</span>
                  <span
                    ><strong>Dro Kālacakra Masters:</strong> Yumo Mikyö Dorje, <GlossaryTerm id="dolpopa" class="text-white hover:text-gold border-gold/60">Dolpopa</GlossaryTerm> & <GlossaryTerm id="taranatha" class="text-white hover:text-gold border-gold/60">Jetsun Tāranātha</GlossaryTerm>.</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-[#fdbc2d] font-bold">•</span>
                  <span
                    ><strong>Living Seat in Exile:</strong> Supreme Lineage Head (<GlossaryTerm id="jetsun-dampa" class="text-white hover:text-gold border-gold/60">Jetsun Dampa</GlossaryTerm>) & Abbots of Shimla.</span
                  >
                </li>
              </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 pt-1 sm:pt-2">
              <a
                href="#teachers-index"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#fdbc2d] hover:bg-[#fed36c] text-[#1c1210] font-bold text-xs sm:text-sm uppercase tracking-wider transition-all shadow-md hover:shadow-[0_0_20px_rgba(253,188,45,0.4)] hover:-translate-y-1 active:scale-[0.97]"
              >
                <span>Explore Resident Masters</span>
                <span>↓</span>
              </a>

              <a
                href="https://www.himalayanart.org/items/98911/images/primary#-1333,-2445,2930,-313"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-white border border-white/25 hover:border-[#fdbc2d]/60 font-semibold text-xs sm:text-sm uppercase tracking-wider transition-all backdrop-blur-md active:scale-[0.97]"
              >
                <span>Inspect Thangka (HAR 98911)</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Vivid, Radiant Artwork Showcase in Sangha Red & Gold Archival Frame -->
          <div class="lg:col-span-6 flex flex-col items-center">
            <div class="relative w-full max-w-lg lg:max-w-none group/thangka">
              <!-- Buddhist Sangha Crimson & Gold Filigree Frame -->
              <div
                class="relative rounded-2xl sm:rounded-3xl p-2.5 sm:p-3.5 bg-gradient-to-b from-[#7b171a] via-[#5c1012] to-[#450b0c] border border-[#fdbc2d]/40 shadow-2xl backdrop-blur-md"
              >
                <div
                  class="relative aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-[#3b0809] shadow-inner"
                >
                  <Image
                    src={refugeTreeImage}
                    alt="19th-Century Jonang Lineage Refuge Tree (Tshogs zhing) Thangka in Dzamthang Style"
                    width={1000}
                    height={1333}
                    class="w-full h-full object-cover object-center transition-transform duration-1000 ease-out group-hover/thangka:scale-105"
                    loading="eager"
                    fetchpriority="high"
                  />

                  <!-- Elegant subtle bottom caption scrim -->
                  <div
                    class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent pointer-events-none"
                  >
                  </div>

                  <div class="absolute bottom-4 left-4 right-4 text-white space-y-1">
                    <span
                      class="text-caption uppercase tracking-wider text-[#fdbc2d] font-mono font-bold block"
                    >
                      Jonang Lineage Refuge Field
                    </span>
                    <span class="text-xs text-white/90 leading-snug block">
                      19th Century · Ground Mineral Pigment on Cotton · Hahn Cultural Foundation
                    </span>
                  </div>

                  <!-- Zoom Trigger Badge -->
                  <a
                    href="https://www.himalayanart.org/items/98911/images/primary#-1333,-2445,2930,-313"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute top-3 right-3 bg-black/80 backdrop-blur-md rounded-full px-3 py-1.5 text-xs font-mono text-[#fdbc2d] border border-[#fdbc2d]/50 opacity-90 sm:opacity-0 sm:group-hover/thangka:opacity-100 transition-all flex items-center gap-1.5 shadow-lg hover:scale-105"
                    aria-label="Zoom into high-resolution painting on Himalayan Art Resources"
                  >
                    <span>Zoom Lineage Masters</span>
                    <span>⚲</span>
                  </a>
                </div>
              </div>

              <!-- Caption Metadata Footer -->
              <div class="flex items-center justify-between text-caption text-white/80 pt-3 px-2">
                <span>Hahn Cultural Foundation Collection</span>
                <span class="font-mono text-[#fdbc2d]">HAR Item 98911</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div
      id="teachers-index"
      class="section-padding mx-auto flex w-full max-w-6xl flex-col gap-12 sm:gap-16 reveal-on-scroll"
    >
      <!-- Filter Index for Resident Teachers -->
      <div class="space-y-4 pt-4 sm:pt-8">
        <div class="text-center space-y-1.5">
          <h2
            class="text-3xl sm:text-4xl lg:text-5xl font-display text-ink font-normal leading-tight m-0"
          >
            Resident Abbots & Teachers
          </h2>
          <p class="text-sm sm:text-base text-muted max-w-lg mx-auto font-serif m-0">
            Select a master below to navigate their biography and lineage legacy:
          </p>
        </div>

        <nav
          class="flex items-center justify-center border-t border-b border-border/40 py-5 sm:py-6"
          aria-label="Lineage Index"
        >
          <ul
            class="flex flex-wrap justify-center items-center gap-2 sm:gap-2.5 md:gap-3 text-sm text-ink/90 m-0 p-0"
          >
            {
              TEACHERS.map((teacher) => (
                <li class="my-0 list-none">
                  <a
                    href={`#${teacher.id}`}
                    class="inline-flex items-center justify-center rounded-full px-4 py-2 sm:py-2.5 min-h-[40px] bg-surface-subtle/80 hover:bg-surface border border-border/60 hover:border-accent-secondary hover:text-accent-secondary transition-all text-xs sm:text-sm font-sans font-medium text-ink/85 shadow-xs hover:-translate-y-1 hover:shadow-[0_4px_12px_rgba(253,188,45,0.15)] active:scale-[0.98]"
                  >
                    {teacher.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <!-- Teacher Biocards Grid -->
      {
        TEACHERS.map((teacher) => (
          <BioCard
            img={teacher.portrait}
            name={teacher.name}
            roles={teacher.roles}
            bio={teacher.bioHtml}
            id={teacher.id}
            portraitAlt={teacher.portraitAlt}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>
