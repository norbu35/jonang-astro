---
import PageLayout from "../../layouts/PageLayout.astro";
import type { Teacher } from "../../../payload-types";
import BioCard from "../../components/BioCard.astro";

const res = await fetch(`${import.meta.env.CMS_API_URL}/teachers`);
const data = await res.json();

const sortedTeachers = data.docs
  .slice()
  .sort(
    (a: Teacher, b: Teacher) => a.orderOfAppearance - b.orderOfAppearance,
  );
---

<PageLayout title="Jonang Teachers">
  <div
    slot="full=width"
    class="section-padding pb-24 md:pb-32 mx-auto flex w-full max-w-350 flex-col gap-12 md:gap-16 reveal-on-scroll"
  >
    <div class="mx-auto w-full max-w-4xl text-center pt-8 md:pt-16">
      <h1 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] font-medium text-ink tracking-tight mb-0">
        Holders of the Lineage
      </h1>
    </div>
    
    <nav class="mb-10 md:mb-16 flex items-center justify-center border-t border-b border-border/40 py-8" aria-label="Lineage Index">
      <ul class="flex flex-wrap justify-center items-center gap-x-3 gap-y-3 md:gap-x-4 text-base md:text-lg text-ink/90 font-display italic">
        {
          sortedTeachers.map((teacher: Teacher, index: number) => (
            <li class="my-0 list-none flex items-center">
                <a
                  href={`#${teacher.id}`}
                  class="hover:text-accent-secondary transition-colors underline-offset-4 hover:underline"
                >
                  {teacher.name}
                </a>
                {index < sortedTeachers.length - 1 && (
                  <span class="text-saffron/50 ml-3 md:ml-4 select-none text-xl font-sans not-italic">·</span>
                )}
            </li>
          ))
        }
      </ul>
    </nav>

    {
      sortedTeachers.map((teacher: Teacher) => (
        <BioCard
          img={teacher.portrait!}
          name={teacher.name}
          roles={teacher.roles!}
          bio={teacher.bioHtml!}
          id={teacher.id}
        />
      ))
    }
  </div>
</PageLayout>
