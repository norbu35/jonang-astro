---
import PageLayout from "../layouts/PageLayout.astro";
import RichTextSection from "../components/RichTextSection.astro";
import { STATIC_PAGE_SLUGS } from "../data/staticPages";
import type { Page } from "../../payload-types";

export async function getStaticPaths() {
  try {
    const response = await fetch(`${import.meta.env.CMS_API_URL}/pages`);

    if (!response.ok) {
      throw Error("Error fetching data.");
    }

    const data = await response.json();
    const pages: Page[] = data.docs;

    return pages
      .filter((page) => page.slug && !STATIC_PAGE_SLUGS.has(page.slug))
      .map(({ slug, title, contentHtml }) => ({
        params: { slug },
        props: { title, contentHtml },
      }));
  } catch (error: any) {
    throw Error(error);
  }
}

const { title, contentHtml } = Astro.props;
 
---

<PageLayout title={title}>
  <RichTextSection>
    <Fragment set:html={contentHtml} />
  </RichTextSection>
</PageLayout>
