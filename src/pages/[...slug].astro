---
import PageLayout from "../layouts/PageLayout.astro";
import type { Page } from "../../payload-types";

export async function getStaticPaths() {
  try {
    const response = await fetch(`${import.meta.env.CMS_API_URL}/pages`);

    if (!response.ok) {
      throw Error("Error fetching data.");
    }

    const data = await response.json();
    const pages: Page[] = data.docs;

    return pages.map(({ slug, title, contentHtml }) => ({
      params: { slug },
      props: { title, contentHtml },
    }));
  } catch (error: any) {
    throw Error(error);
  }
}

const { title, contentHtml } = Astro.props;
---

<PageLayout title={title}>
  <section class="section-padding textured-panel">
    <div class="rich-text mx-auto max-w-3xl" set:html={contentHtml} />
  </section>
</PageLayout>

<script is:inline>
  const lists = document.querySelectorAll(".rich-text ol");

  lists.forEach((list) => {
    const items = Array.from(list.querySelectorAll("li"));
    if (!items.length) return;

    const matches = items.filter((item) =>
      /^\s*\d+[\.\)]\s+/.test(item.textContent ?? ""),
    ).length;

    if (matches >= 2 || (items.length === 1 && matches === 1)) {
      list.classList.add("is-manual-numbered");
    }
  });
</script>
