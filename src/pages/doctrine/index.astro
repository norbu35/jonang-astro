---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import JonangDoctrineContent from "../../components/pages/JonangDoctrineContent.astro";
import StickyPageNav from "../../components/ui/StickyPageNav.astro";

import protectorThangka from "../../assets/images/raudrantaka-dzamthang-thangka.webp";

const doctrineNavItems = [
  { id: "shentong-view", label: "01 · Shentong View", short: "01 · Shentong" },
  { id: "three-turnings", label: "02 · Three Turnings", short: "02 · Turnings" },
  { id: "dolpopa-documentary", label: "03 · Dolpopa Film", short: "03 · Film" },
  { id: "comparative-matrix", label: "04 · Rangtong & Shentong", short: "04 · Matrix" },
  { id: "lineage-masters", label: "05 · Lineage Masters", short: "05 · Masters" },
  { id: "dialectics-integration", label: "06 · Sutra & Tantra", short: "06 · Integration" },
  { id: "shentong-bibliography", label: "07 · Bibliography", short: "07 · Library" },
];
---

<BaseLayout title="The Jonang Doctrine & Shentong View">
  <main id="main-content" class="flex-1">
    <!-- I. Museum-Grade Art-Directed Sanctuary Hero (Tibetan Monastic Crimson & Gold) -->
    <section class="relative w-full overflow-hidden bg-gradient-to-b from-[#8f1e21] via-[#7b171a] to-[#661214] text-white border-b border-[#992224]/50 pt-20 sm:pt-24 lg:pt-28 pb-12 sm:pb-16">
      
      <!-- Subtle ambient sangha crimson & warm gold temple glow -->
      <div class="pointer-events-none absolute -top-40 right-1/4 w-[600px] h-[600px] bg-[#fdbc2d]/20 blur-[150px] mix-blend-screen rounded-full" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-40 left-1/4 w-[600px] h-[600px] bg-[#500c0e]/60 blur-[130px] rounded-full" aria-hidden="true"></div>

      <!-- Hero Container -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 relative z-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          
          <!-- Left Column: Editorial Lineage Presentation & Narrative -->
          <div class="lg:col-span-6 flex flex-col gap-6 sm:gap-7">

            <!-- Consecrated Tibetan Title -->
            <div
              lang="bo"
              class="font-tibetan text-2xl sm:text-3xl lg:text-4xl text-[#fdbc2d] font-bold leading-relaxed drop-shadow-md"
            >
              ཇོ་ནང་གཞན་སྟོང་དབུ་མ་ཆེན་པོའི་ལྟ་གྲུབ།
            </div>

            <!-- Monumental Heading & Prose Group with Generous Spacing -->
            <div class="flex flex-col gap-3.5 sm:gap-4.5">
              <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium text-white tracking-tight leading-[1.15] m-0 drop-shadow-md">
                The Jonang Doctrine & Shentong View
              </h1>

              <p class="font-serif text-base sm:text-lg text-white/90 leading-relaxed m-0">
                The philosophical system of the Jonang tradition articulates the <strong>Shentong Great Madhyamaka</strong>: conventional phenomena are empty of self-nature (<em>rangtong</em>), while ultimate reality—unconditioned primordial wisdom and Buddha-nature (<em>Tathāgatagarbha</em>)—is empty only of adventitious obscurations.
              </p>
            </div>

            <!-- Canonical Pillars Stream Card (Monastic Sangha Maroon Style) -->
            <div class="p-5 sm:p-6 rounded-2xl bg-[#500c0e]/90 border border-[#85181b] backdrop-blur-md shadow-inner flex flex-col gap-3">
              <div class="flex items-center justify-between border-b border-[#85181b]/60 pb-2.5">
                <span class="text-caption uppercase tracking-wider text-[#fdbc2d] font-mono font-bold">
                  Core Doctrinal Pillars:
                </span>
                <span class="text-sm sm:text-base font-tibetan text-[#fdbc2d] font-bold">ལྟ་གྲུབ་གནད་བསྡུས།</span>
              </div>
              <ul class="m-0 p-0 list-none flex flex-col gap-2.5 text-sm text-white/90 font-serif leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-[#fdbc2d] font-bold">•</span>
                  <span><strong>The Three Turnings of the Dharma Wheel:</strong> Third Turning Tathāgatagarbha sutras as definitive explicit meaning (<em>nītārtha</em>).</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-[#fdbc2d] font-bold">•</span>
                  <span><strong>Primordial Luminous Wisdom:</strong> Ultimate reality (<em>ye shes</em>) replete with inseparable, unconditioned enlightened qualities.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-[#fdbc2d] font-bold">•</span>
                  <span><strong>Union of Sutra and Tantra:</strong> Philosophical matrix actualized through the Kālacakra Six-fold Vajrayoga (<em>Sbyor drug</em>).</span>
                </li>
              </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 pt-1 sm:pt-2">
              <a
                href="#doctrine-content"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#fdbc2d] hover:bg-[#fed36c] text-[#1c1210] font-bold text-xs sm:text-sm uppercase tracking-wider transition-all shadow-md hover:shadow-[0_0_20px_rgba(253,188,45,0.4)] hover:-translate-y-1 active:scale-[0.97]"
              >
                <span>Explore Shentong Matrix</span>
                <span>↓</span>
              </a>
              
              <a
                href="/introduction"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-[#fdbc2d] border border-white/25 hover:border-[#fdbc2d]/60 font-semibold text-xs sm:text-sm uppercase tracking-wider transition-all backdrop-blur-md active:scale-[0.97]"
              >
                <span>Beginner’s Guide</span>
                <span>→</span>
              </a>
            </div>

          </div>

          <!-- Right Column: Vivid, Radiant Artwork Showcase in Sangha Maroon Frame -->
          <div class="lg:col-span-6 flex flex-col items-center">
            
            <div class="relative w-full max-w-lg lg:max-w-none group/thangka">
              
              <!-- Buddhist Monastic Maroon & Gold Filigree Frame -->
              <div class="relative rounded-2xl sm:rounded-3xl p-2.5 sm:p-3.5 bg-gradient-to-b from-[#7b171a] via-[#5c1012] to-[#450b0c] border border-[#fdbc2d]/40 shadow-2xl backdrop-blur-md">
                
                <div class="relative aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-[#3b0809] shadow-inner">
                  <Image
                    src={protectorThangka}
                    alt="19th-Century Thangka of Mahakala Raudrantaka (Killer of Rudra / Gonpo Trakshe) in Jonang Dzamthang Style"
                    width={800}
                    height={1200}
                    class="w-full h-full object-cover object-center transition-transform duration-1000 ease-out group-hover/thangka:scale-105"
                    loading="eager"
                    fetchpriority="high"
                  />

                  <!-- Elegant subtle bottom caption scrim -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent pointer-events-none"></div>

                  <div class="absolute bottom-4 left-4 right-4 text-white space-y-1">
                    <span class="text-caption uppercase tracking-wider text-[#e5b869] font-mono font-bold block">
                      Jonang Dzamthang Style Thangka · མགོན་པོ་དྲག་ཤེད།
                    </span>
                    <span class="text-xs text-[#d8cebe] leading-snug block">
                      Mahākāla Raudrāntaka (Killer of Rudra) · 19th Century Mineral Pigment · Garuda Virtual Museum
                    </span>
                  </div>

                  <!-- Zoom Trigger Badge -->
                  <a
                    href="https://www.himalayanart.org/items/81449/images/primary#-634,-1687,1867,-436"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute top-3 right-3 bg-black/80 backdrop-blur-md rounded-full px-3 py-1.5 text-xs font-mono text-[#e5b869] border border-[#e5b869]/50 opacity-90 sm:opacity-0 sm:group-hover/thangka:opacity-100 transition-all flex items-center gap-1.5 shadow-lg hover:scale-105"
                    aria-label="Zoom into high-resolution painting on Himalayan Art Resources"
                  >
                    <span>Zoom Protector Artwork</span>
                    <span>⚲</span>
                  </a>
                </div>

              </div>

              <!-- Caption Metadata Footer -->
              <div class="flex items-center justify-between text-caption text-[#aa9b8a] pt-3 px-2">
                <span>Garuda Virtual Museum Collection</span>
                <span class="font-mono text-[#e5b869]">HAR Item 81449</span>
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- Sticky Section Navigation Rail -->
    <StickyPageNav items={doctrineNavItems} ariaLabel="Doctrine Navigation & Reading Index" />

    <!-- II. Doctrinal Content Container with Full-Width Documentary -->
    <div id="doctrine-content">
      <JonangDoctrineContent />
    </div>
  </main>
</BaseLayout>
