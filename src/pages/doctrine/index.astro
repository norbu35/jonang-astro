---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import JonangDoctrineContent from "../../components/pages/JonangDoctrineContent.astro";
import StickyPageNav from "../../components/ui/StickyPageNav.astro";
import GlossaryTerm from "../../components/ui/GlossaryTerm.astro";
import { STATIC_PAGE_PATHS } from "../../data/staticPages";

import protectorThangka from "../../assets/images/raudrantaka-dzamthang-thangka.webp";

const doctrineNavItems = [
  { id: "shentong-view", label: "01 · Shentong View", short: "01 · Shentong" },
  { id: "three-turnings", label: "02 · Three Turnings", short: "02 · Turnings" },
  { id: "dolpopa-documentary", label: "03 · Dolpopa Film", short: "03 · Film" },
  { id: "comparative-matrix", label: "04 · Rangtong & Shentong", short: "04 · Matrix" },
  { id: "lineage-masters", label: "05 · Lineage Masters", short: "05 · Masters" },
  { id: "dialectics-integration", label: "06 · Sutra & Tantra", short: "06 · Integration" },
  { id: "shentong-bibliography", label: "07 · Bibliography", short: "07 · Library" },
];
---

<BaseLayout
  title="The Jonang Doctrine & Shentong View | Jonang Monastery"
  description="Comprehensive study of Jonang Shentong Madhyamaka philosophy: the definitive Third Turning, Tathāgatagarbha Buddha-nature, and Dölpopa Sherab Gyaltsen's Mountain Doctrine."
  breadcrumbs={[{ name: "The Jonang Doctrine", path: STATIC_PAGE_PATHS.doctrine }]}
>
  <main id="main-content" class="flex-1">
    <!-- I. Museum-Grade Art-Directed Sanctuary Hero (Tibetan Monastic Crimson & Gold) -->
    <section
      class="relative w-full overflow-hidden bg-gradient-to-b from-maroon-light via-maroon to-maroon-dark text-white border-b border-accent/50 pt-[calc(var(--header-h)+2rem)] sm:pt-[calc(var(--header-h)+2.5rem)] lg:pt-[calc(var(--header-h)+3.5rem)] pb-12 sm:pb-16"
    >
      <!-- Subtle ambient sangha crimson & warm gold temple glow -->
      <div
        class="pointer-events-none absolute -top-40 right-1/4 w-[600px] h-[600px] bg-gold/20 blur-[150px] mix-blend-screen rounded-full"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-40 left-1/4 w-[600px] h-[600px] bg-maroon-dark/60 blur-[130px] rounded-full"
        aria-hidden="true"
      >
      </div>

      <!-- Hero Container -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <!-- Left Column: Editorial Lineage Presentation & Narrative -->
          <div class="lg:col-span-6 flex flex-col gap-6 sm:gap-7">
            <!-- Consecrated Tibetan Title -->
            <div
              lang="bo"
              class="font-tibetan text-2xl sm:text-3xl lg:text-4xl text-gold font-bold pt-1 leading-[1.6] drop-shadow-md"
            >
              ཇོ་ནང་གཞན་སྟོང་དབུ་མ་ཆེན་པོའི་ལྟ་གྲུབ།
            </div>

            <!-- Monumental Heading & Prose Group with Generous Spacing -->
            <div class="flex flex-col gap-3.5 sm:gap-4.5">
              <h1
                class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium text-white tracking-tight leading-[1.15] m-0 drop-shadow-md"
              >
                The Jonang Doctrine & Shentong View
              </h1>

              <p class="font-serif text-base sm:text-lg text-white/90 leading-relaxed m-0">
                The philosophical system of the Jonang tradition articulates the <strong
                  ><GlossaryTerm id="shentong" class="text-white hover:text-gold border-gold/60">Shentong</GlossaryTerm> Great <GlossaryTerm id="madhyamaka" class="text-white hover:text-gold border-gold/60">Madhyamaka</GlossaryTerm></strong
                >: conventional phenomena are empty of self-nature (<GlossaryTerm id="rangtong" class="text-white hover:text-gold border-gold/60">rangtong</GlossaryTerm>), while
                ultimate reality—unconditioned primordial wisdom and Buddha-nature (<GlossaryTerm id="tathagatagarbha" class="text-white hover:text-gold border-gold/60">Tathāgatagarbha</GlossaryTerm>)—is empty only of adventitious obscurations (<GlossaryTerm id="agantukamala" class="text-white hover:text-gold border-gold/60">āgantukamala</GlossaryTerm>).
              </p>
            </div>

            <!-- Canonical Pillars Stream Card (Monastic Sangha Maroon Style) -->
            <div
              class="p-5 sm:p-6 rounded-2xl bg-maroon/90 border border-maroon-border backdrop-blur-md shadow-inner flex flex-col gap-3"
            >
              <div class="border-b border-maroon-border/60 pb-2.5">
                <span
                  class="text-caption uppercase tracking-wider text-gold font-mono font-bold block"
                >
                  Core Doctrinal Pillars
                </span>
              </div>
              <ul
                class="m-0 p-0 list-none flex flex-col gap-2.5 text-sm text-white/90 font-serif leading-relaxed"
              >
                <li class="flex items-start gap-2">
                  <span class="text-gold font-bold">•</span>
                  <span
                    ><strong><GlossaryTerm id="three-turnings" class="text-white hover:text-gold border-gold/60">The Three Turnings of the Dharma Wheel</GlossaryTerm>:</strong> Third Turning Tathāgatagarbha
                    sutras as definitive explicit meaning (<GlossaryTerm id="nitartha" class="text-white hover:text-gold border-gold/60">nītārtha</GlossaryTerm>).</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold font-bold">•</span>
                  <span
                    ><strong>Primordial Luminous Wisdom:</strong> Ultimate reality (<GlossaryTerm id="jnana" class="text-white hover:text-gold border-gold/60">ye shes</GlossaryTerm>) replete with inseparable, unconditioned enlightened qualities.</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold font-bold">•</span>
                  <span
                    ><strong>Union of Sutra and Tantra:</strong> Philosophical matrix actualized through
                    the <GlossaryTerm id="kalachakra" class="text-white hover:text-gold border-gold/60">Kālacakra</GlossaryTerm> <GlossaryTerm id="six-branch-yoga" class="text-white hover:text-gold border-gold/60">Six-fold Vajrayoga</GlossaryTerm> (<em>Sbyor drug</em>).</span
                  >
                </li>
              </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 pt-1 sm:pt-2">
              <a
                href="#doctrine-content"
                class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] rounded-full bg-gold hover:bg-accent-secondary-hover text-ink font-bold text-xs sm:text-sm uppercase tracking-wider transition-all shadow-md hover:shadow-gold/40 hover:-translate-y-1 active:scale-[0.97]"
              >
                <span>Explore Shentong Matrix</span>
                <span>↓</span>
              </a>

              <a
                href={STATIC_PAGE_PATHS.introduction}
                class="inline-flex items-center gap-2 px-5 py-3 min-h-[44px] rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-gold border border-white/25 hover:border-gold/60 font-semibold text-xs sm:text-sm uppercase tracking-wider transition-all backdrop-blur-md active:scale-[0.97]"
              >
                <span>Beginner’s Guide</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Vivid, Radiant Artwork Showcase in Sangha Maroon Frame -->
          <div class="lg:col-span-6 flex flex-col items-center">
            <div class="relative w-full max-w-lg lg:max-w-none group/thangka">
              <!-- Buddhist Monastic Maroon & Gold Filigree Frame -->
              <div
                class="relative rounded-2xl sm:rounded-3xl p-2.5 sm:p-3.5 bg-gradient-to-b from-maroon-light via-maroon to-maroon-dark border border-gold/40 shadow-2xl backdrop-blur-md"
              >
                <div
                  class="relative aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-maroon-dark shadow-inner"
                >
                  <Image
                    src={protectorThangka}
                    alt="19th-Century Thangka of Mahakala Raudrantaka (Killer of Rudra / Gonpo Trakshe) in Jonang Dzamthang Style"
                    width={800}
                    height={1200}
                    class="w-full h-full object-cover object-center transition-transform duration-1000 ease-out group-hover/thangka:scale-105"
                    loading="eager"
                    fetchpriority="high"
                  />

                  <!-- Elegant subtle bottom caption scrim -->
                  <div
                    class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent pointer-events-none"
                  >
                  </div>

                  <div class="absolute bottom-4 left-4 right-4 text-white space-y-1">
                    <span
                      class="text-caption uppercase tracking-wider text-gold font-mono font-bold block"
                    >
                      Jonang Dzamthang Style Thangka
                    </span>
                    <span class="text-xs text-white/80 leading-snug block">
                      Mahākāla Raudrāntaka (Killer of Rudra) · 19th Century Mineral Pigment · Garuda
                      Virtual Museum
                    </span>
                  </div>

                  <!-- Zoom Trigger Badge -->
                  <a
                    href="https://www.himalayanart.org/items/81449/images/primary#-634,-1687,1867,-436"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute top-3 right-3 bg-black/80 backdrop-blur-md rounded-full px-3 py-1.5 text-xs font-mono text-gold border border-gold/50 opacity-90 sm:opacity-0 sm:group-hover/thangka:opacity-100 transition-all flex items-center gap-1.5 shadow-lg hover:scale-105 min-h-[36px]"
                    aria-label="Zoom into high-resolution painting on Himalayan Art Resources"
                  >
                    <span>Zoom Protector Artwork</span>
                    <span>⚲</span>
                  </a>
                </div>
              </div>

              <!-- Caption Metadata Footer -->
              <div class="flex items-center justify-between text-caption text-white/70 pt-3 px-2">
                <span>Garuda Virtual Museum Collection</span>
                <span class="font-mono text-gold">HAR Item 81449</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky Section Navigation Rail -->
    <StickyPageNav items={doctrineNavItems} ariaLabel="Doctrine Navigation & Reading Index" />

    <!-- II. Doctrinal Content Container with Full-Width Documentary -->
    <div id="doctrine-content">
      <JonangDoctrineContent />
    </div>
  </main>
</BaseLayout>
