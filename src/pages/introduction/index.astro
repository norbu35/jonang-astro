                <th class="p-3.5 font-display font-semibold text-ink">Sakya</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-xs">
              {comparativeFiveSchools.map((row) => (
                <tr class="hover:bg-surface-subtle/50 transition-colors">
                  <td class="p-3.5 font-bold text-ink align-top whitespace-nowrap">{row.param}</td>
