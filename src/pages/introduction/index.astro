---
import PageLayout from "../../layouts/PageLayout.astro";
import Dharmachakra from "../../components/icons/Dharmachakra.astro";
import EndlessKnot from "../../components/icons/EndlessKnot.astro";
import LotusFlower from "../../components/icons/LotusFlower.astro";
import ChapterHeader from "../../components/ui/ChapterHeader.astro";
import MasterCard from "../../components/ui/MasterCard.astro";
import PillarCard from "../../components/ui/PillarCard.astro";
import introBannerImg from "../../assets/images/jonang-refuge-tree.webp";
import kalachakraEmblem from "../../assets/images/kalachakra-emblem.webp";
import taranathaThangka from "../../assets/images/taranatha-dzamthang-thangka.webp";
import khalkhaPortrait from "../../assets/portraits/khalkha_jetsun_dampa.webp";
import { Image } from "astro:assets";

const threeVehicles = [
  {
    vehicle: "Theravāda",
    tibetan: "གནས་བརྟན་སྡེ་པ།",
    subtitle: "Way of the Elders",
    ideal: "Arhat (Individual Liberation)",
    method: "Monastic discipline (Vinaya), analytical mindfulness (Vipassanā)",
    emphasis: "Analysis of the five aggregates (skandhas), overcoming attachment, and extinguishing mental defilements (kleśas).",
  },
  {
    vehicle: "Mahāyāna",
    tibetan: "ཐེག་པ་ཆེན་པོ།",
    subtitle: "The Great Vehicle",
    ideal: "Bodhisattva (Universal Liberation)",
    method: "Cultivation of altruistic awakening mind (Bodhicitta), Six Perfections (Pāramitās)",
    emphasis: "Emptiness (Śūnyatā) of all phenomena and the indwelling essence of Buddhahood (Tathāgatagarbha) present in all beings.",
  },
  {
    vehicle: "Vajrayāna",
    tibetan: "གསང་སྔགས་རྡོ་རྗེ་ཐེག་པ།",
    subtitle: "The Diamond Vehicle",
    ideal: "Siddha / Fully Awakened Buddha",
    method: "Esoteric empowerments, deity visualization, subtle body yogas (channels, winds, essences)",
    emphasis: "Direct, swift transmutation of mundane delusion into primordial luminous wisdom (Jñāna) within a single lifetime.",
  },
];

const fiveTraditions = [
  {
    name: "Nyingma",
    tibetan: "རྙིང་མ།",
    meaning: "The Ancient School",
    history: "Formed during the Early Propagation (8th century) under King Trisong Detsen, Guru Padmasambhava, and Śāntarakṣita.",
    specialty: "Revealed treasure texts (Terma) and the non-dual direct realization of Dzogchen (Great Perfection).",
  },
  {
    name: "Kagyu",
    tibetan: "བཀའ་བརྒྱུད།",
    meaning: "The Oral Lineage",
    history: "Transmitted from Indian Mahāsiddhas Tilopa and Nāropa to Marpa, Milarepa, and Gampopa in the 11th century.",
    specialty: "Mahāmudrā (The Great Seal) and the Six Yogas of Nāropa subtle body energy practices.",
  },
  {
    name: "Sakya",
    tibetan: "ས་སྐྱ།",
    meaning: "The Grey Earth School",
    history: "Founded in 1073 by the Khön family, renowned for scholastic systematization and extensive tantric commentaries.",
    specialty: "The Lamdré (Path and Result) system and mastery of the Hevajra Tantra.",
  },
  {
    name: "Gelug",
    tibetan: "དགེ་ལུགས།",
    meaning: "The Virtuous School",
    history: "Established in the early 15th century by Je Tsongkhapa, establishing major monastic universities across Tibet.",
    specialty: "Rigorous dialectical debate, strict Vinaya monasticism, and Prāsaṅgika Mādhyamika philosophy.",
  },
  {
    name: "Jonang",
    tibetan: "ཇོ་ནང་།",
    meaning: "The Lineage of Jomonang",
    history: "Consolidated by Kunpang Thukje Tsöndrü and Dölpopa Sherab Gyaltsen in the 13th–14th centuries.",
    specialty: "The definitive Shentong (Other-Emptiness) Great Middle Way and the complete Six-fold Vajrayoga of the Kālacakra Tantra.",
  },
];

const tenDefinitiveSutras = [
  { name: "Tathāgatagarbha Sūtra", desc: "Reveals the radiant Buddha-nature hidden within all transient defilements like a jewel in rags." },
  { name: "Mahāyāna Mahāparinirvāṇa Sūtra", desc: "Declares ultimate reality to be eternal (nitya), blissful (sukha), true self (ātman), and pure (śubha)." },
  { name: "Śrīmālādevī Siṃhanāda Sūtra", desc: "The Lion’s Roar of Queen Śrīmālā on the ultimate Tathāgatagarbha and the single vehicle (Ekayāna)." },
  { name: "Aṅgulimālīya Sūtra", desc: "Elucidates that enlightenment is not created anew, but uncovered as the primordial nature of reality." },
  { name: "Mahābherīharaka Sūtra", desc: "The Great Drum Sutra proclaiming the permanent essence of Buddhahood across all sentient realms." },
  { name: "Avikalpapraveśa Dhāraṇī", desc: "Expounds direct entry into non-conceptual awareness beyond mental fabrications." },
  { name: "Śūnyatānāma Mahāsūtra", desc: "Distinguishes between relative emptiness of self-nature and the ultimate reality endowed with qualities." },
  { name: "Tathāgatamahākaruṇānirdeśa Sūtra", desc: "The great exposition of the Buddha’s unconditioned primordial compassion." },
  { name: "Tathāgataguṇajñānācintyaviṣayāvatāranirdeśa Sūtra", desc: "Details the inconceivable wisdom and spontaneous qualities of the enlightened state." },
  { name: "Mahāmegha Sūtra", desc: "The Great Cloud Sutra proclaiming the perpetual lifespan and indestructible nature of the Tathāgata." },
];

const sixVajraYogas = [
  {
    step: "01",
    name: "Pratyāhāra (Withdrawal)",
    tibetan: "སོ་སོར་སྡུད་པ།",
    desc: "Retracting sensory awareness from external stimuli and directing attention into the central channel (avadhūti). In solitary dark retreat, the practitioner directly witnesses the ten visionary signs of empty form (śūnyatā-bimba)—such as smoke, mirages, fireflies, lamp flames, and blazing suns.",
  },
  {
    step: "02",
    name: "Dhyāna (Meditative Concentration)",
    tibetan: "བསམ་གཏན།",
    desc: "Stabilizing and integrating the visionary empty forms with non-conceptual insight (prajñā), uniting perceptual clarity with unwavering single-pointed meditative absorption.",
  },
  {
    step: "03",
    name: "Prāṇāyāma (Harnessing Life-Force)",
    tibetan: "སྲོག་རྩོལ།",
    desc: "Mastery over subtle energy-winds (prāṇa) via vase-breathing containment (kumbhaka), drawing coarse upper and lower breath winds into the central channel at the navel cakra.",
  },
  {
    step: "04",
    name: "Dhāraṇā (Retention)",
    tibetan: "འཛིན་པ།",
    desc: "Holding the subtle winds and regenerative drops (bindu) bound securely within the central channel, pacifying dualistic thought and generating immutable bliss (akṣarasukha).",
  },
  {
    step: "05",
    name: "Anusmṛti (Recollection)",
    tibetan: "རྗེས་དྲན།",
    desc: "Igniting the inner heat fire (caṇḍālī / tummo) through the central channel to melt the white bodhicitta drop at the crown cakra. The practitioner directly beholds the luminous, rainbow-like mandala matrix of Kālacakra.",
  },
  {
    step: "06",
    name: "Samādhi (Meditative Stabilization)",
    tibetan: "ཏིང་ངེ་འཛིན།",
    desc: "The consummate union of unchanging supreme bliss (paramākṣarasukha) and the ultimate devoid-form body (stong-gzugs). Coarse physical aggregates dissolve, actualizing the Primordial Buddha (Adibuddha) state.",
  },
];

const comparativeFiveSchools = [
  {
    param: "Philosophical View of Reality",
    jonang: "Shentong (Great Madhyamaka): Ultimate reality is empty of adventitious flaws, but replete with eternal Buddha-qualities.",
    gelug: "Rangtong (Prāsaṅgika Madhyamaka): Absolute negation of inherent existence across all conventional and ultimate truths.",
    kagyu: "Dual approach: Shentong applied in contemplative meditation (Karma Kagyu); Rangtong used in scholastic study.",
    nyingma: "Dzogchen Primordial Purity (Ka dag) and Spontaneous Presence (Lhun grub), synthesizing clarity and emptiness.",
    sakya: "Inseparability of Clarity and Emptiness (Gsal stong dbyer med); primarily Rangtong dialectics.",
  },
  {
    param: "Primary Tantric Specialization",
    jonang: "Kālacakra Tantra (Drō Lineage) & the Six-fold Vajrayoga of the completion stage.",
    gelug: "Guhyasamāja, Yamāntaka, Cakrasaṃvara, and Kālacakra (Rwa Lineage).",
    kagyu: "Cakrasaṃvara, Hevajra, Six Yogas of Nāropa, and Mahāmudrā.",
    nyingma: "Guhyagarbha Tantra, Eight Herukas (Kāgyé), and Dzogchen Atiyoga.",
    sakya: "Hevajra Tantra and the Lamdré (Path and Result) esoteric cycle.",
  },
  {
    param: "Hermeneutical Stance on the 3 Turnings",
    jonang: "Third Turning (Tathāgatagarbha) is definitive (nītārtha); Second Turning is provisional (neyārtha).",
    gelug: "Second Turning (Prajñāpāramitā) is definitive (nītārtha); Third Turning requires interpretation.",
    kagyu: "Third Turning prioritized for Buddha-nature experience; Second Turning for conceptual deconstruction.",
    nyingma: "Third Turning prioritized for luminous nature; Second Turning for freedom from conceptual extremes.",
    sakya: "Second Turning prioritized scholastically; non-dual synthesis in meditation.",
  },
  {
    param: "Understanding of Buddha-Nature",
    jonang: "An unconditioned, eternal, non-dual reality inherently present within all sentient beings.",
    gelug: "A potential or capacity for awakening; a metaphor for the empty, clear-light nature of mind.",
    kagyu: "The indwelling luminous awareness (rigpa) free from mental fabrications.",
    nyingma: "The spontaneous presence (lhun grub) of primordial enlightened wisdom.",
    sakya: "The natural clarity of mind inseparable from its empty nature.",
  },
  {
    param: "Key Historical Masters",
    jonang: "Yumo Mikyö Dorjé, Kunpang-pa, Dölpopa Sherab Gyaltsen, Jetsun Tāranātha.",
    gelug: "Je Tsongkhapa, Gyaltsab Je, Khedrup Je, Dalai Lama lineage.",
    kagyu: "Marpa the Translator, Milarepa, Gampopa, Karmapa lineage.",
    nyingma: "Guru Padmasambhava, Vimalamitra, Longchenpa, Ju Mipham Rinpoche.",
    sakya: "Khön Könchok Gyalpo, Sakya Paṇḍita, Drogön Chögyal Phagpa.",
  },
];
---

<PageLayout
  title="Introduction to the Jonang Tradition"
  tibetanTitle="ཇོ་ནང་ཆོས་བརྒྱུད་ངོ་སྤྲོད་མདོར་བསྡུས།"
  image={introBannerImg}
  imageAlt="The Jonang Lineage Refuge Tree depicting masters, yidams, and Buddha-nature teachers"
>
  <div class="space-y-16 sm:space-y-20">

    <!-- I. Editorial Master Header -->
    <div class="surface-card p-6 sm:p-8 md:p-10 flex flex-col gap-6 sm:gap-8">
      <div class="flex flex-col gap-3 sm:gap-4">
        <span class="text-xs font-mono font-bold text-accent uppercase tracking-widest block">
          Foundational Guide · ཇོ་ནང་ལྟ་གྲུབ་ངོ་སྤྲོད།
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display text-ink font-normal leading-tight m-0">
          The Luminous Path of Other-Emptiness
        </h1>
        <p class="text-base sm:text-lg text-muted font-serif leading-[1.85] sm:leading-[1.9] max-w-4xl m-0 pt-1">
          Welcome to the beginner’s gateway for the Jonang tradition of Tibetan Buddhism. If you are new to Buddhist philosophy or seeking to understand what distinguishes the Jonang lineage from other traditions, this comprehensive guide offers an accessible on-ramp—spanning fundamental Buddhist tenets, the emergence of Tibetan schools, the definitive Shentong view of Buddha-nature, and the contemplative Six Yogas of Kālacakra.
        </p>
      </div>

      <!-- Quick Chapter Jump Bar with generous breathing room -->
      <div class="pt-6 border-t border-border/80 flex flex-col gap-3">
        <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider block">
          Table of Contents · དཀར་ཆག
        </span>
        <div class="flex flex-wrap gap-2 text-xs">
          <a href="#fundamentals" class="px-3.5 py-2 rounded-lg bg-surface-subtle border border-border hover:border-accent hover:text-accent font-medium transition-all">
            1. Buddhist Fundamentals
          </a>
          <a href="#tibetan-landscape" class="px-3.5 py-2 rounded-lg bg-surface-subtle border border-border hover:border-accent hover:text-accent font-medium transition-all">
            2. The Five Traditions
          </a>
          <a href="#jonang-history" class="px-3.5 py-2 rounded-lg bg-surface-subtle border border-border hover:border-accent hover:text-accent font-medium transition-all">
            3. Genesis of Jonang
          </a>
          <a href="#shentong-core" class="px-3.5 py-2 rounded-lg bg-surface-subtle border border-border hover:border-accent hover:text-accent font-medium transition-all">
            4. Shentong vs. Rangtong
          </a>
          <a href="#kalachakra-engine" class="px-3.5 py-2 rounded-lg bg-surface-subtle border border-border hover:border-accent hover:text-accent font-medium transition-all">
            5. Kālacakra & Six Yogas
          </a>
          <a href="#suppression-resurgence" class="px-3.5 py-2 rounded-lg bg-surface-subtle border border-border hover:border-accent hover:text-accent font-medium transition-all">
            6. History & Resurgence
          </a>
          <a href="#comparative-matrix" class="px-3.5 py-2 rounded-lg bg-surface-subtle border border-border hover:border-accent hover:text-accent font-medium transition-all">
            7. 5-School Comparison
          </a>
          <a href="#further-study" class="px-3.5 py-2 rounded-lg bg-surface-subtle border border-border hover:border-accent hover:text-accent font-medium transition-all">
            8. Explore Next
          </a>
        </div>
      </div>
    </div>

    <!-- II. Chapter 1: Introduction to Buddhist Fundamentals -->
    <section id="fundamentals" class="space-y-8 scroll-mt-24">
      <ChapterHeader
        chapter="Chapter 01"
        title="Introduction to Buddhist Fundamentals"
        lede="To understand the specialized lineage of Jonang, one must first locate it within the universal framework of Buddhist thought originating in the 6th to 5th centuries BCE with Siddhārtha Gautama, the historical Buddha Shakyamuni."
      />

      <!-- Core Universal Pillars Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <PillarCard
          title="The Four Noble Truths"
          tibetanTitle="བདེན་པ་བཞི།"
          accent="accent"
        >
          <ul class="text-xs text-muted space-y-2 pt-3 list-none p-0 m-0 leading-relaxed">
            <li><strong>1. Duḥkha:</strong> The truth of suffering and conditioned unsatisfactoriness.</li>
            <li><strong>2. Samudaya:</strong> The origin of suffering rooted in ignorance and craving.</li>
            <li><strong>3. Nirodha:</strong> The cessation of suffering known as Nirvāṇa.</li>
            <li><strong>4. Mārga:</strong> The path leading to cessation (The Noble Eightfold Path).</li>
          </ul>
        </PillarCard>

        <PillarCard
          title="Three Marks of Existence"
          tibetanTitle="ཕྱག་རྒྱ་བཞི།"
          accent="gold"
        >
          <ul class="text-xs text-muted space-y-2 pt-3 list-none p-0 m-0 leading-relaxed">
            <li><strong>Impermanence (Anicca):</strong> All compounded phenomena are in constant flux.</li>
            <li><strong>Suffering (Duḥkha):</strong> Clinging to transient objects produces dissatisfaction.</li>
            <li><strong>Non-Self (Anātman):</strong> Living beings possess no permanent, independent soul. Individual life is an interplay of five transient aggregates (<em>skandhas</em>).</li>
          </ul>
        </PillarCard>

        <PillarCard
          title="Dependent Origination"
          tibetanTitle="རྟེན་ཅིང་འབྲེལ་བར་འབྱུང་བ།"
          accent="secondary"
          description="Pratītyasamutpāda is the universal law that all physical and mental phenomena arise only in dependence upon causes and conditions. Nothing exists in isolation; all things are empty of independent self-existence."
        />
      </div>

      <!-- The Three Yānas Comparison Table -->
      <div class="surface-card p-6 sm:p-8 space-y-6">
        <h3 class="text-xl sm:text-2xl font-display text-ink font-normal m-0">
          The Three Vehicles of Buddhism (Yānas)
        </h3>
        <p class="text-xs sm:text-sm text-muted leading-relaxed m-0">
          As Buddhism flourished across Asia, it adapted into three primary vehicles suited to varied spiritual temperaments:
        </p>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-border bg-surface-subtle">
                <th class="p-3.5 font-display font-semibold text-ink">Vehicle</th>
                <th class="p-3.5 font-display font-semibold text-accent">Spiritual Ideal</th>
                <th class="p-3.5 font-display font-semibold text-accent-secondary">Core Method</th>
                <th class="p-3.5 font-display font-semibold text-ink">Philosophical Focus</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {threeVehicles.map((v) => (
                <tr class="hover:bg-surface-subtle/50 transition-colors">
                  <td class="p-3.5 font-semibold text-ink align-top">
                    <div>{v.vehicle}</div>
                    <span class="text-xs text-muted block">{v.subtitle}</span>
                    <span class="text-xs font-tibetan text-accent font-bold block mt-0.5">{v.tibetan}</span>
                  </td>
                  <td class="p-3.5 text-accent font-medium align-top leading-relaxed">{v.ideal}</td>
                  <td class="p-3.5 text-muted align-top leading-relaxed">{v.method}</td>
                  <td class="p-3.5 text-ink align-top leading-relaxed">{v.emphasis}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- The Three Turnings of the Wheel of Dharma -->
      <div class="surface-card p-6 sm:p-8 space-y-6">
        <h3 class="text-xl sm:text-2xl font-display text-ink font-normal m-0">
          The Three Turnings of the Wheel of Dharma (Dharmacakrapravartana)
        </h3>
        <p class="text-xs sm:text-sm text-muted leading-relaxed m-0">
          Mahāyāna hermeneutics structures the Buddha’s forty-five-year teaching career into three successive turnings. This three-stage progression serves as the foundational matrix for all Tibetan doctrinal discourse:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-2">
          
          <div class="p-5 rounded-xl bg-surface-subtle border border-border space-y-2">
            <div class="flex justify-between items-center text-xs font-mono text-accent">
              <span class="font-bold uppercase">First Turning</span>
              <span>Sārnāth</span>
            </div>
            <h4 class="font-display text-base font-bold text-ink m-0">The Four Noble Truths</h4>
            <p class="text-xs text-muted leading-relaxed m-0">
              Established personal selflessness (<em>pudgala-nairātmya</em>), the reality of suffering, and ethical monastic discipline.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-surface-subtle border border-border space-y-2">
            <div class="flex justify-between items-center text-xs font-mono text-accent">
              <span class="font-bold uppercase">Second Turning</span>
              <span>Vulture Peak</span>
            </div>
            <h4 class="font-display text-base font-bold text-ink m-0">The Perfection of Wisdom</h4>
            <p class="text-xs text-muted leading-relaxed m-0">
              Established the universal emptiness (<em>Śūnyatā</em>) of all phenomena (<em>dharma-nairātmya</em>) through the Prajñāpāramitā sūtras.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-surface-subtle border border-accent/40 space-y-2 bg-gradient-to-br from-surface-subtle to-gold/5">
            <div class="flex justify-between items-center text-xs font-mono text-accent">
              <span class="font-bold uppercase">Third Turning</span>
              <span>Vaiśālī & Elsewhere</span>
            </div>
            <h4 class="font-display text-base font-bold text-ink m-0">Buddha-Nature (Tathāgatagarbha)</h4>
            <p class="text-xs text-muted leading-relaxed m-0">
              Revealed that ultimate reality is non-dual primordial luminous wisdom (<em>jñāna</em>), an eternal Buddha-nature present in all sentient beings. <strong>This turning forms the doctrinal bedrock of the Jonang tradition.</strong>
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- III. Chapter 2: The Landscape of Tibetan Buddhism -->
    <section id="tibetan-landscape" class="space-y-8 scroll-mt-24">
      <ChapterHeader
        chapter="Chapter 02"
        title="The Landscape of Tibetan Buddhism"
        lede="Buddhism entered the Tibetan plateau across two historic epochs: the Early Propagation (Nyingma) in the 8th century, and the Later Propagation (Sarma) from the late 10th century onward, drawing direct Sanskrit translations from Indian monastic universities such as Nālandā and Vikramaśīla."
      />

      <!-- Five Living Lineages Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5 items-stretch">
        {fiveTraditions.map((t, idx) => (
          <div class:list={[
            "surface-card p-5 flex flex-col justify-between hover-lift border-t-4 h-full",
            idx === 4 ? "border-t-gold ring-1 ring-gold/40" : "border-t-accent",
          ]}>
            <div class="space-y-2 pb-3 min-h-[10.5rem] sm:min-h-[11rem] lg:min-h-[11.5rem] flex flex-col justify-start">
              <div class="flex justify-between items-baseline mb-0.5">
                <h3 class="text-lg font-display font-bold text-ink leading-snug m-0">{t.name}</h3>
                <span class="text-xs font-tibetan text-accent font-bold pl-1">{t.tibetan}</span>
              </div>
              <span class="text-xs font-mono text-muted uppercase tracking-wider block">{t.meaning}</span>
              <p class="text-xs text-muted leading-relaxed m-0 pt-1">{t.history}</p>
            </div>
            <div class="pt-3 border-t border-border text-xs text-ink/90 font-medium min-h-[8.5rem] sm:min-h-[9rem] lg:min-h-[9.5rem] flex flex-col justify-start">
              <span class="text-accent-secondary font-bold block text-caption-xs uppercase mb-1">Specialty:</span>
              <span class="leading-relaxed">{t.specialty}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="surface-card p-6 border-l-4 border-l-border space-y-2">
        <h4 class="text-base font-display font-bold text-ink m-0">Note on Bön:</h4>
        <p class="text-xs sm:text-sm text-muted leading-relaxed m-0 font-serif">
          Alongside these five Buddhist traditions stands <strong>Bön</strong>, Tibet's indigenous spiritual tradition, which evolved alongside Tibetan Buddhism while sharing similar monastic, iconographic, and philosophical frameworks.
        </p>
      </div>
    </section>

    <!-- IV. Chapter 3: Genesis & Historical Evolution of Jonang -->
    <section id="jonang-history" class="space-y-8 scroll-mt-24">
      <ChapterHeader
        chapter="Chapter 03"
        title="Genesis and Historical Evolution of the Jonang Tradition"
        lede="The Jonang lineage represents an unbroken stream of scholarship and contemplative realization descending from 11th-century Indian masters to the present day:"
      />

      <!-- Historical Masters Stepper Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <MasterCard
          dates="11th Century Origins"
          nameEn="Yumo Mikyö Dorjé"
