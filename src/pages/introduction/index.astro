    <div class="pointer-events-none absolute bottom-1/3 right-0 w-[500px] h-[500px] bg-accent-tertiary/6 blur-3xl rounded-full" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-10">
      <ChapterHeader
        chapter="Chapter 07"
        title="Comparative Analysis: Jonang & The Tibetan Traditions"
        lede="A side-by-side comparative summary outlining how Jonang relates to the other four major Tibetan Buddhist traditions across philosophy, view, tantra, and practice lineages:"
      />

      <div class="surface-card p-4 sm:p-6 md:p-8 space-y-6 bg-surface/95 backdrop-blur-md border border-border/80 shadow-md overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm sm:text-base border-collapse min-w-[760px]">
            <thead>
              <tr class="border-b border-border bg-surface-subtle/90">
                <th class="p-4 font-display font-bold text-ink text-sm sm:text-base">Parameter</th>
                <th class="p-4 font-display font-bold text-accent border-l border-r border-gold/30 bg-gold/12 text-sm sm:text-base">Jonang (ཇོ་ནང་།)</th>
                <th class="p-4 font-display font-bold text-ink text-sm sm:text-base">Gelug (དགེ་ལུགས།)</th>
                <th class="p-4 font-display font-bold text-ink text-sm sm:text-base">Kagyu (བཀའ་བརྒྱུད།)</th>
                <th class="p-4 font-display font-bold text-ink text-sm sm:text-base">Nyingma (རྙིང་མ།)</th>
                <th class="p-4 font-display font-bold text-ink text-sm sm:text-base">Sakya (ས་སྐྱ།)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-sm sm:text-[0.95rem]">
              {comparativeFiveSchools.map((row) => (
                <tr class="hover:bg-surface-subtle/60 transition-colors">
                  <td class="p-4 font-bold text-ink align-top whitespace-nowrap bg-surface-subtle/30">{row.param}</td>
                  <td class="p-4 text-ink font-medium align-top leading-relaxed bg-gold/8 border-l border-r border-gold/25 font-serif">{row.jonang}</td>
                  <td class="p-4 text-muted align-top leading-relaxed font-serif">{row.gelug}</td>
                  <td class="p-4 text-muted align-top leading-relaxed font-serif">{row.kagyu}</td>
                  <td class="p-4 text-muted align-top leading-relaxed font-serif">{row.nyingma}</td>
                  <td class="p-4 text-muted align-top leading-relaxed font-serif">{row.sakya}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Final Container: Chapter 8 Gateways -->
