            {sixVajraYogas.map((y) => (
              <div class="p-6 rounded-2xl bg-surface border border-border space-y-3 hover-lift flex flex-col justify-between h-full border-t-2 border-t-accent hover:border-t-gold transition-all shadow-xs">
